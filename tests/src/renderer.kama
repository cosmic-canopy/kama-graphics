// GFX-1's part 1: a `Renderer` with no window, on a device the program already has (`withDevice`), that clears a render
// target and reads it back (kyoten's rendering.md § Decided, GFX-1's part 1, questions 1 and 4 to 6). Colours are written
// in sRGB and held linear (area 2, item 4). The default target, 8-bit sRGB, holds what the window would show, so a
// target cleared to #336699 reads back 0x33 0x66 0x99. A read is a request the program polls, and hands back an
// @kama/image `Image`.
//
// First, with no GPU, `Color`: every 8-bit sRGB value written and read back unchanged, and the linear values three.js's
// sRGB curve gives. Then, a step a tick on the device the check opened, the renderer's clears and reads, each held to the
// bytes every GPU writes, and on a software GPU the first also to its golden, `tests/goldens/readback/<gpu>.png`. The
// cases never poll the device: a read moves on through its own `poll`, which is what a program sees.

import {
    core::println,
    std::collections::DynamicArray,
    std::math::abs, std::math::pow,
    std::time::Instant, std::time::monotonicNow,
    gpu::Device, gpu::Queue, gpu::GpuError, gpu::DeviceErrors,
    image::Image, image::PixelFormat, image::AlphaMode, image::ColorSpace, image::Primaries, image::Transfer,
    graphics::Color, graphics::Renderer, graphics::RenderTarget, graphics::PixelRead, graphics::PixelStatus,
    gpuResolved, Verdicts, checkGolden,
};
export { colorCases, RendererRun };

comptime int64 SETTLE_MS = 10000;   // the most a read waits, by the clock: natively ticks run back to back

fn uint32 grey(uint32 v) { return (v << 16) | (v << 8) | v; }

fn bool near(float32 a, float64 b) { return abs(x: cast<float64>(a) - b) < 0.000001; }

// The sRGB curve in float64, as three.js's SRGBToLinear writes it.
fn float64 srgbToLinear(float64 c) {
    if (c < 0.04045) { return c * 0.0773993808; }
    return pow(x: c * 0.9478672986 + 0.0521327014, y: 2.4);
}

unsafe fn void colorCases(ref Verdicts found) {
    {
        string bad = "";
        for (uint32 v = 0; v < 256; v = v + 1) {
            uint32 hex = (v << 16) | ((255 - v) << 8) | ((v * 7) & 255);
            uint32 back = Color.fromHex(hex: hex).hex();
            if (back != hex && bad.length() < 200) { bad = bad + " ${hex} came back ${back};"; }
        }
        found.add(name: "Color: every 8-bit sRGB value written as hex reads back unchanged", why: give bad);
    }
    {
        string bad = "";
        for (uint32 v = 0; v < 256; v = v + 1) {
            float32 c = cast<float32>(v) / 255.0;
            uint32 back = Color.make(r: c, g: c, b: c).hex();
            if (back != grey(v: v) && bad.length() < 200) { bad = bad + " ${v}/255 came back ${back};"; }
        }
        found.add(name: "Color: every 8-bit sRGB value written as a number in 0 to 1 reads back unchanged", why: give bad);
    }
    {
        string bad = "";
        for (uint32 v = 0; v < 256; v = v + 1) {
            Color c = Color.fromHex(hex: (v << 16) | (v << 8) | v);
            float64 want = srgbToLinear(c: cast<float64>(v) / 255.0);
            if ((!near(a: c.linearR(), b: want) || !near(a: c.linearG(), b: want) || !near(a: c.linearB(), b: want)) && bad.length() < 200) {
                float32 got = c.linearR();
                bad = bad + " ${v}: ${got}, the curve ${want};";
            }
        }
        Color black = Color.fromHex(hex: 0);
        Color white = Color.fromHex(hex: 0xffffff);
        if (black.linearR() != 0.0 || white.linearG() != 1.0) { bad = bad + " black or white is not exactly 0 or 1;"; }
        found.add(name: "Color: held linear, by three.js's sRGB curve, black 0 and white 1 exactly", why: give bad);
    }
    {
        Color c = Color.fromHex(hex: 0x336699);
        bool channels = near(a: c.linearR(), b: srgbToLinear(c: 0.2)) && near(a: c.linearG(), b: srgbToLinear(c: 0.4))
            && near(a: c.linearB(), b: srgbToLinear(c: 0.6));
        found.add(name: "Color: 0xRRGGBB is red, green and blue, in that order", why: channels ? "" : "0x336699's channels are not 0x33, 0x66 and 0x99");
        uint32 made = Color.make(r: 0.2, g: 0.4, b: 0.6).hex();
        found.add(name: "Color: make(r:, g:, b:) takes red, green and blue in sRGB, as the hex number does",
                  why: made == 0x336699 ? "" : "make(r: 0.2, g: 0.4, b: 0.6) reads back ${made}, not 0x336699 (3368601)");
    }
    {
        Shared<RenderTarget> t = new RenderTarget.make(width: 37, height: 23);
        uint32 w = t.width();
        uint32 h = t.height();
        Shared<RenderTarget> alias = t;
        uint32 aw = alias.width();
        found.add(name: "RenderTarget: made by its size, and shared: another holder names the same target",
                  why: w == 37 && h == 23 && aw == 37 ? "" : "${w}x${h}, the other holder's ${aw} wide");
    }
}

// "" when the image is the target's size, 8-bit RGBA in sRGB with straight alpha, and every texel the four bytes.
fn string uniform(const ref Image img, isize width, isize height, uint8 r, uint8 g, uint8 b, uint8 a) {
    isize w = img.width();
    isize h = img.height();
    if (w != width || h != height) { return "the image is ${w}x${h}, the target ${width}x${height}"; }
    bool rgba8 = match (img.format()) { case Rgba8Unorm: true; case _: false; };
    if (!rgba8) { return "the image is not Rgba8Unorm"; }
    ColorSpace space = img.colorSpace();
    bool srgb = match (space.primaries) { case Bt709: true; case _: false; } && match (space.transfer) { case Srgb: true; case _: false; };
    if (!srgb) { return "the image's colour space is not sRGB"; }
    bool straight = match (img.alpha()) { case Straight: true; case _: false; };
    if (!straight) { return "the image's alpha is not straight"; }
    isize off = 0;
    isize first = -1;
    borrow img.samples8() as px {
        if (px.length() != width * height * 4) { isize n = px.length(); return "the image holds ${n} bytes"; }
        for (isize i = 0; i < px.length(); i = i + 4) {
            if (px[i] != r || px[i + 1] != g || px[i + 2] != b || px[i + 3] != a) {
                if (first < 0) { first = i; }
                off = off + 1;
            }
        }
        if (off == 0) { return ""; }
        uint8 fr = px[first];
        uint8 fg = px[first + 1];
        uint8 fb = px[first + 2];
        uint8 fa = px[first + 3];
        isize texel = first / 4;
        return "${off} texels are not ${r} ${g} ${b} ${a}, the first, texel ${texel}: ${fr} ${fg} ${fb} ${fa}";
    }
}

type resource RendererRun {
    int32 stage = 0;
    Instant began = monotonicNow();
    string gpu;
    bool software;
    int32 declaredCount = 0;
    int32 matchedCount = 0;
    Verdicts found;
    Device device;                            // the test's own handle, for its error channel
    Queue queue;
    Optional<Renderer> renderer = Optional::None;
    Optional<Shared<RenderTarget>> target = Optional::None;
    Optional<PixelRead> reading = Optional::None;
    Optional<Image> image = Optional::None;   // the last read's image
    string failed = "";                       // or why the last read failed

    public ctor make(string gpu, bool software, Device device, Queue queue) {
        this.gpu = give gpu;
        this.software = software;
        this.found = Verdicts.make();
        this.device = give device;
        this.queue = give queue;
    }

    public fn ref Verdicts verdicts() { return this.found; }
    public const fn int32 declared() { return this.declaredCount; }
    public const fn int32 matched() { return this.matchedCount; }

    unsafe fn void next(int32 to) { this.stage = to; this.began = monotonicNow(); }

    // The read under way, polled once: false while it is pending. Once it settles, its image or why not is kept.
    unsafe fn bool settled() {
        PixelStatus s = match (this.reading) {
            case Some(value: r): r.poll();
            case None: PixelStatus::Failed(error: GpuError::Refused(words: "no read was started"));
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (pending && this.began.elapsed().asMillis() < SETTLE_MS) { return false; }
        this.image = Optional::None;
        this.failed = "";
        match (give s) {
            case Ready(image: img): { this.image = Optional::Some(value: give img); }
            case Failed(error: e): { this.failed = "the read failed: " + e.message(); }
            case Pending: { this.failed = "the read was still pending after ${SETTLE_MS} ms"; }
        };
        return true;
    }

    // The last read's image held to `uniform`.
    fn string read(isize width, isize height, uint8 r, uint8 g, uint8 b, uint8 a) {
        if (!this.failed.isEmpty()) { return copy this.failed; }
        return match (this.image) {
            case Some(value: img): uniform(img: img, width: width, height: height, r: r, g: g, b: b, a: a);
            case None: "no image";
        };
    }

    unsafe fn void clearAndRead(ref Renderer renderer, Shared<RenderTarget> target) {
        renderer.clear(target: target);
        this.reading = Optional::Some(value: renderer.readRenderTargetPixels(target: target));
    }

    // One tick's step: true once every case has run.
    public unsafe fn bool step() {
        if (this.stage == 0) {
            // a target cleared to #336699 reads back as written
            Renderer r = gpuResolved(device: copy this.device, queue: copy this.queue);
            Shared<RenderTarget> t = new RenderTarget.make(width: 37, height: 23);
            r.clearColorMut() = Color.fromHex(hex: 0x336699);
            this.clearAndRead(renderer: r, target: t);
            this.renderer = Optional::Some(value: give r);
            this.target = Optional::Some(value: give t);
            this.next(to: 1);
        } else if (this.stage == 1) {
            if (!this.settled()) { return false; }
            string why = this.read(width: 37, height: 23, r: 0x33, g: 0x66, b: 0x99, a: 0xff);
            this.found.add(name: "readback: a target cleared to #336699 reads back 0x33 0x66 0x99, 37x23 RGBA8 in sRGB, straight alpha",
                           why: copy why);
            if (!this.gpu.isEmpty()) {
                this.declaredCount = this.declaredCount + 1;
                string said = "the frame was not read: " + why;
                match (this.image) {
                    case Some(value: img): {
                        if (!this.software) { said = "the adapter is not the software GPU the leg names, so its frame is not compared"; }
                        else {
                            DynamicArray<uint8> frame = DynamicArray.empty();
                            borrow img.samples8() as px { for (isize i = 0; i < px.length(); i = i + 1) { frame.add(item: px[i]); } }
                            said = checkGolden(test: "readback", gpu: this.gpu, width: 37, height: 23, frame: frame);
                        }
                    }
                    case None: { }
                };
                if (said.isEmpty()) { this.matchedCount = this.matchedCount + 1; }
                this.found.add(name: "golden readback on " + this.gpu, why: give said);
            }
            // polled once more after its image was handed over
            PixelStatus again = match (this.reading) {
                case Some(value: r): r.poll();
                case None: PixelStatus::Failed(error: GpuError::Refused(words: "no read"));
            };
            bool taken = match (again) { case Failed(error: e): match (e) { case Taken: true; case _: false; }; case _: false; };
            this.found.add(name: "readback: a read polled again once its image was handed over says Taken",
                           why: taken ? "" : "it did not");
            this.reading = Optional::None;
            this.next(to: 2);
        } else if (this.stage == 2) {
            // another colour and an alpha, cleared through a copy of the target and read through the original
            match (this.renderer) {
                case Some(value: r): {
                    r.clearColorMut() = Color.fromHex(hex: 0xff8000);
                    r.clearAlphaMut() = 0.4;
                    match (this.target) {
                        case Some(value: t): {
                            Shared<RenderTarget> alias = copy t;
                            r.clear(target: alias);
                            this.reading = Optional::Some(value: r.readRenderTargetPixels(target: copy t));
                        }
                        case None: { }
                    };
                }
                case None: { }
            };
            this.next(to: 3);
        } else if (this.stage == 3) {
            if (!this.settled()) { return false; }
            this.found.add(name: "readback: the clear colour is the one set when clearing, its alpha 0.4 is 102 and not sRGB-encoded, and another holder of a target clears the target",
                           why: this.read(width: 37, height: 23, r: 0xff, g: 0x80, b: 0x00, a: 102));
            this.reading = Optional::None;
            // a target never cleared
            match (this.renderer) {
                case Some(value: r): {
                    Shared<RenderTarget> fresh = new RenderTarget.make(width: 1, height: 1);
                    this.reading = Optional::Some(value: r.readRenderTargetPixels(target: fresh));
                }
                case None: { }
            };
            this.next(to: 4);
        } else if (this.stage == 4) {
            if (!this.settled()) { return false; }
            this.found.add(name: "readback: a target never cleared reads back as WebGPU makes a texture, every byte 0",
                           why: this.read(width: 1, height: 1, r: 0, g: 0, b: 0, a: 0));
            // a read dropped while pending, then another
            match (this.renderer) {
                case Some(value: r): {
                    match (this.target) {
                        case Some(value: t): {
                            PixelRead dropped = r.readRenderTargetPixels(target: copy t);
                            this.reading = Optional::Some(value: r.readRenderTargetPixels(target: copy t));
                        }
                        case None: { }
                    };
                }
                case None: { }
            };
            this.next(to: 5);
        } else if (this.stage == 5) {
            if (!this.settled()) { return false; }
            this.found.add(name: "readback: a read dropped while pending leaves the next one whole",
                           why: this.read(width: 37, height: 23, r: 0xff, g: 0x80, b: 0x00, a: 102));
            // a second renderer on the same device, with three.js's defaults: black, alpha 1
            Renderer second = gpuResolved(device: copy this.device, queue: copy this.queue);
            uint32 hex = second.clearColor().hex();
            float32 alpha = second.clearAlpha();
            this.found.add(name: "Renderer: its clear colour is black and its alpha 1, as three.js's",
                           why: hex == 0 && alpha == 1.0 ? "" : "the colour ${hex}, the alpha ${alpha}");
            Shared<RenderTarget> small = new RenderTarget.make(width: 3, height: 2);
            this.clearAndRead(renderer: second, target: small);
            this.next(to: 6);
        } else if (this.stage == 6) {
            if (!this.settled()) { return false; }
            this.found.add(name: "Renderer: two renderers share one device, and the second clears to its own default colour",
                           why: this.read(width: 3, height: 2, r: 0, g: 0, b: 0, a: 0xff));
            DeviceErrors errs = this.device.takeErrors();
            isize n = errs.reports().length();
            string first = n > 0 ? errs.reports()[0].message() : "";
            this.found.add(name: "Renderer: its clears and reads raise no WebGPU error",
                           why: errs.isEmpty() ? "" : "the channel holds ${n} error(s), the first: " + first);
            this.reading = Optional::None;
            this.image = Optional::None;
            this.target = Optional::None;
            this.renderer = Optional::None;
            this.stage = 999;
        }
        return this.stage == 999;
    }
}
