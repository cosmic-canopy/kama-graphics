// The golden harness (GFX-1's part 1; kyoten's docs/design/rendering.md § Decided, GFX-1's questions 3 and 4, and part
// 1's questions 2 and 3). A golden is a saved picture of what a test should draw. It is rendered on a software GPU,
// which draws the same bytes on every run, and a frame is held to it byte for byte. Each leg names its software GPU
// (`--golden warp` natively and in Firefox, `--golden swiftshader` in Chromium), since the adapter cannot say which it is,
// and a test's golden on that GPU is `tests/goldens/<test>/<gpu>.png`, read through std::asset.
//
// The tests never write a golden. A frame that differs from its golden, or has none yet, is printed as one line,
// `golden-png <test> <gpu> <base64>`: the frame as a PNG at @kama/image's archival(), whose bytes no kama version moves.
// `kama run` and the driver carry it from a browser as they carry any line. tools/update-goldens.sh, run on purpose,
// writes those lines into tests/goldens/, and the change is reviewed in its diff.
//
// The comparison is `compareGolden`, with the golden's bytes handed in, so the harness's own cases hold it to frames made
// in memory; `checkGolden` reads the golden through std::asset and prints the line.

import {
    core::println,
    std::collections::DynamicArray, std::collections::FixedArray,
    std::encoding::base64::encode as base64Encode,
    std::io::IoError, std::io::IoErrorKind,
    std::asset::read as readAsset,
    image::Image, image::ImageError, image::PixelFormat, image::AlphaMode, image::ColorSpace, image::DecodeOptions,
    image::png::decode as pngDecode, image::png::encode as pngEncode, image::png::EncodeOptions,
};
export { GoldenVerdict, compareGolden, checkGolden, goldenAsset, framePng, isGoldenName };

// What a frame's comparison with its golden found. `why()` is "" when the frame is its golden's bytes, and otherwise
// says how it is not; `line()` is then the frame as the line to print, empty only when the frame could not be encoded,
// which `why()` also says.
type resource GoldenVerdict {
    string said;
    string printed;

    public ctor make(string why, string line) {
        this.said = give why;
        this.printed = give line;
    }
    public const fn string why() { return copy this.said; }
    public const fn string line() { return copy this.printed; }
}

// A golden's name under the assets directory, tests/goldens/.
fn string goldenAsset(const ref string test, const ref string gpu) { return test + "/" + gpu + ".png"; }

// A test's or a GPU's name as a golden's path takes it: lowercase letters, digits and inner hyphens, so a printed line
// can never name a file outside tests/goldens/.
fn bool isGoldenName(const ref string name) {
    isize n = name.length();
    if (n == 0) { return false; }
    for (isize i = 0; i < n; i = i + 1) {
        uint8 c = name[i];
        bool letter = c >= 97ui8 && c <= 122ui8;
        bool digit = c >= 48ui8 && c <= 57ui8;
        bool hyphen = c == 45ui8 && i > 0 && i < n - 1;
        if (!letter && !digit && !hyphen) { return false; }
    }
    return true;
}

// The frame as a PNG: tight RGBA8 rows, top first, `width` by `height`, alpha kept as it is, at archival().
fn Result<DynamicArray<uint8>, ImageError> framePng(isize width, isize height, const ref DynamicArray<uint8> frame) {
    FixedArray<uint8> samples = FixedArray.make(size: frame.length());
    for (isize i = 0; i < frame.length(); i = i + 1) { samples[i] = frame[i]; }
    Result<Image, ImageError> made = Image.fromSamples8(width: width, height: height, format: PixelFormat::Rgba8Unorm,
                                                         alpha: AlphaMode::Straight, colorSpace: ColorSpace.srgb(),
                                                         samples: give samples);
    return match (give made) {
        case Ok(value: img): pngEncode(image: img, options: EncodeOptions.archival());
        case Err(error: e): Result::Err(error: e);
    };
}

fn string formatName(PixelFormat f) {
    return match (f) {
        case R8Unorm: "R8Unorm";
        case Rg8Unorm: "Rg8Unorm";
        case Rgba8Unorm: "Rgba8Unorm";
        case R16Unorm: "R16Unorm";
        case Rg16Unorm: "Rg16Unorm";
        case Rgba16Unorm: "Rgba16Unorm";
        case Rgba16Float: "Rgba16Float";
        case Rgba32Float: "Rgba32Float";
        case _: "a format this harness does not name";
    };
}

// How the decoded golden differs from the frame: "" when it does not.
fn string differs(const ref Image golden, isize width, isize height, const ref DynamicArray<uint8> frame) {
    isize gw = golden.width();
    isize gh = golden.height();
    if (gw != width || gh != height) { return "the golden is ${gw}x${gh}, the frame ${width}x${height}"; }
    PixelFormat f = golden.format();
    bool rgba8 = match (f) { case Rgba8Unorm: true; case _: false; };
    if (!rgba8) { string named = formatName(f: f); return "the golden decodes as " + named + ", not Rgba8Unorm"; }
    isize count = 0;
    isize first = -1;
    borrow golden.samples8() as want {
        if (want.length() != frame.length()) {
            isize wl = want.length();
            isize fl = frame.length();
            return "the golden holds ${wl} bytes, the frame ${fl}";
        }
        for (isize t = 0; t < width * height; t = t + 1) {
            isize at = t * 4;
            bool same = frame[at] == want[at] && frame[at + 1] == want[at + 1] && frame[at + 2] == want[at + 2]
                && frame[at + 3] == want[at + 3];
            if (!same) {
                if (first < 0) { first = t; }
                count = count + 1;
            }
        }
        if (count == 0) { return ""; }
        isize x = first % width;
        isize y = first / width;
        isize at = first * 4;
        uint8 r = frame[at];
        uint8 g = frame[at + 1];
        uint8 b = frame[at + 2];
        uint8 a = frame[at + 3];
        uint8 wr = want[at];
        uint8 wg = want[at + 1];
        uint8 wb = want[at + 2];
        uint8 wa = want[at + 3];
        return "${count} of its texels differ from the golden's, the first at (${x}, ${y}): ${r} ${g} ${b} ${a}, the golden ${wr} ${wg} ${wb} ${wa}";
    }
}

// The frame held to its golden, whose bytes were read as `golden` (NotFound when the test has none on this GPU yet).
// `frame` is tight RGBA8 rows, top first.
unsafe fn GoldenVerdict compareGolden(const ref string test, const ref string gpu, isize width, isize height,
                                      const ref DynamicArray<uint8> frame,
                                      const ref Result<DynamicArray<uint8>, IoError> golden) {
    isize want = width * height * 4;
    if (width <= 0 || height <= 0 || frame.length() != want) {
        isize got = frame.length();
        return GoldenVerdict.make(why: "the frame holds ${got} bytes, not ${width}x${height} RGBA8", line: "");
    }
    string why = match (golden) {
        case Ok(value: bytes): {
            Result<Image, ImageError> decoded = pngDecode(bytes: bytes.view(), options: DecodeOptions.defaults());
            := match (decoded) {
                case Ok(value: img): differs(golden: img, width: width, height: height, frame: frame);
                case Err(error: e): "the golden is not a PNG this harness reads: " + e.message();
            };
        }
        case Err(error: e): {
            bool missing = match (e.kind()) { case NotFound: true; case _: false; };
            := missing ? "no golden yet" : "the golden could not be read: " + e.message();
        }
    };
    if (why.isEmpty()) { return GoldenVerdict.make(why: "", line: ""); }
    Result<DynamicArray<uint8>, ImageError> png = framePng(width: width, height: height, frame: frame);
    return match (give png) {
        case Ok(value: file): GoldenVerdict.make(why: copy why, line: "golden-png " + test + " " + gpu + " " + base64Encode(bytes: file.view()));
        case Err(error: e): GoldenVerdict.make(why: why + "; and the frame could not be encoded as a PNG: " + e.message(), line: "");
    };
}

// The frame held to `tests/goldens/<test>/<gpu>.png`: "" when it is the golden's bytes. Otherwise the frame is printed as
// its line, for tools/update-goldens.sh, and the words say why.
unsafe fn string checkGolden(const ref string test, const ref string gpu, isize width, isize height,
                             const ref DynamicArray<uint8> frame) {
    if (!isGoldenName(name: test) || !isGoldenName(name: gpu)) {
        return "a golden's test and GPU are lowercase letters, digits and inner hyphens: '" + test + "', '" + gpu + "'";
    }
    Result<DynamicArray<uint8>, IoError> golden = readAsset(name: goldenAsset(test: test, gpu: gpu));
    GoldenVerdict v = compareGolden(test: test, gpu: gpu, width: width, height: height, frame: frame, golden: golden);
    string line = v.line();
    if (!line.isEmpty()) { println(s: copy line); }
    return v.why();
}
