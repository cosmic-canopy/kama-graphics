// The output pass (kyoten's rendering.md § Decided, area 3, and GFX-1's part 4, the frame): a render draws the scene
// into a 16-bit float texture, linear and exposed by its camera, and this pass writes an 8-bit sRGB target from it
// through the camera's tone mapping. The target's format encodes sRGB as it stores, so the pass writes linear light.
//
// It is one full-screen triangle, drawn with no vertex buffer, each texel read with `textureLoad` at its own place, since
// the scene and the target are the same size.

import { blenderAgxSize };
export { ToneMapping, outputWgsl, readsTable };

// How a camera's linear, exposed scene becomes what an 8-bit target shows (part 4's question 2, and the owner's (A),
// each camera's):
// - `BlenderAgX`, the default: Blender's AgX view as Blender shows it on an sRGB display, its table made by the renderer
//   (agx.kama) and sampled tetrahedrally, as OpenColorIO samples Blender's;
// - `AgX`: three.js r187's AgX (`ToneMappingFunctions.js`, from Filament), which three.js programs know by the name;
// - `None`: the scene as it is, each channel clamped to 0 to 1 by the target, as three.js's `NoToneMapping`.
type enum ToneMapping { None, AgX, BlenderAgX }

// Whether the curve reads Blender's table, so its pass binds it.
fn bool readsTable(ToneMapping curve) { return curve == ToneMapping::BlenderAgX; }

// three.js r187's AgX, its exposure already applied by the scene (pre-exposure), so 1 here.
fn string r187Agx() {
    return "fn agxContrast(x: vec3f) -> vec3f {\n"
        + "  let x2 = x * x;\n"
        + "  let x4 = x2 * x2;\n"
        + "  return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;\n"
        + "}\n"
        + "fn agx(colour: vec3f) -> vec3f {\n"
        + "  let srgbTo2020 = mat3x3f(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0113, 0.8956);\n"
        + "  let from2020 = mat3x3f(1.6605, -0.1246, -0.0182, -0.5876, 1.1329, -0.1006, -0.0728, -0.0083, 1.1187);\n"
        + "  let inset = mat3x3f(0.856627153315983, 0.137318972929847, 0.11189821299995, 0.0951212405381588, 0.761241990602591, 0.0767994186031903, 0.0482516061458583, 0.101439036467562, 0.811302368396859);\n"
        + "  let outset = mat3x3f(1.1271005818144368, -0.1413297634984383, -0.14132976349843826, -0.11060664309660323, 1.157823702216272, -0.11060664309660294, -0.016493938717834573, -0.016493938717834257, 1.2519364065950405);\n"
        + "  const minEv = -12.47393;\n"
        + "  const maxEv = 4.026069;\n"
        + "  var c = inset * (srgbTo2020 * colour);\n"
        + "  c = max(c, vec3f(1e-10));\n"
        + "  c = clamp((log2(c) - minEv) / (maxEv - minEv), vec3f(0.0), vec3f(1.0));\n"
        + "  c = outset * agxContrast(c);\n"
        + "  c = pow(max(vec3f(0.0), c), vec3f(2.2));\n"
        + "  return clamp(from2020 * c, vec3f(0.0), vec3f(1.0));\n"
        + "}\n";
}

// Blender's AgX: the scene from linear Rec.709 into Linear FilmLight E-Gamut and the lg2 allocation over
// [−12.47393, 12.5260688117] (Blender 5.3's config.ocio), the table read tetrahedrally as OpenColorIO reads it, and its
// value, Rec.1886-encoded, decoded with its 2.4 power, so the target's sRGB encoding shows what Blender's sRGB display
// shows.
fn string blenderAgx() {
    isize top = blenderAgxSize() - 1;
    string last = "${top}.0";
    string lastIndex = "${top}";
    return "@group(0) @binding(1) var agxTable: texture_3d<f32>;\n"
        + "fn agxAt(p: vec3i) -> vec3f { return textureLoad(agxTable, p, 0).rgb; }\n"
        + "fn blenderAgx(colour: vec3f) -> vec3f {\n"
        + "  let toEGamut = mat3x3f(0.5593711333100773, 0.07622070548350635, 0.06552671177877019, 0.30478334662300904, 0.7879717701028465, 0.16454675460372412, 0.13584556048047705, 0.13580746617472156, 0.7699265016503745);\n"
        + "  let e = toEGamut * colour;\n"
        + "  let code = clamp((log2(max(e, vec3f(1e-30))) + 12.47393) / (12.5260688117 + 12.47393), vec3f(0.0), vec3f(1.0));\n"
        + "  let at = code * " + last + ";\n"
        + "  let low = min(floor(at), vec3f(" + last + "));\n"
        + "  let f = at - low;\n"
        + "  let l = vec3i(low);\n"
        + "  let h = min(l + vec3i(1), vec3i(" + lastIndex + "));\n"
        + "  let c000 = agxAt(l);\n"
        + "  let c111 = agxAt(h);\n"
        + "  var v: vec3f;\n"
        + "  if (f.r > f.g) {\n"
        + "    if (f.g > f.b) {\n"
        + "      let c100 = agxAt(vec3i(h.x, l.y, l.z)); let c110 = agxAt(vec3i(h.x, h.y, l.z));\n"
        + "      v = c000 + f.r * (c100 - c000) + f.g * (c110 - c100) + f.b * (c111 - c110);\n"
        + "    } else if (f.r > f.b) {\n"
        + "      let c100 = agxAt(vec3i(h.x, l.y, l.z)); let c101 = agxAt(vec3i(h.x, l.y, h.z));\n"
        + "      v = c000 + f.r * (c100 - c000) + f.b * (c101 - c100) + f.g * (c111 - c101);\n"
        + "    } else {\n"
        + "      let c001 = agxAt(vec3i(l.x, l.y, h.z)); let c101 = agxAt(vec3i(h.x, l.y, h.z));\n"
        + "      v = c000 + f.b * (c001 - c000) + f.r * (c101 - c001) + f.g * (c111 - c101);\n"
        + "    }\n"
        + "  } else {\n"
        + "    if (f.b > f.g) {\n"
        + "      let c001 = agxAt(vec3i(l.x, l.y, h.z)); let c011 = agxAt(vec3i(l.x, h.y, h.z));\n"
        + "      v = c000 + f.b * (c001 - c000) + f.g * (c011 - c001) + f.r * (c111 - c011);\n"
        + "    } else if (f.b > f.r) {\n"
        + "      let c010 = agxAt(vec3i(l.x, h.y, l.z)); let c011 = agxAt(vec3i(l.x, h.y, h.z));\n"
        + "      v = c000 + f.g * (c010 - c000) + f.b * (c011 - c010) + f.r * (c111 - c011);\n"
        + "    } else {\n"
        + "      let c010 = agxAt(vec3i(l.x, h.y, l.z)); let c110 = agxAt(vec3i(h.x, h.y, l.z));\n"
        + "      v = c000 + f.g * (c010 - c000) + f.r * (c110 - c010) + f.b * (c111 - c110);\n"
        + "    }\n"
        + "  }\n"
        + "  return pow(max(v, vec3f(0.0)), vec3f(2.4));\n"
        + "}\n";
}

// The output pass's WGSL for `curve`.
fn string outputWgsl(ToneMapping curve) {
    string functions = match (curve) {
        case None: "";
        case AgX: r187Agx();
        case BlenderAgX: blenderAgx();
    };
    string mapped = match (curve) {
        case None: "  return vec4f(scene.rgb, scene.a);\n";
        case AgX: "  return vec4f(agx(scene.rgb), scene.a);\n";
        case BlenderAgX: "  return vec4f(blenderAgx(scene.rgb), scene.a);\n";
    };
    return "@group(0) @binding(0) var sceneTexture: texture_2d<f32>;\n"
        + functions
        + "@vertex fn vs(@builtin(vertex_index) corner: u32) -> @builtin(position) vec4f {\n"
        + "  let x = f32((corner << 1u) & 2u);\n"
        + "  let y = f32(corner & 2u);\n"
        + "  return vec4f(x * 2.0 - 1.0, 1.0 - y * 2.0, 0.0, 1.0);\n"
        + "}\n"
        + "@fragment fn fs(@builtin(position) at: vec4f) -> @location(0) vec4f {\n"
        + "  let scene = textureLoad(sceneTexture, vec2i(at.xy), 0);\n"
        + mapped
        + "}\n";
}
