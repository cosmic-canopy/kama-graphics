// A render target: a texture a camera draws into in place of the window, cleared and read on its own (kyoten's
// rendering.md § Decided, GFX-1's part 1, questions 4 to 6). Its format decides what it holds (question 5):
// - **8-bit sRGB, the default,** holds what the window would show, tone mapped and sRGB-encoded, so it reads back as a
//   picture. A render draws the scene into a 16-bit float texture of the target's own and then writes the target from it
//   through its camera's tone mapping (part 4, the frame);
// - **16-bit float** holds the linear HDR scene, exposed by its camera, for a program that processes it further.
//
// It is an asset, shared (area 1, item 2; part 2, question 3): a program makes it with `new`, every holder of its
// `Shared` names the same target, and the last drop frees it. It is made with no device, as three.js's
// `new RenderTarget(width, height)` is, and a renderer makes its textures on its device the first time it uses it: the
// colour, the depth a render draws against, 32-bit float with reversed depth (GFX-1's question 1), and for an 8-bit
// target the scene's 16-bit float texture. A target used by renderers on two devices has textures on each, as three.js
// keeps one per renderer.

import {
    std::collections::DynamicArray,
    gpu::Device, gpu::Texture, gpu::TextureDescriptor, gpu::TextureFormat, gpu::TextureUsage,
    Renderer,
};
export { RenderTarget, TargetFormat };

// What a target holds: `Rgba8UnormSrgb` what the window would show, `Rgba16Float` the linear HDR scene. Named as
// WebGPU names the texture formats they are.
type enum TargetFormat { Rgba8UnormSrgb, Rgba16Float }

type resource RenderTarget {
    uint32 w;
    uint32 h;
    TargetFormat kind;
    DynamicArray<UnsafePtr> devices;   // the device each texture below was made on, by its handle
    DynamicArray<Texture> colours;
    DynamicArray<Texture> depths;
    DynamicArray<Texture> scenes;      // the 16-bit float texture a render draws the scene into: the colour itself on a
                                       // 16-bit float target

    friend Renderer::clear[textureOn, entryOn];
    friend Renderer::readRenderTargetPixels[textureOn, entryOn];
    friend Renderer::render[textureOn, depthOn, sceneOn, entryOn];

    // A target `width` by `height` texels, 8-bit sRGB.
    public unsafe ctor make(uint32 width, uint32 height) {
        this.w = width;
        this.h = height;
        this.kind = TargetFormat::Rgba8UnormSrgb;
        this.devices = DynamicArray.empty();
        this.colours = DynamicArray.empty();
        this.depths = DynamicArray.empty();
        this.scenes = DynamicArray.empty();
    }

    // A target `width` by `height` texels of `format`: `TargetFormat::Rgba16Float` holds the linear scene.
    public unsafe ctor withFormat(uint32 width, uint32 height, TargetFormat format) {
        this.w = width;
        this.h = height;
        this.kind = format;
        this.devices = DynamicArray.empty();
        this.colours = DynamicArray.empty();
        this.depths = DynamicArray.empty();
        this.scenes = DynamicArray.empty();
    }

    public const fn uint32 width() { return this.w; }
    public const fn uint32 height() { return this.h; }
    public const fn TargetFormat format() { return this.kind; }
    // Whether the target holds the linear scene, so a render writes no output pass into it.
    public const fn bool holdsScene() { return match (this.kind) { case Rgba16Float: true; case Rgba8UnormSrgb: false; }; }

    // Which entry `device` has, made the first time: a texture holds its device, so a device's handle is never reused
    // while its textures are kept here.
    unsafe fn isize entryOn(ref Device device) {
        UnsafePtr at = device.raw();
        for (isize i = 0; i < this.devices.length(); i = i + 1) {
            if (this.devices[i] == at) { return i; }
        }
        TextureFormat format = match (this.kind) {
            case Rgba8UnormSrgb: TextureFormat::RGBA8UnormSrgb;
            case Rgba16Float: TextureFormat::RGBA16Float;
        };
        TextureDescriptor c = TextureDescriptor.make(width: this.w, height: this.h, format: format,
                                                     usage: TextureUsage::RenderAttachment | TextureUsage::CopySrc | TextureUsage::TextureBinding);
        c.label(text: "a render target");
        Texture colour = device.createTexture(descriptor: give c);
        // TextureBinding too: on wgpu-native v29's D3D12 a depth texture that is only a RenderAttachment loses the
        // device in a read-only depth pass (@kama/gpu's AGENTS.gpu.md item 13), which the shaded pass is.
        TextureDescriptor d = TextureDescriptor.make(width: this.w, height: this.h, format: TextureFormat::Depth32Float,
                                                     usage: TextureUsage::RenderAttachment | TextureUsage::TextureBinding);
        d.label(text: "a render target's depth");
        Texture depth = device.createTexture(descriptor: give d);
        if (this.holdsScene()) {
            this.scenes.add(item: copy colour);
        } else {
            TextureDescriptor s = TextureDescriptor.make(width: this.w, height: this.h, format: TextureFormat::RGBA16Float,
                                                         usage: TextureUsage::RenderAttachment | TextureUsage::TextureBinding);
            s.label(text: "a render target's scene");
            this.scenes.add(item: device.createTexture(descriptor: give s));
        }
        this.devices.add(item: at);
        this.colours.add(item: give colour);
        this.depths.add(item: give depth);
        return this.devices.length() - 1;
    }

    // The target's colour, depth and scene textures on `device`: each a handle of its own to the one texture.
    unsafe fn Texture textureOn(ref Device device) { isize i = this.entryOn(device: ref device); return copy this.colours[i]; }
    unsafe fn Texture depthOn(ref Device device) { isize i = this.entryOn(device: ref device); return copy this.depths[i]; }
    unsafe fn Texture sceneOn(ref Device device) { isize i = this.entryOn(device: ref device); return copy this.scenes[i]; }
}
