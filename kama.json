{
  "name": "@kama/graphics",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "description": "A lightweight 3D graphics library on @kama/gpu: scenes, meshes, materials, lights, cameras and loaders",
  "repository": "https://github.com/cosmic-canopy/kama-graphics",
  "keywords": ["graphics", "scene", "webgpu", "rendering"],
  "kind": "library",
  "kama": ">=0.9.949",
  "publish": {
    "exclude": [
      ".claude/", "AGENTS.md", "AGENTS.package.md", "AGENTS.graphics.md", "CLAUDE.md", "KAMA_GAPS.md", "tools/",
      "third_party/", "tests/goldens/", "examples/cube/goldens/"
    ]
  },
  "modules": {
    ".": { "visibility": "public" }
  },
  "dependencies": {
    "@kama/gpu": { "path": "../kama-gpu" },
    "@kama/window": { "path": "../kama-window" },
    "@kama/image": { "path": "../kama-image" }
  }
}
