// What a mesh is drawn with. Three.js's mesh materials are typed presets over one node-material system (kyoten's
// rendering.md § Decided, area 3, item 2); `MeshBasicMaterial`, unlit, is the first (GFX-1's part 2, question 2). A
// material is an asset, shared: a program makes it with `new`, every mesh holding its `Shared` draws with it, and changing
// a setting changes them all, as in three.js. A setting is a value, so changing one never compiles a shader.
//
// A material's shader is its typed nodes, compiled to WGSL by the renderer once (node_builder.kama, GFX-1's part 3), and
// its settings are declared apart from its nodes, so writing them after a change builds no node.

import {
    std::collections::DynamicArray,
    gpu::Device, gpu::Queue, gpu::Buffer, gpu::BufferDescriptor, gpu::BufferUsage, gpu::BufferBinding,
    gpu::BindGroup, gpu::BindGroupDescriptor, gpu::BindGroupLayout, gpu::BindingResource,
    Color, Renderer, MaterialSettings, NodeBuilder, Vec3Node, vec4, constant,
};
export { Material, MaterialGpu, MeshBasicMaterial };

// What every material is to the renderer: its settings with their values now, its typed nodes, and a number that moves
// whenever a setting changes, so the renderer writes them again only then. Its nodes read its settings by name through
// the builder, which writes them as group 1's uniform block, after the renderer's frame and object records in group 0.
type contract Material for resource {
    const fn void settings(ref MaterialSettings into);
    fn void shade(ref NodeBuilder builder);
    const fn uint32 version();
    fn ref MaterialGpu gpuMut();
}

// What a renderer keeps of a material: its WGSL, compiled once, or what its compile refused; and its settings on each
// device that drew it, a uniform buffer and its bind group, written again when the material's version moved. Only a
// renderer reaches it.
type resource MaterialGpu {
    DynamicArray<UnsafePtr> devices;
    DynamicArray<Buffer> uniforms;
    DynamicArray<BindGroup> groups;
    DynamicArray<uint32> versions;
    Optional<string> compiled = Optional::None;
    DynamicArray<string> refusals;

    friend Renderer::render[groupOn, staleOn, isCompiled, source, refused];
    friend Renderer::compile[store];

    public unsafe ctor make() {
        this.devices = DynamicArray.empty();
        this.uniforms = DynamicArray.empty();
        this.groups = DynamicArray.empty();
        this.versions = DynamicArray.empty();
        this.refusals = DynamicArray.empty();
    }

    const fn bool isCompiled() { return this.compiled.isSome(); }
    fn void store(string wgsl, DynamicArray<string> problems) {
        this.compiled = Optional::Some(value: give wgsl);
        this.refusals = give problems;
    }
    const fn string source() { return match (this.compiled) { case Some(value: s): copy s; case None: ""; }; }
    const fn DynamicArray<string> refused() { return copy this.refusals; }

    // Whether `device` has no settings of this material's `version` yet, so they are to be written.
    unsafe const fn bool staleOn(const ref Device device, uint32 version) {
        UnsafePtr at = device.raw();
        for (isize i = 0; i < this.devices.length(); i = i + 1) {
            if (this.devices[i] == at) { return this.versions[i] != version; }
        }
        return true;
    }

    // The bind group of `settings` on `device`, made with `layout` the first time, and its buffer written whenever
    // `version` is not the one last written.
    unsafe fn BindGroup groupOn(ref Device device, ref Queue queue, const ref BindGroupLayout layout,
                                const ref DynamicArray<uint8> settings, uint32 version) {
        UnsafePtr at = device.raw();
        for (isize i = 0; i < this.devices.length(); i = i + 1) {
            if (this.devices[i] == at) {
                if (this.versions[i] != version) {
                    queue.writeBuffer(buffer: this.uniforms[i], offset: 0, data: settings.view());
                    this.versions[i] = version;
                }
                return copy this.groups[i];
            }
        }
        BufferDescriptor described = BufferDescriptor.make(size: cast<uint64>(settings.length()),
                                                           usage: BufferUsage::Uniform | BufferUsage::CopyDst);
        described.label(text: "a material's settings");
        Buffer uniform = device.createBuffer(descriptor: give described);
        queue.writeBuffer(buffer: uniform, offset: 0, data: settings.view());
        BindGroupDescriptor bound = BindGroupDescriptor.make(layout: copy layout);
        bound.entry(binding: 0, resource: BindingResource::Buffer(binding: BufferBinding.whole(buffer: copy uniform)));
        bound.label(text: "a material's group");
        BindGroup group = device.createBindGroup(descriptor: give bound);
        this.devices.add(item: at);
        this.uniforms.add(item: give uniform);
        this.groups.add(item: copy group);
        this.versions.add(item: version);
        return group;
    }
}

// Unlit: every fragment its colour, as three.js's `MeshBasicMaterial`, white by default.
type resource MeshBasicMaterial implements Material {
    Color tint = Color.fromHex(hex: 0xffffff);
    uint32 changes = 0;
    MaterialGpu cache;

    public ctor make() { this.cache = MaterialGpu.make(); }

    public fn ref MaterialGpu gpuMut() { return this.cache; }

    // Its colour, written in sRGB and held linear, as every colour is.
    public const fn Color color() { return this.tint; }
    public fn ref Color colorMut() { this.changes = this.changes + 1; return this.tint; }

    public const fn uint32 version() { return this.changes; }
    // Its one setting, its colour, linear.
    public const fn void settings(ref MaterialSettings into) { into.addColor(name: "color", value: this.tint); }
    // As three.js's: the colour, opaque, on every mesh's vertex stage.
    public fn void shade(ref NodeBuilder builder) {
        Vec3Node colour = builder.uniformVec3(name: "color");
        builder.fragmentColor(node: vec4(xyz: colour, w: constant(value: 1.0)));
    }
}
