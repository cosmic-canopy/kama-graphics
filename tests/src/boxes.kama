// GFX-1's part 2 on the GPU: scenes drawn by `Renderer.render` into an 8-bit sRGB target and read back (kyoten's
// rendering.md § Decided, GFX-1's part 2). A step a tick on the device the check opened.
//
// - **The golden, `tests/goldens/boxes/<gpu>.png`:** two boxes crossing in depth, in two colours, so the frame holds
//   reversed depth and the crossing line, not only a silhouette.
// - **On every leg, hardware too:** every texel is the clear colour or one of the boxes', or at an edge the GPU's resolve
//   of 4 samples of them (4x MSAA, part 4's step 4; nothing is blended), both boxes show; two scenes that draw the same
//   boxes in opposite orders read back the same bytes, the nearer box in front; and `info()` counts the draws, and the
//   world matrices made only where something changed.
// - **The tree's world matrices:** through a turned parent, `lookAt`, `rotateOnWorldAxis` under a turned parent, and a
//   mesh's record given up when it leaves its scene.

import {
    core::println,
    std::collections::DynamicArray,
    std::math::Vec3, std::math::Quat, std::math::Mat4, std::math::abs, std::math::radians,
    std::time::Instant, std::time::monotonicNow,
    gpu::Device, gpu::Queue, gpu::GpuError, gpu::DeviceErrors,
    image::Image,
    graphics::Color, graphics::Renderer, graphics::RenderInfo, graphics::RenderTarget, graphics::PixelRead,
    graphics::PixelStatus, graphics::Scene, graphics::Group, graphics::Mesh, graphics::PerspectiveCamera, graphics::ToneMapping,
    graphics::BoxGeometry, graphics::MeshBasicMaterial, graphics::Euler, graphics::EulerOrder,
    graphics::RendererErrors, graphics::GraphicsErrorKind,
    gpuResolved, Verdicts, checkGolden, fromSamples,
};
export { BoxesRun };

comptime int64 SETTLE_MS = 10000;
comptime uint32 WIDE = 64;
comptime uint32 HIGH = 48;
comptime uint32 BACKDROP = 0x202020;
comptime uint32 RED = 0xcc3333;
comptime uint32 BLUE = 0x3366cc;
comptime uint32 GREEN = 0x33aa44;

fn bool close(float32 a, float32 b) { return abs(x: a - b) < 0.0001; }

// The image's texels as one byte array, RGBA.
fn DynamicArray<uint8> bytesOf(const ref Image img) {
    DynamicArray<uint8> collected = DynamicArray.empty();
    borrow img.samples8() as px { for (isize i = 0; i < px.length(); i = i + 1) { collected.add(item: px[i]); } }
    return collected;
}

fn uint32 texel(const ref DynamicArray<uint8> frame, isize x, isize y) {
    isize at = (y * cast<isize>(WIDE) + x) * 4;
    return (cast<uint32>(frame[at]) << 16) | (cast<uint32>(frame[at + 1]) << 8) | cast<uint32>(frame[at + 2]);
}

// "" when every texel is one of the colours, or at an edge the GPU's resolve of 4 samples of them, opaque, and each
// colour shows.
fn string onlyColours(const ref DynamicArray<uint8> frame, uint32 a, uint32 b, uint32 c) {
    isize na = 0; isize nb = 0; isize nc = 0; isize other = 0; uint32 first = 0;
    DynamicArray<uint32> colours = DynamicArray.empty();
    colours.add(item: a);
    colours.add(item: b);
    colours.add(item: c);
    for (isize y = 0; y < cast<isize>(HIGH); y = y + 1) {
        for (isize x = 0; x < cast<isize>(WIDE); x = x + 1) {
            uint32 t = texel(frame: frame, x: x, y: y);
            uint8 alpha = frame[(y * cast<isize>(WIDE) + x) * 4 + 3];
            if (alpha != 255) { other = other + 1; }
            else if (t == a) { na = na + 1; }
            else if (t == b) { nb = nb + 1; }
            else if (t == c) { nc = nc + 1; }
            else if (!fromSamples(t: t, colours: colours, tolerance: 1)) { if (other == 0) { first = t; } other = other + 1; }
        }
    }
    if (other > 0) { return "${other} texels are none of the colours, the first ${first}"; }
    if (na == 0 || nb == 0 || nc == 0) { return "a colour does not show: ${na}, ${nb} and ${nc} texels"; }
    return "";
}

fn string infoIs(RenderInfo got, int32 calls, int32 triangles, int32 objects, int32 matrices) {
    if (got.calls == calls && got.triangles == triangles && got.objects == objects && got.matrices == matrices) { return ""; }
    return "calls ${got.calls}, triangles ${got.triangles}, objects ${got.objects}, matrices ${got.matrices}";
}

unsafe fn Shared<MeshBasicMaterial> coloured(uint32 hex) {
    Shared<MeshBasicMaterial> m = new MeshBasicMaterial.make();
    m.colorMut() = Color.fromHex(hex: hex);
    return m;
}

type resource BoxesRun {
    int32 stage = 0;
    Instant began = monotonicNow();
    string gpu;
    bool software;
    int32 declaredCount = 0;
    int32 matchedCount = 0;
    Verdicts found;
    Device device;
    Queue queue;
    Optional<Renderer> renderer = Optional::None;
    Optional<Shared<RenderTarget>> target = Optional::None;
    Optional<Shared<PerspectiveCamera>> camera = Optional::None;
    Optional<Shared<Scene>> crossing = Optional::None;
    Optional<Shared<Mesh>> left = Optional::None;
    Optional<Shared<MeshBasicMaterial>> redLook = Optional::None;
    Optional<PixelRead> reading = Optional::None;
    Optional<Image> image = Optional::None;
    string failed = "";
    DynamicArray<uint8> before;   // the first of the two orders' frames
    isize leftEdge = -1;          // the crossing frame's leftmost coloured column, before the left box moved

    public ctor make(string gpu, bool software, Device device, Queue queue) {
        this.gpu = give gpu;
        this.software = software;
        this.found = Verdicts.make();
        this.device = give device;
        this.queue = give queue;
        this.before = DynamicArray.empty();
    }

    public fn ref Verdicts verdicts() { return this.found; }
    public const fn int32 declared() { return this.declaredCount; }
    public const fn int32 matched() { return this.matchedCount; }

    unsafe fn void next(int32 to) { this.stage = to; this.began = monotonicNow(); }

    unsafe fn bool settled() {
        PixelStatus s = match (this.reading) {
            case Some(value: r): r.poll();
            case None: PixelStatus::Failed(error: GpuError::Refused(words: "no read was started"));
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (pending && this.began.elapsed().asMillis() < SETTLE_MS) { return false; }
        this.image = Optional::None;
        this.failed = "";
        match (give s) {
            case Ready(image: img): { this.image = Optional::Some(value: give img); }
            case Failed(error: e): { this.failed = "the read failed: " + e.message(); }
            case Pending: { this.failed = "the read was still pending after ${SETTLE_MS} ms"; }
        };
        this.reading = Optional::None;
        return true;
    }

    unsafe fn DynamicArray<uint8> frame() {
        return match (this.image) { case Some(value: img): bytesOf(img: img); case None: DynamicArray.empty(); };
    }

    // Render `scene` with the test's camera into its target, and start reading it back.
    unsafe fn RenderInfo renderAndRead(Shared<Scene> scene) {
        RenderInfo said = RenderInfo.of(calls: -1, triangles: -1, objects: -1, matrices: -1, misses: -1, skipped: -1, general: -1, standIn: -1, waited: -1);
        match (this.renderer) {
            case Some(value: r): {
                match (this.camera) {
                    case Some(value: c): {
                        r.render(scene: scene, camera: copy c);
                        said = r.info();
                        match (this.target) {
                            case Some(value: t): { this.reading = Optional::Some(value: r.readRenderTargetPixels(target: copy t)); }
                            case None: { }
                        };
                    }
                    case None: { }
                };
            }
            case None: { }
        };
        return said;
    }

    // Render `scene` with no read: what the render said.
    unsafe fn RenderInfo renderOnly(Shared<Scene> scene) {
        RenderInfo said = RenderInfo.of(calls: -1, triangles: -1, objects: -1, matrices: -1, misses: -1, skipped: -1, general: -1, standIn: -1, waited: -1);
        match (this.renderer) {
            case Some(value: r): {
                match (this.camera) {
                    case Some(value: c): { r.render(scene: scene, camera: copy c); said = r.info(); }
                    case None: { }
                };
            }
            case None: { }
        };
        return said;
    }

    // The two boxes in front and behind, added in the order given: the nearer box red, the farther blue.
    unsafe fn Shared<Scene> nearAndFar(bool nearFirst) {
        Shared<Scene> s = new Scene.make();
        Shared<BoxGeometry> box = new BoxGeometry.make(width: 1.0, height: 1.0, depth: 1.0);
        Shared<Mesh> near = new Mesh.make(geometry: box, material: coloured(hex: RED));
        near.positionMut() = Vec3.of(x: 0.0, y: 0.0, z: 0.6);
        near.scaleMut() = Vec3.splat(s: 0.8);
        Shared<Mesh> far = new Mesh.make(geometry: box, material: coloured(hex: BLUE));
        far.positionMut() = Vec3.of(x: 0.3, y: 0.2, z: -0.6);
        if (nearFirst) { s.add(object: near); s.add(object: far); } else { s.add(object: far); s.add(object: near); }
        return s;
    }

    public unsafe fn bool step() {
        if (this.stage == 0) {
            Renderer r = gpuResolved(device: copy this.device, queue: copy this.queue);
            r.clearColorMut() = Color.fromHex(hex: BACKDROP);
            Shared<RenderTarget> t = new RenderTarget.make(width: WIDE, height: HIGH);
            Shared<PerspectiveCamera> cam = new PerspectiveCamera.make(fovRad: radians(deg: 50.0), near: 0.1, far: 100.0);
            cam.toneMappingMut() = ToneMapping::None;
            cam.positionMut() = Vec3.of(x: 0.0, y: 1.2, z: 3.5);
            cam.lookAt(target: Vec3.zero());
            cam.targetMut() = Optional::Some(value: copy t);
            // two boxes crossing in depth, each turned 30 degrees toward the other
            Shared<Scene> s = new Scene.make();
            Shared<BoxGeometry> box = new BoxGeometry.make(width: 1.0, height: 1.0, depth: 1.0);
            Shared<MeshBasicMaterial> red = coloured(hex: RED);
            Shared<Mesh> a = new Mesh.make(geometry: box, material: red);
            a.positionMut() = Vec3.of(x: -0.3, y: 0.0, z: 0.0);
            a.rotationMut() = Euler.fromDegrees(x: 0.0, y: 30.0, z: 0.0, order: EulerOrder::XYZ);
            Shared<Mesh> b = new Mesh.make(geometry: box, material: coloured(hex: BLUE));
            b.positionMut() = Vec3.of(x: 0.3, y: 0.0, z: 0.0);
            b.rotationMut() = Euler.fromDegrees(x: 0.0, y: -30.0, z: 0.0, order: EulerOrder::XYZ);
            s.add(object: a);
            s.add(object: b);
            this.renderer = Optional::Some(value: give r);
            this.target = Optional::Some(value: give t);
            this.camera = Optional::Some(value: give cam);
            this.crossing = Optional::Some(value: copy s);
            this.left = Optional::Some(value: give a);
            this.redLook = Optional::Some(value: give red);
            RenderInfo said = this.renderAndRead(scene: give s);
            this.found.add(name: "render: the first frame draws each box twice, into depth and then shaded, 12 triangles a draw, and makes the scene's 3 world matrices",
                           why: infoIs(got: said, calls: 4, triangles: 48, objects: 2, matrices: 3));
            this.next(to: 1);
        } else if (this.stage == 1) {
            if (!this.settled()) { return false; }
            DynamicArray<uint8> frame = this.frame();
            string why = this.failed.isEmpty() ? onlyColours(frame: frame, a: BACKDROP, b: RED, c: BLUE) : copy this.failed;
            this.found.add(name: "render: two boxes crossing in depth: every texel the backdrop or a box's colour, as written in sRGB, or at an edge their 4x MSAA resolve, each showing",
                           why: copy why);
            this.leftEdge = this.leftmost(frame: frame);
            if (!this.gpu.isEmpty()) {
                this.declaredCount = this.declaredCount + 1;
                string said = "the frame was not read: " + why;
                if (this.failed.isEmpty()) {
                    said = this.software ? checkGolden(test: "boxes", gpu: this.gpu, width: cast<isize>(WIDE), height: cast<isize>(HIGH), frame: frame)
                         : "the adapter is not the software GPU the leg names, so its frame is not compared";
                }
                if (said.isEmpty()) { this.matchedCount = this.matchedCount + 1; }
                this.found.add(name: "golden boxes on " + this.gpu, why: give said);
            }
            // nothing changed: no world matrix is made
            Shared<Scene> s = match (this.crossing) { case Some(value: x): copy x; case None: { panic(msg: "made at the first stage"); } };
            Shared<Mesh> a = match (this.left) { case Some(value: x): copy x; case None: { panic(msg: "made at the first stage"); } };
            RenderInfo still = this.renderOnly(scene: copy s);
            this.found.add(name: "flat-core: a frame where nothing changed makes no world matrix, and draws the same",
                           why: infoIs(got: still, calls: 4, triangles: 48, objects: 2, matrices: 0));
            a.positionMut().x = -0.6;
            RenderInfo one = this.renderOnly(scene: copy s);
            this.found.add(name: "flat-core: one box moved makes its world matrix alone",
                           why: infoIs(got: one, calls: 4, triangles: 48, objects: 2, matrices: 1));
            s.positionMut().y = 0.0;
            RenderInfo all = this.renderOnly(scene: copy s);
            this.found.add(name: "flat-core: the scene moved makes every world matrix below it",
                           why: infoIs(got: all, calls: 4, triangles: 48, objects: 2, matrices: 3));
            Shared<BoxGeometry> small = new BoxGeometry.make(width: 0.2, height: 0.2, depth: 0.2);
            Shared<Mesh> late = new Mesh.make(geometry: small, material: coloured(hex: BLUE));
            s.add(object: late);
            RenderInfo added = this.renderOnly(scene: copy s);
            this.found.add(name: "flat-core: a mesh added after the first frame is drawn, its world matrix the one made",
                           why: infoIs(got: added, calls: 6, triangles: 72, objects: 3, matrices: 1));
            s.remove(object: late);
            RenderInfo dropped = this.renderOnly(scene: copy s);
            this.found.add(name: "flat-core: the mesh removed again is drawn no more",
                           why: infoIs(got: dropped, calls: 4, triangles: 48, objects: 2, matrices: 0));
            // a refused add (the scene under one of its own meshes) changes nothing: no mark, no record, the same draws
            bool looped = a.add(object: s);
            RenderInfo refused = this.renderOnly(scene: copy s);
            this.found.add(name: "render: an add refused, the scene under one of its own meshes, marks nothing and draws the same",
                           why: looped ? "add said true" : infoIs(got: refused, calls: 4, triangles: 48, objects: 2, matrices: 0));
            RenderInfo first = this.renderAndRead(scene: this.nearAndFar(nearFirst: true));
            this.next(to: 2);
        } else if (this.stage == 2) {
            if (!this.settled()) { return false; }
            this.before = this.frame();
            string why = copy this.failed;
            if (why.isEmpty()) {
                uint32 centre = texel(frame: this.before, x: cast<isize>(WIDE) / 2, y: cast<isize>(HIGH) / 2);
                if (centre != RED) { why = "the centre is ${centre}, not the nearer box's ${RED}"; }
            }
            this.found.add(name: "render: reversed depth: the nearer box covers the farther, drawn first", why: give why);
            RenderInfo second = this.renderAndRead(scene: this.nearAndFar(nearFirst: false));
            this.next(to: 3);
        } else if (this.stage == 3) {
            if (!this.settled()) { return false; }
            DynamicArray<uint8> after = this.frame();
            string why = copy this.failed;
            if (why.isEmpty()) {
                isize differ = 0;
                if (after.length() != this.before.length()) { differ = -1; }
                else { for (isize i = 0; i < after.length(); i = i + 1) { if (after[i] != this.before[i]) { differ = differ + 1; } } }
                if (differ != 0) { why = "${differ} bytes differ between the two orders"; }
            }
            this.found.add(name: "render: depth decides, not the order: the same boxes drawn in the other order read back the same bytes",
                           why: give why);
            this.treeCases();
            // a camera inside a box sees only its faces' backs, which are not drawn, as three.js's FrontSide
            Shared<Scene> around = new Scene.make();
            Shared<BoxGeometry> room = new BoxGeometry.make(width: 4.0, height: 4.0, depth: 4.0);
            Shared<Mesh> walls = new Mesh.make(geometry: room, material: coloured(hex: RED));
            walls.positionMut() = Vec3.of(x: 0.0, y: 1.2, z: 3.5);
            around.add(object: walls);
            RenderInfo inside = this.renderAndRead(scene: give around);
            this.next(to: 4);
        } else if (this.stage == 4) {
            if (!this.settled()) { return false; }
            DynamicArray<uint8> frame = this.frame();
            string why = copy this.failed;
            if (why.isEmpty()) {
                isize shown = 0;
                for (isize y = 0; y < cast<isize>(HIGH); y = y + 1) {
                    for (isize x = 0; x < cast<isize>(WIDE); x = x + 1) { if (texel(frame: frame, x: x, y: y) != BACKDROP) { shown = shown + 1; } }
                }
                if (shown != 0) { why = "${shown} texels show a wall"; }
            }
            this.found.add(name: "render: a box's faces are drawn from outside only: a camera inside it sees the backdrop", why: give why);
            // a material's colour changed after its first frame is written again
            Shared<MeshBasicMaterial> red = match (this.redLook) { case Some(value: x): copy x; case None: { panic(msg: "made at the first stage"); } };
            red.colorMut() = Color.fromHex(hex: GREEN);
            Shared<Scene> s = match (this.crossing) { case Some(value: x): copy x; case None: { panic(msg: "made at the first stage"); } };
            RenderInfo recoloured = this.renderAndRead(scene: give s);
            this.next(to: 5);
        } else if (this.stage == 5) {
            if (!this.settled()) { return false; }
            DynamicArray<uint8> frame = this.frame();
            string why = this.failed.isEmpty() ? onlyColours(frame: frame, a: BACKDROP, b: GREEN, c: BLUE) : copy this.failed;
            this.found.add(name: "render: a material whose colour changed after its first frame draws in the new colour, every mesh using it",
                           why: give why);
            isize moved = this.leftmost(frame: frame);
            this.found.add(name: "render: a box moved after its first frame is drawn where it moved: the left box's edge 3 or more texels further left",
                           why: this.failed.isEmpty() && moved >= 0 && moved + 3 <= this.leftEdge ? ""
                                : "its leftmost column was ${this.leftEdge}, and is ${moved}");
            this.refusalCases();
            DeviceErrors errs = this.device.takeErrors();
            isize n = errs.reports().length();
            string firstError = n > 0 ? errs.reports()[0].message() : "";
            this.found.add(name: "render: its frames raise no WebGPU error",
                           why: errs.isEmpty() ? "" : "the channel holds ${n} error(s), the first: " + firstError);
            this.reading = Optional::None;
            this.image = Optional::None;
            this.crossing = Optional::None;
            this.left = Optional::None;
            this.redLook = Optional::None;
            this.camera = Optional::None;
            this.target = Optional::None;
            this.renderer = Optional::None;
            this.stage = 999;
        }
        return this.stage == 999;
    }

    // A camera naming no target, rendered by a renderer with no window, draws nothing and is reported (kyoten's
    // rendering.md § Decided, GFX-1's part 2, question 4): its error is the renderer's, read by `takeErrors()` and
    // printed by default. tools/test.sh counts the printed lines from outside the program: the renderer that prints
    // refuses one render here, and the one told not to print refuses 70.
    unsafe fn void refusalCases() {
        Shared<Scene> s = match (this.crossing) { case Some(value: x): copy x; case None: { panic(msg: "made at the first stage"); } };
        Shared<PerspectiveCamera> aimless = new PerspectiveCamera.make(fovRad: 1.0, near: 0.1, far: 10.0);
        aimless.toneMappingMut() = ToneMapping::None;
        Renderer told = gpuResolved(device: copy this.device, queue: copy this.queue);
        bool printsByDefault = told.printErrors();
        this.found.add(name: "Renderer: it prints the misuses it refuses by default, as @kama/gpu's device prints its errors",
                       why: printsByDefault ? "" : "printErrors() is false");
        told.render(scene: copy s, camera: copy aimless);
        RenderInfo drew = told.info();
        this.found.add(name: "render: a camera naming no target, on a renderer with no window, draws nothing",
                       why: drew.calls == 0 && drew.triangles == 0 ? "" : "calls ${drew.calls}, triangles ${drew.triangles}");
        RendererErrors taken = told.takeErrors();
        isize kept = taken.reports().length();
        string why = "";
        if (kept != 1 || taken.dropped() != 0) {
            int64 over = taken.dropped();
            why = "takeErrors handed back ${kept} report(s), ${over} dropped";
        } else {
            bool noTarget = match (taken.reports()[0].kind()) { case NoTarget: true; case _: false; };
            string words = taken.reports()[0].message();
            if (!noTarget) { why = "its kind is not NoTarget"; }
            else if (!words.contains(substring: "names no render target")) { why = "its words are: " + words; }
        }
        this.found.add(name: "render: a camera naming no target is reported once, as NoTarget, by takeErrors", why: give why);
        RendererErrors again = told.takeErrors();
        isize remaining = again.reports().length();
        this.found.add(name: "Renderer: takeErrors drains: a second call hands back nothing",
                       why: again.isEmpty() ? "" : "it handed back ${remaining} report(s)");
        Renderer quiet = gpuResolved(device: copy this.device, queue: copy this.queue);
        quiet.printErrorsMut() = false;
        bool silenced = !quiet.printErrors();
        this.found.add(name: "Renderer: printErrors reads back false once a program turns it off",
                       why: silenced ? "" : "printErrors() is still true");
        for (int32 i = 0; i < 70; i = i + 1) { quiet.render(scene: copy s, camera: copy aimless); }
        RendererErrors full = quiet.takeErrors();
        isize held = full.reports().length();
        int64 counted = full.dropped();
        this.found.add(name: "Renderer: its record keeps the oldest 64 misuses and counts the rest, as @kama/gpu's channel does",
                       why: held == 64 && counted == 6 ? "" : "it kept ${held} and counted ${counted} dropped");
        RendererErrors after = quiet.takeErrors();
        int64 stillCounted = after.dropped();
        this.found.add(name: "Renderer: takeErrors drains the count too: after a full record, the next call hands back nothing",
                       why: after.isEmpty() ? "" : "it still counts ${stillCounted} dropped");
    }

    // The leftmost column of `frame` holding anything but the backdrop, -1 when none does.
    fn isize leftmost(const ref DynamicArray<uint8> frame) {
        if (frame.length() == 0) { return -1; }
        for (isize x = 0; x < cast<isize>(WIDE); x = x + 1) {
            for (isize y = 0; y < cast<isize>(HIGH); y = y + 1) { if (texel(frame: frame, x: x, y: y) != BACKDROP) { return x; } }
        }
        return -1;
    }

    // The tree's world matrices, made by renders.
    unsafe fn void treeCases() {
        // through a parent turned a quarter turn about Y: the child's +X becomes the world's -Z
        Shared<Scene> s = new Scene.make();
        Shared<Group> parent = new Group.make();
        parent.positionMut() = Vec3.of(x: 2.0, y: 0.0, z: 0.0);
        parent.rotationMut().y = radians(deg: 90.0);
        Shared<BoxGeometry> box = new BoxGeometry.make(width: 1.0, height: 1.0, depth: 1.0);
        Shared<Mesh> child = new Mesh.make(geometry: box, material: coloured(hex: RED));
        child.positionMut() = Vec3.of(x: 1.0, y: 0.0, z: 0.0);
        parent.add(object: child);
        s.add(object: parent);
        RenderInfo placed = this.renderOnly(scene: copy s);
        Mat4 w = child.matrixWorld();
        float32 wx = w.get(c: 3, r: 0);
        float32 wy = w.get(c: 3, r: 1);
        float32 wz = w.get(c: 3, r: 2);
        this.found.add(name: "tree: a child at x 1 under a parent at x 2 turned a quarter turn about Y is at (2, 0, -1) in the world",
                       why: close(a: wx, b: 2.0) && close(a: wy, b: 0.0) && close(a: wz, b: -1.0) ? "" : "it is at (${wx} ${wy} ${wz})");
        // rotateOnWorldAxis under a parent turned a quarter turn about X: the world's Z is the parent's Y
        parent.rotationMut() = Euler.make(xRad: radians(deg: 90.0), yRad: 0.0, zRad: 0.0, order: EulerOrder::XYZ);
        RenderInfo again = this.renderOnly(scene: copy s);
        child.rotateOnWorldAxis(axis: Vec3.unitZ(), rad: 0.7);
        Quat q = child.quaternion();
        Quat want = Quat.fromAxisAngle(axis: Vec3.unitY(), rad: 0.7);
        bool turned = close(a: q.x, b: want.x) && close(a: q.y, b: want.y) && close(a: q.z, b: want.z) && close(a: q.w, b: want.w);
        this.found.add(name: "tree: rotateOnWorldAxis turns about a world axis under a turned parent (world Z is the parent's Y)",
                       why: turned ? "" : "the child's quaternion is ${q.x} ${q.y} ${q.z} ${q.w}");
        // lookAt: a camera at (5, 0, 5) looking at the origin turns its -Z there, 45 degrees about Y
        Shared<PerspectiveCamera> eye = new PerspectiveCamera.make(fovRad: 1.0, near: 0.1, far: 10.0);
        eye.toneMappingMut() = ToneMapping::None;
        eye.positionMut() = Vec3.of(x: 5.0, y: 0.0, z: 5.0);
        eye.lookAt(target: Vec3.zero());
        Euler looked = eye.rotation();
        this.found.add(name: "tree: lookAt turns a camera at (5, 0, 5) to look at the origin down its -Z, 45 degrees about Y",
                       why: close(a: looked.x, b: 0.0) && close(a: looked.y, b: radians(deg: 45.0)) && close(a: looked.z, b: 0.0) ? ""
                            : "its rotation is ${looked.x} ${looked.y} ${looked.z}");
        // lookAt under a parent turned 60 degrees about Y: facing the world's -Z (a half turn) is 120 degrees in the parent.
        // Angles away from a quarter turn about the middle axis, where reading an Euler back is ill-conditioned.
        Shared<Group> quarter = new Group.make();
        quarter.rotationMut().y = radians(deg: 60.0);
        Shared<Group> looker = new Group.make();
        quarter.add(object: looker);
        s.add(object: quarter);
        RenderInfo third = this.renderOnly(scene: copy s);
        looker.lookAt(target: Vec3.of(x: 0.0, y: 0.0, z: -5.0));
        Euler facing = looker.rotation();
        this.found.add(name: "tree: lookAt under a turned parent turns the node in its parent's frame (facing the world's -Z under 60 degrees is 120)",
                       why: close(a: facing.x, b: 0.0) && close(a: facing.y, b: radians(deg: 120.0)) && close(a: facing.z, b: 0.0) ? ""
                            : "its rotation is ${facing.x} ${facing.y} ${facing.z}");
        s.remove(object: quarter);
        // a mesh that leaves its scene gives up its record
        s.remove(object: parent);
        RenderInfo emptied = this.renderOnly(scene: copy s);
        this.found.add(name: "flat-core: a mesh removed from its scene gives up its record and is no longer drawn",
                       why: infoIs(got: emptied, calls: 0, triangles: 0, objects: 0, matrices: 0));
    }
}
