// GFX-1's part 5, step 1: pipelines compiled off the frame (kyoten's rendering.md § Decided, GFX-1's part 5, question 1,
// the owner's (A) of 2026-11-18). A step a tick on the device the check opened, each case on a renderer of its own, so
// nothing one case compiled is found ready by the next. Every scene is a red unlit box ahead of the camera, drawn into a
// 16 x 12 8-bit target with no tone mapping, so a texel reads the box's red, or the clear colour:
// - **the default way is `General`,** which skips a draw while its material has no general form ready (none has one
//   until step 2), and a render never waits;
// - **a new scene drawn at once by the default:** the box is skipped, and the output pass left out, so a target cleared
//   to #336699 still shows it; `info()` counts 3 misses (the box, the tone-mapped resolve and the output) and the box
//   skipped. Drawn again each tick, it shows the box once its pipelines answer, with no miss;
// - **`Skip`,** set: the same first render;
// - **`Wait`:** the first render draws the box, `info()` counting the 4 pipelines it compiled (the box's two, the resolve
//   and the output) and no miss; the next render compiles none;
// - **`compile(scene:, camera:)`:** polled until `Ready`, then one render draws everything, with no miss; polled again,
//   it stays `Ready`;
// - **a pipeline the device refuses:** a material passing 40 values from its vertex stage to its fragment stage, where a
//   device takes 16 (WebGPU's `maxInterStageShaderVariables`), so its WGSL is valid and its pipeline is refused. Compiled
//   beside a box that draws: the request answers, the other box draws, and the refusal is reported once, as `Material`,
//   in the device's words, by `takeErrors()` before any render. It is never a miss, so a program waiting for none is not
//   held;
// - **the tone-mapped resolve while it compiles:** a scene compiled at `Msaa4` and drawn at `Msaa4ToneMapped` is resolved
//   by the GPU for that render, one miss, the box drawn; once the resolve answers, no miss;
// - **a method set back compiles nothing:** `Msaa4` again draws at once, with no miss;
// - **a render never draws with a pipeline it asked for itself:** twelve boxes, by turns of two materials, share two
//   pipeline pairs, each asked for by its first box's draw; a new scene's first render skips all twelve, though natively
//   @kama/gpu's threads may answer before a later box's draw; under `General` nor by a general form;
// - **a refusal a render found, reported by `takeErrors()` alone:** the two boxes rendered once, then `takeErrors()`
//   polled each tick with no render, which polls the requests, reports it once;
// - **a refusal a render finds itself:** the two boxes drawn with no compile, each tick until no miss, by a renderer that
//   prints and never reads `takeErrors()`, as such a program keeps it: the render that finds the refusal prints it,
//   once, which only the run's output shows, so tools/test.sh counts the line.

import {
    std::collections::DynamicArray,
    std::math::Vec3, std::math::radians,
    std::time::Instant, std::time::monotonicNow,
    image::Image,
    gpu::Device, gpu::Queue, gpu::GpuError,
    graphics::Color, graphics::Renderer, graphics::RenderInfo, graphics::RenderTarget, graphics::Scene, graphics::Mesh,
    graphics::PerspectiveCamera, graphics::BoxGeometry, graphics::Material, graphics::MaterialGpu, graphics::MaterialSettings,
    graphics::NodeBuilder, graphics::MeshBasicMaterial, graphics::MeshStandardMaterial, graphics::PixelRead, graphics::PixelStatus, graphics::ToneMapping,
    graphics::Antialiasing, graphics::WhileCompiling, graphics::CompileRequest, graphics::CompileStatus,
    graphics::GraphicsErrorKind, graphics::RendererErrors, graphics::FloatNode, graphics::vec3, graphics::vec4,
    graphics::constant, graphics::varying,
    Verdicts,
};
export { CompilingRun };

comptime uint32 WIDE = 16;
comptime uint32 HIGH = 12;
comptime int64 PATIENCE_MS = 10000;   // how long a case waits for pipelines, or a read, before it fails

// A program's own material passing 40 values from its vertex stage to its fragment stage, each a varying of its own,
// where a device takes 16: its WGSL is valid, and the device refuses its pipeline.
type resource Overflowing implements Material {
    MaterialGpu cache;
    public ctor make() { this.cache = MaterialGpu.make(); }
    public fn ref MaterialGpu gpuMut() { return this.cache; }
    public const fn uint32 version() { return 0; }
    public const fn uint32 graphVersion() { return 0; }
    public const fn void settings(ref MaterialSettings into) { into.addFloat(name: "k", value: 1.0); }
    public fn void shade(ref NodeBuilder builder) {
        FloatNode sum = builder.uniformFloat(name: "k");
        for (int32 i = 1; i <= 40; i = i + 1) { sum = sum + varying(value: constant(value: cast<float32>(i))); }
        builder.fragmentColor(node: vec4(xyz: vec3(x: sum, y: sum, z: sum), w: constant(value: 1.0)));
    }
}

// What `info()` said, held to the counts a case wants: "" when it says them.
fn string infoIs(RenderInfo got, int32 misses, int32 skipped, int32 waited, int32 calls) {
    if (got.misses == misses && got.skipped == skipped && got.waited == waited && got.calls == calls) { return ""; }
    int32 m = got.misses;
    int32 s = got.skipped;
    int32 w = got.waited;
    int32 c = got.calls;
    return "it says ${m} misses, ${s} skipped, ${w} waited and ${c} calls";
}

type resource CompilingRun {
    int32 stage = 0;
    Instant began = monotonicNow();
    Verdicts found;
    Device device;
    Queue queue;
    Optional<Renderer> renderer = Optional::None;
    Optional<Shared<Scene>> scene = Optional::None;
    Optional<Shared<PerspectiveCamera>> camera = Optional::None;
    Optional<Shared<RenderTarget>> target = Optional::None;
    Optional<CompileRequest> compiling = Optional::None;
    Optional<PixelRead> reading = Optional::None;
    Optional<Image> got = Optional::None;
    bool failed = false;

    public ctor make(Device device, Queue queue) {
        this.found = Verdicts.make();
        this.device = give device;
        this.queue = give queue;
    }

    public fn ref Verdicts verdicts() { return this.found; }

    // A renderer of its own, drawing `way`, its errors read here rather than printed.
    unsafe fn void fresh(WhileCompiling way) {
        Renderer r = Renderer.withDevice(device: copy this.device, queue: copy this.queue);
        r.whileCompilingMut() = way;
        r.printErrorsMut() = false;
        this.renderer = Optional::Some(value: give r);
    }

    // A new 16 x 12 8-bit target and a camera into it with no tone mapping, and a scene: a red unlit box 2 metres ahead,
    // or, `two`, a red one to the left and one of `Overflowing` to the right.
    unsafe fn void stageScene(bool two) {
        Shared<RenderTarget> t = new RenderTarget.make(width: WIDE, height: HIGH);
        Shared<PerspectiveCamera> cam = new PerspectiveCamera.make(fovRad: radians(deg: 50.0), aspect: 16.0 / 12.0, near: 0.1, far: 100.0);
        cam.targetMut() = Optional::Some(value: copy t);
        cam.toneMappingMut() = ToneMapping::None;
        Shared<Scene> s = new Scene.make();
        Shared<MeshBasicMaterial> red = new MeshBasicMaterial.make();
        red.colorMut() = Color.fromHex(hex: 0xff0000);
        if (two) {
            Shared<BoxGeometry> small = new BoxGeometry.make(width: 0.5, height: 0.5, depth: 0.5);
            Shared<Overflowing> refused = new Overflowing.make();
            Shared<Mesh> left = new Mesh.make(geometry: copy small, material: red);
            left.positionMut() = Vec3.of(x: -0.55, y: 0.0, z: -2.0);
            Shared<Mesh> right = new Mesh.make(geometry: small, material: refused);
            right.positionMut() = Vec3.of(x: 0.55, y: 0.0, z: -2.0);
            s.add(object: left);
            s.add(object: right);
        } else {
            Shared<BoxGeometry> box = new BoxGeometry.make(width: 1.0, height: 1.0, depth: 1.0);
            Shared<Mesh> m = new Mesh.make(geometry: box, material: red);
            m.positionMut() = Vec3.of(x: 0.0, y: 0.0, z: -2.0);
            s.add(object: m);
        }
        this.target = Optional::Some(value: give t);
        this.camera = Optional::Some(value: give cam);
        this.scene = Optional::Some(value: give s);
    }

    // A new 16 x 12 target and camera, and a scene of twelve boxes in a grid ahead of the camera, each a geometry of its
    // own, by turns a red unlit material and a standard one: two pipeline pairs draw them all, so between two draws that
    // share a pair the other's shader module is made, time a pipeline asked for by the first draw may answer in.
    unsafe fn void stageMany() {
        this.stageScene(two: false);
        Shared<Scene> s = new Scene.make();
        Shared<MeshBasicMaterial> red = new MeshBasicMaterial.make();
        red.colorMut() = Color.fromHex(hex: 0xff0000);
        Shared<MeshStandardMaterial> lit = new MeshStandardMaterial.make();
        for (int32 i = 0; i < 12; i = i + 1) {
            Shared<BoxGeometry> box = new BoxGeometry.make(width: 0.2, height: 0.2, depth: 0.2);
            Vec3 at = Vec3.of(x: cast<float32>(i % 4) * 0.4 - 0.6, y: cast<float32>(i / 4) * 0.4 - 0.4, z: -3.0);
            if (i % 2 == 0) {
                Shared<Mesh> m = new Mesh.make(geometry: box, material: copy red);
                m.positionMut() = at;
                s.add(object: m);
            } else {
                Shared<Mesh> m = new Mesh.make(geometry: box, material: copy lit);
                m.positionMut() = at;
                s.add(object: m);
            }
        }
        this.scene = Optional::Some(value: give s);
    }

    unsafe fn Shared<Scene> theScene() { return match (this.scene) { case Some(value: s): copy s; case None: { panic(msg: "staged first"); } }; }
    unsafe fn Shared<PerspectiveCamera> theCamera() { return match (this.camera) { case Some(value: c): copy c; case None: { panic(msg: "staged first"); } }; }
    unsafe fn Shared<RenderTarget> theTarget() { return match (this.target) { case Some(value: t): copy t; case None: { panic(msg: "staged first"); } }; }

    // The scene drawn once by the run's renderer; what `info()` then says.
    unsafe fn RenderInfo renderNow() {
        Shared<Scene> s = this.theScene();
        Shared<PerspectiveCamera> c = this.theCamera();
        RenderInfo said = RenderInfo.of(calls: -1, triangles: -1, objects: -1, matrices: -1, misses: -1, skipped: -1, general: -1, standIn: -1, waited: -1);
        match (this.renderer) {
            case Some(value: r): { r.render(scene: s, camera: c); said = r.info(); }
            case None: { }
        };
        return said;
    }

    // The target read back, its read started now.
    unsafe fn void startRead() {
        Shared<RenderTarget> t = this.theTarget();
        match (this.renderer) {
            case Some(value: r): { this.reading = Optional::Some(value: r.readRenderTargetPixels(target: t)); }
            case None: { }
        };
        this.began = monotonicNow();
    }

    // Whether the read has answered: its image kept in `got`, or `failed` set. False while it is pending.
    unsafe fn bool answered() {
        PixelStatus s = match (this.reading) {
            case Some(value: r): r.poll();
            case None: PixelStatus::Failed(error: GpuError::Taken);
        };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (pending && this.began.elapsed().asMillis() < PATIENCE_MS) { return false; }
        this.reading = Optional::None;
        this.failed = true;
        this.got = Optional::None;
        match (give s) {
            case Ready(image: img): { this.failed = false; this.got = Optional::Some(value: give img); }
            case _: { }
        };
        return true;
    }

    // "" when texel (x, y) of the read shows `r g b`, each within a step, opaque.
    fn string shows(isize x, isize y, int32 r, int32 g, int32 b) {
        if (this.failed) { return "the read failed"; }
        isize at = (y * cast<isize>(WIDE) + x) * 4;
        string said = "no image";
        match (this.got) {
            case Some(value: img): {
                int32 gr = cast<int32>(img.samples8()[at]);
                int32 gg = cast<int32>(img.samples8()[at + 1]);
                int32 gb = cast<int32>(img.samples8()[at + 2]);
                int32 ga = cast<int32>(img.samples8()[at + 3]);
                bool near = gr - r <= 1 && r - gr <= 1 && gg - g <= 1 && g - gg <= 1 && gb - b <= 1 && b - gb <= 1 && ga == 255;
                said = near ? "" : "texel (${x}, ${y}) shows ${gr} ${gg} ${gb} ${ga}";
            }
            case None: { }
        };
        return said;
    }

    // "" when every texel of the read shows `r g b`.
    fn string everywhere(int32 r, int32 g, int32 b) {
        for (isize y = 0; y < cast<isize>(HIGH); y = y + 1) {
            for (isize x = 0; x < cast<isize>(WIDE); x = x + 1) {
                string one = this.shows(x: x, y: y, r: r, g: g, b: b);
                if (!one.isEmpty()) { return one; }
            }
        }
        return "";
    }

    // The compile request polled: 1 when it is ready, 0 while it is pending, -1 when it is still pending past patience.
    unsafe fn int32 compiled() {
        CompileStatus s = match (this.compiling) { case Some(value: q): q.poll(); case None: CompileStatus::Ready; };
        bool ready = match (s) { case Ready: true; case Pending: false; };
        if (ready) { return 1; }
        return this.began.elapsed().asMillis() < PATIENCE_MS ? 0 : -1;
    }

    // The scene's pipelines asked for by the run's renderer, the request kept to poll.
    unsafe fn void startCompile() {
        Shared<Scene> s = this.theScene();
        Shared<PerspectiveCamera> c = this.theCamera();
        match (this.renderer) {
            case Some(value: r): { this.compiling = Optional::Some(value: r.compile(scene: s, camera: c)); }
            case None: { }
        };
        this.began = monotonicNow();
    }

    unsafe fn void choose(Antialiasing method) {
        match (this.renderer) { case Some(value: r): { r.antialiasingMut() = method; } case None: { } };
    }

    // The renderer's errors drained: "" when they are one `Material` report in the device's words, saying the stages'
    // interface is what was refused, or, `none`, none. Each leg says it its own way: wgpu-native names the limit
    // (`max_inter_stage_shader_variables`), Dawn each location past it (`has a location (16) that is too large`), and
    // Firefox only the first line of wgpu's error, matching a stage's requirements against the pipeline.
    unsafe fn string errorsAre(bool none) {
        RendererErrors e = match (this.renderer) { case Some(value: r): r.takeErrors(); case None: { panic(msg: "made first"); } };
        isize n = e.reports().length();
        if (none) { return n == 0 && e.dropped() == 0 ? "" : "it reports ${n}"; }
        if (n != 1) { return "it reports ${n}"; }
        bool material = match (e.reports()[0].kind()) { case Material: true; case _: false; };
        string words = e.reports()[0].message();
        if (!material) { return "it is not Material: " + words; }
        bool named = words.contains(substring: "inter_stage_shader_variables") || words.contains(substring: "has a location (16) that is too large")
            || words.contains(substring: "shader requirements against the pipeline");
        return words.startsWith(prefix: "a material's pipeline was refused by the device, so nothing draws with it: ") && named ? ""
            : "its words are: " + words;
    }

    public unsafe fn bool step() {
        if (this.stage == 0) {
            this.fresh(way: WhileCompiling::General);
            bool general = match (this.renderer) { case Some(value: r): r.whileCompiling() == WhileCompiling::General; case None: false; };
            this.found.add(name: "compiling: a renderer's way while a pipeline compiles is General by default", why: general ? "" : "it is another");
            this.stageScene(two: false);
            Shared<RenderTarget> t = this.theTarget();
            match (this.renderer) {
                case Some(value: r): { r.clearColorMut() = Color.fromHex(hex: 0x336699); r.clear(target: t); r.clearColorMut() = Color.fromHex(hex: 0x000000); }
                case None: { }
            };
            RenderInfo first = this.renderNow();
            this.found.add(name: "compiling, the default: a new scene's first render draws nothing, counting the box skipped and 3 misses (the box, the resolve, the output)",
                           why: infoIs(got: first, misses: 3, skipped: 1, waited: 0, calls: 0));
            this.startRead();
            this.stage = 1;
            return false;
        }
        if (this.stage == 1) {
            if (!this.answered()) { return false; }
            this.found.add(name: "compiling, the default: while the output pass compiles, the target is left as it was, cleared to #336699",
                           why: this.everywhere(r: 0x33, g: 0x66, b: 0x99));
            this.began = monotonicNow();
            this.stage = 2;
            return false;
        }
        if (this.stage == 2) {
            RenderInfo again = this.renderNow();
            if (again.misses != 0 && this.began.elapsed().asMillis() < PATIENCE_MS) { return false; }
            this.found.add(name: "compiling, the default: drawn again each tick, a render with no miss comes, drawing the box's two passes",
                           why: infoIs(got: again, misses: 0, skipped: 0, waited: 0, calls: 2));
            this.startRead();
            this.stage = 3;
            return false;
        }
        if (this.stage == 3) {
            if (!this.answered()) { return false; }
            string centre = this.shows(x: 8, y: 6, r: 255, g: 0, b: 0);
            string corner = this.shows(x: 0, y: 0, r: 0, g: 0, b: 0);
            this.found.add(name: "compiling, the default: once its pipelines answer, the box is drawn on the clear colour", why: centre + corner);
            this.fresh(way: WhileCompiling::Skip);
            this.stageScene(two: false);
            RenderInfo skipping = this.renderNow();
            this.found.add(name: "compiling, Skip: a new scene's first render draws nothing, counting the box skipped and 3 misses",
                           why: infoIs(got: skipping, misses: 3, skipped: 1, waited: 0, calls: 0));
            this.fresh(way: WhileCompiling::Wait);
            this.stageScene(two: false);
            RenderInfo waited = this.renderNow();
            this.found.add(name: "compiling, Wait: the first render compiles its 4 pipelines (the box's two, the resolve, the output) and draws the box, with no miss",
                           why: infoIs(got: waited, misses: 0, skipped: 0, waited: 4, calls: 2));
            this.startRead();
            this.stage = 4;
            return false;
        }
        if (this.stage == 4) {
            if (!this.answered()) { return false; }
            this.found.add(name: "compiling, Wait: the first render shows the box", why: this.shows(x: 8, y: 6, r: 255, g: 0, b: 0));
            RenderInfo second = this.renderNow();
            this.found.add(name: "compiling, Wait: the next render compiles nothing", why: infoIs(got: second, misses: 0, skipped: 0, waited: 0, calls: 2));
            this.fresh(way: WhileCompiling::General);
            this.stageScene(two: false);
            this.startCompile();
            this.stage = 5;
            return false;
        }
        if (this.stage == 5) {
            int32 c = this.compiled();
            if (c == 0) { return false; }
            this.found.add(name: "compiling, compile(scene:, camera:): its request comes to Ready", why: c == 1 ? "" : "it is still pending");
            RenderInfo after = this.renderNow();
            this.found.add(name: "compiling, compile(scene:, camera:): the first render after it draws everything, with no miss",
                           why: infoIs(got: after, misses: 0, skipped: 0, waited: 0, calls: 2));
            this.found.add(name: "compiling, compile(scene:, camera:): polled again, its request stays Ready", why: this.compiled() == 1 ? "" : "it is not");
            this.startRead();
            this.stage = 6;
            return false;
        }
        if (this.stage == 6) {
            if (!this.answered()) { return false; }
            this.found.add(name: "compiling, compile(scene:, camera:): that render shows the box", why: this.shows(x: 8, y: 6, r: 255, g: 0, b: 0));
            this.fresh(way: WhileCompiling::General);
            this.stageScene(two: true);
            this.startCompile();
            this.stage = 7;
            return false;
        }
        if (this.stage == 7) {
            int32 c = this.compiled();
            if (c == 0) { return false; }
            this.found.add(name: "compiling, a pipeline the device refuses: the request comes to Ready, the refusal an answer", why: c == 1 ? "" : "it is still pending");
            this.found.add(name: "compiling, a pipeline the device refuses: takeErrors() reports it once the request answers, before any render, as Material, in the device's words, the stages' interface refused",
                           why: this.errorsAre(none: false));
            RenderInfo beside = this.renderNow();
            this.found.add(name: "compiling, a pipeline the device refuses: the box beside it draws, and the refused one is no miss",
                           why: infoIs(got: beside, misses: 0, skipped: 0, waited: 0, calls: 2));
            this.startRead();
            this.stage = 8;
            return false;
        }
        if (this.stage == 8) {
            if (!this.answered()) { return false; }
            string left = this.shows(x: 3, y: 6, r: 255, g: 0, b: 0);
            string right = this.shows(x: 12, y: 6, r: 0, g: 0, b: 0);
            this.found.add(name: "compiling, a pipeline the device refuses: the box beside it is drawn, and where the refused one stands the clear colour shows",
                           why: left + right);
            RenderInfo next = this.renderNow();
            this.found.add(name: "compiling, a pipeline the device refuses: the next render draws the same, and reports nothing again",
                           why: infoIs(got: next, misses: 0, skipped: 0, waited: 0, calls: 2) + this.errorsAre(none: true));
            this.fresh(way: WhileCompiling::General);
            this.choose(method: Antialiasing::Msaa4);
            this.stageScene(two: false);
            this.startCompile();
            this.stage = 9;
            return false;
        }
        if (this.stage == 9) {
            int32 c = this.compiled();
            if (c == 0) { return false; }
            this.choose(method: Antialiasing::Msaa4ToneMapped);
            RenderInfo resolving = this.renderNow();
            this.found.add(name: "compiling, the tone-mapped resolve while it compiles: compiled at Msaa4, drawn at Msaa4ToneMapped, the GPU resolves that render, one miss",
                           why: (c == 1 ? "" : "the compile never answered; ") + infoIs(got: resolving, misses: 1, skipped: 0, waited: 0, calls: 2));
            this.startRead();
            this.stage = 10;
            return false;
        }
        if (this.stage == 10) {
            if (!this.answered()) { return false; }
            this.found.add(name: "compiling, the tone-mapped resolve while it compiles: that render shows the box", why: this.shows(x: 8, y: 6, r: 255, g: 0, b: 0));
            this.began = monotonicNow();
            this.stage = 11;
            return false;
        }
        if (this.stage == 11) {
            RenderInfo again = this.renderNow();
            if (again.misses != 0 && this.began.elapsed().asMillis() < PATIENCE_MS) { return false; }
            this.found.add(name: "compiling, the tone-mapped resolve while it compiles: drawn again each tick, a render with no miss comes",
                           why: infoIs(got: again, misses: 0, skipped: 0, waited: 0, calls: 2));
            this.choose(method: Antialiasing::Msaa4);
            RenderInfo back = this.renderNow();
            this.found.add(name: "compiling: a method set back draws at once, its pipelines kept, with no miss",
                           why: infoIs(got: back, misses: 0, skipped: 0, waited: 0, calls: 2));
            // a renderer that prints, as a program that never reads takeErrors() keeps it: the render that finds the
            // refusal prints it, once, which the gate counts (tools/test.sh)
            this.fresh(way: WhileCompiling::General);
            match (this.renderer) { case Some(value: r): { r.printErrorsMut() = true; } case None: { } };
            this.stageScene(two: true);
            this.began = monotonicNow();
            this.stage = 12;
            return false;
        }
        if (this.stage == 12) {
            RenderInfo again = this.renderNow();
            if (again.misses != 0 && this.began.elapsed().asMillis() < PATIENCE_MS) { return false; }
            this.found.add(name: "compiling, a pipeline the device refuses, found by a render: drawn again each tick, a render with no miss comes, the box beside it drawn",
                           why: infoIs(got: again, misses: 0, skipped: 0, waited: 0, calls: 2));
            // a render never draws with a pipeline it asked for itself: a box's draw asks for the pipelines the boxes of its
            // material share, and natively @kama/gpu's own threads may answer before a later box's draw, which must not
            // take them (found in part 5's step 2); under General, nor its material's general form
            this.fresh(way: WhileCompiling::Skip);
            this.stageMany();
            RenderInfo many = this.renderNow();
            this.found.add(name: "compiling: a render never draws with a pipeline it asked for itself, so twelve boxes, by turns of two materials, are all skipped by a new scene's first render (and the resolve and the output)",
                           why: infoIs(got: many, misses: 14, skipped: 12, waited: 0, calls: 0));
            this.fresh(way: WhileCompiling::General);
            this.stageMany();
            RenderInfo general = this.renderNow();
            this.found.add(name: "compiling, General: a render never draws by a general form it asked for itself, so the twelve boxes are all skipped by a new scene's first render",
                           why: infoIs(got: general, misses: 14, skipped: 12, waited: 0, calls: 0));
            // a refusal a render found is reported by takeErrors() alone, with no render after it: it polls the requests
            this.fresh(way: WhileCompiling::General);
            this.stageScene(two: true);
            RenderInfo once = this.renderNow();
            this.began = monotonicNow();
            this.stage = 13;
            return false;
        }
        if (this.stage == 13) {
            RendererErrors e = match (this.renderer) { case Some(value: r): r.takeErrors(); case None: { panic(msg: "made first"); } };
            isize n = e.reports().length();
            if (n == 0 && this.began.elapsed().asMillis() < PATIENCE_MS) { return false; }
            bool isMaterial = n == 1 && match (e.reports()[0].kind()) { case Material: true; case _: false; };
            this.found.add(name: "compiling, a pipeline the device refuses, asked for by one render: takeErrors() polled alone, with no render after it, reports it once, as Material",
                           why: isMaterial ? "" : "it reports ${n}");
            this.renderer = Optional::None;
            this.stage = 14;
        }
        return true;
    }
}
