// Typed nodes, what a material's shader is written in (kyoten's rendering.md § Decided, GFX-1's question 2; part 3's
// question): one node type per WGSL type, operators by operand type, functions with named arguments, and a public node
// contract a program's own node types implement, so the library's nodes and a program's are checked alike. A node is a
// reference, as TSL's are: handing one on shares it (`Copyable<This>(bare: copy)` over a shared expression), so a node
// used twice is one expression, which the compiler writes once as a `let` (node_builder.kama).
//
// The library's own shader functions are typed nodes too (`ShaderFunction`, as TSL's `Fn(…).setLayout(…)`): a kama
// function whose body is built from its parameters, written into a material's WGSL once where the material reaches it.

import { std::collections::DynamicArray, std::memory::Shared };
export {
    Node, Expr, ExprKind, FloatNode, Vec2Node, Vec3Node, Vec4Node, Mat3Node, Mat4Node, ShaderFunction, param, called,
    constant, vec2, vec3, vec4, dfg, dot, normalize, max, min, mix, saturate, sqrt, exp2, pow, varying,
    positionLocal, normalLocal, modelWorldMatrix, modelNormalMatrix, cameraViewProjectionMatrix, cameraPosition, normalWorld,
    positionWorld,
    ReflectedLight, LightingModel, lit,
};

// What a node computes:
// - `Number`, a float32 constant; `Call`, a WGSL built-in function or constructor; `Binary` and `Unary`, an operator;
//   `Member`, a swizzle; `FnCall`, a call of a typed function;
// - `Name`, a value any stage or function reads by name: a material's setting, the frame;
// - `VertexName`, one only the vertex stage has: its object's record;
// - `Attribute`, a vertex input, which the fragment stage reads through a varying;
// - `Param`, a typed function's parameter, read only inside it;
// - `Varying`, a vertex stage's value the fragment stage reads;
// - `Sample`, a texture the renderer binds, sampled at its argument, a vec2f, in the fragment stage alone (WGSL's
//   `textureSample`): its text names the texture, whose sampler is the texture's name and `_sampler`;
// - `Light`, one directional light's value, its text the member (`direction`, `color`), read only inside a `LightSum`;
// - `LightSum`, its argument summed over the scene's directional lights: the loop a lighting model's `direct` is written
//   in (lighting.kama).
type enum ExprKind { Number, Name, VertexName, Attribute, Param, Call, Binary, Unary, Member, FnCall, Varying, Sample, Light, LightSum }

// One node of the graph: what it computes, its WGSL type and its arguments, each shared, so one subexpression can feed
// several nodes.
type resource Expr {
    ExprKind kind;
    string text;
    string typed;
    float32 amount;
    DynamicArray<Shared<Expr>> args;
    Optional<Shared<ShaderFunction>> callee = Optional::None;

    public ctor make(ExprKind kind, string text, string wgslType, float32 amount) {
        this.kind = kind; this.text = give text; this.typed = give wgslType; this.amount = amount;
        this.args = DynamicArray.empty();
    }
    fn void arg(Shared<Expr> e) { this.args.add(item: give e); }
    fn void calls(Shared<ShaderFunction> f) { this.callee = Optional::Some(value: give f); }
    public const fn ExprKind exprKind() { return this.kind; }
    public const fn string name() { return copy this.text; }
    public const fn string wgslType() { return copy this.typed; }
    public const fn float32 number() { return this.amount; }
    public const fn isize argCount() { return this.args.length(); }
    public const fn Shared<Expr> argAt(isize i) { return copy this.args[i]; }
    public const fn Optional<Shared<ShaderFunction>> calledFunction() { return copy this.callee; }

    friend withArgs[arg];
    friend called[arg, calls];
}

fn Shared<Expr> exprOf(ExprKind kind, string text, string wgslType) {
    Shared<Expr> e = new Expr.make(kind: kind, text: give text, wgslType: give wgslType, amount: 0.0);
    return e;
}
fn Shared<Expr> numberExpr(float32 v) {
    Shared<Expr> e = new Expr.make(kind: ExprKind::Number, text: "", wgslType: "f32", amount: v);
    return e;
}
// `e` with `args` as its arguments, in order.
fn Shared<Expr> withArgs(Shared<Expr> e, Shared<Expr> a, Optional<Shared<Expr>> b, Optional<Shared<Expr>> c) {
    e.arg(e: give a);
    match (give b) { case Some(value: x): { e.arg(e: give x); } case None: { } };
    match (give c) { case Some(value: x): { e.arg(e: give x); } case None: { } };
    return e;
}
fn Shared<Expr> binary(string op, string wgslType, Shared<Expr> a, Shared<Expr> b) {
    return withArgs(e: exprOf(kind: ExprKind::Binary, text: give op, wgslType: give wgslType), a: give a,
                    b: Optional::Some(value: give b), c: Optional::None);
}
fn Shared<Expr> unary(string op, string wgslType, Shared<Expr> a) {
    return withArgs(e: exprOf(kind: ExprKind::Unary, text: give op, wgslType: give wgslType), a: give a, b: Optional::None,
                    c: Optional::None);
}
fn Shared<Expr> call1(string name, string wgslType, Shared<Expr> a) {
    return withArgs(e: exprOf(kind: ExprKind::Call, text: give name, wgslType: give wgslType), a: give a, b: Optional::None,
                    c: Optional::None);
}
fn Shared<Expr> call2(string name, string wgslType, Shared<Expr> a, Shared<Expr> b) {
    return withArgs(e: exprOf(kind: ExprKind::Call, text: give name, wgslType: give wgslType), a: give a,
                    b: Optional::Some(value: give b), c: Optional::None);
}
fn Shared<Expr> call3(string name, string wgslType, Shared<Expr> a, Shared<Expr> b, Shared<Expr> c) {
    return withArgs(e: exprOf(kind: ExprKind::Call, text: give name, wgslType: give wgslType), a: give a,
                    b: Optional::Some(value: give b), c: Optional::Some(value: give c));
}
fn Shared<Expr> member(string name, string wgslType, Shared<Expr> of) {
    return withArgs(e: exprOf(kind: ExprKind::Member, text: give name, wgslType: give wgslType), a: give of, b: Optional::None,
                    c: Optional::None);
}

// What every node is, the library's types and a program's own alike: its expression, its WGSL type, and a node of the
// same type over another expression, which is how a function generic over nodes makes its result.
type contract Node<T is This> for resource {
    fn Shared<Expr> expr();
    const fn string wgslType();
    fn T over(Shared<Expr> e);
}

// WGSL's f32. A number goes on either side of an operator, as in WGSL (`0.5 * x`, `x + 1.0`).
type resource FloatNode implements Copyable<This>(bare: copy), Node<This> {
    Shared<Expr> e;
    public ctor of(Shared<Expr> e) { this.e = give e; }
    public ctor copy(ref FloatNode source) { this.e = copy source.e; }
    public fn Shared<Expr> expr() { return copy this.e; }
    public const fn string wgslType() { return "f32"; }
    public fn FloatNode over(Shared<Expr> e) { return FloatNode.of(e: give e); }

    public FloatNode operator+(FloatNode rhs) { return FloatNode.of(e: binary(op: "+", wgslType: "f32", a: this.expr(), b: rhs.expr())); }
    public FloatNode operator-(FloatNode rhs) { return FloatNode.of(e: binary(op: "-", wgslType: "f32", a: this.expr(), b: rhs.expr())); }
    public FloatNode operator*(FloatNode rhs) { return FloatNode.of(e: binary(op: "*", wgslType: "f32", a: this.expr(), b: rhs.expr())); }
    public FloatNode operator/(FloatNode rhs) { return FloatNode.of(e: binary(op: "/", wgslType: "f32", a: this.expr(), b: rhs.expr())); }
    public FloatNode operator+(float32 s) { return FloatNode.of(e: binary(op: "+", wgslType: "f32", a: this.expr(), b: numberExpr(v: s))); }
    public FloatNode operator-(float32 s) { return FloatNode.of(e: binary(op: "-", wgslType: "f32", a: this.expr(), b: numberExpr(v: s))); }
    public FloatNode operator*(float32 s) { return FloatNode.of(e: binary(op: "*", wgslType: "f32", a: this.expr(), b: numberExpr(v: s))); }
    public FloatNode operator/(float32 s) { return FloatNode.of(e: binary(op: "/", wgslType: "f32", a: this.expr(), b: numberExpr(v: s))); }
    public FloatNode operator+(float32 s, FloatNode v) { return FloatNode.of(e: binary(op: "+", wgslType: "f32", a: numberExpr(v: s), b: v.expr())); }
    public FloatNode operator-(float32 s, FloatNode v) { return FloatNode.of(e: binary(op: "-", wgslType: "f32", a: numberExpr(v: s), b: v.expr())); }
    public FloatNode operator*(float32 s, FloatNode v) { return FloatNode.of(e: binary(op: "*", wgslType: "f32", a: numberExpr(v: s), b: v.expr())); }
    public FloatNode operator/(float32 s, FloatNode v) { return FloatNode.of(e: binary(op: "/", wgslType: "f32", a: numberExpr(v: s), b: v.expr())); }
    public FloatNode operator-() { return FloatNode.of(e: unary(op: "-", wgslType: "f32", a: this.expr())); }
    // a float times a vector is a vector, as in WGSL
    public Vec3Node operator*(Vec3Node rhs) { return Vec3Node.of(e: binary(op: "*", wgslType: "vec3f", a: this.expr(), b: rhs.expr())); }
}

// WGSL's vec2f: a texture coordinate, or two numbers read together, as a table's texel.
type resource Vec2Node implements Copyable<This>(bare: copy), Node<This> {
    Shared<Expr> e;
    public ctor of(Shared<Expr> e) { this.e = give e; }
    public ctor copy(ref Vec2Node source) { this.e = copy source.e; }
    public fn Shared<Expr> expr() { return copy this.e; }
    public const fn string wgslType() { return "vec2f"; }
    public fn Vec2Node over(Shared<Expr> e) { return Vec2Node.of(e: give e); }

    public Vec2Node operator+(Vec2Node rhs) { return Vec2Node.of(e: binary(op: "+", wgslType: "vec2f", a: this.expr(), b: rhs.expr())); }
    public Vec2Node operator-(Vec2Node rhs) { return Vec2Node.of(e: binary(op: "-", wgslType: "vec2f", a: this.expr(), b: rhs.expr())); }
    public Vec2Node operator*(Vec2Node rhs) { return Vec2Node.of(e: binary(op: "*", wgslType: "vec2f", a: this.expr(), b: rhs.expr())); }
    public Vec2Node operator*(FloatNode rhs) { return Vec2Node.of(e: binary(op: "*", wgslType: "vec2f", a: this.expr(), b: rhs.expr())); }
    public Vec2Node operator*(float32 s) { return Vec2Node.of(e: binary(op: "*", wgslType: "vec2f", a: this.expr(), b: numberExpr(v: s))); }
    public fn FloatNode x() { return FloatNode.of(e: member(name: "x", wgslType: "f32", of: this.expr())); }
    public fn FloatNode y() { return FloatNode.of(e: member(name: "y", wgslType: "f32", of: this.expr())); }
}

// WGSL's vec3f, a colour as well as a direction.
type resource Vec3Node implements Copyable<This>(bare: copy), Node<This> {
    Shared<Expr> e;
    public ctor of(Shared<Expr> e) { this.e = give e; }
    public ctor copy(ref Vec3Node source) { this.e = copy source.e; }
    public fn Shared<Expr> expr() { return copy this.e; }
    public const fn string wgslType() { return "vec3f"; }
    public fn Vec3Node over(Shared<Expr> e) { return Vec3Node.of(e: give e); }

    public Vec3Node operator+(Vec3Node rhs) { return Vec3Node.of(e: binary(op: "+", wgslType: "vec3f", a: this.expr(), b: rhs.expr())); }
    public Vec3Node operator-(Vec3Node rhs) { return Vec3Node.of(e: binary(op: "-", wgslType: "vec3f", a: this.expr(), b: rhs.expr())); }
    public Vec3Node operator*(Vec3Node rhs) { return Vec3Node.of(e: binary(op: "*", wgslType: "vec3f", a: this.expr(), b: rhs.expr())); }
    public Vec3Node operator/(Vec3Node rhs) { return Vec3Node.of(e: binary(op: "/", wgslType: "vec3f", a: this.expr(), b: rhs.expr())); }
    public Vec3Node operator*(FloatNode rhs) { return Vec3Node.of(e: binary(op: "*", wgslType: "vec3f", a: this.expr(), b: rhs.expr())); }
    public Vec3Node operator/(FloatNode rhs) { return Vec3Node.of(e: binary(op: "/", wgslType: "vec3f", a: this.expr(), b: rhs.expr())); }
    // a float added to or taken from each component, and a number less a vector, as WGSL's vector-scalar forms
    public Vec3Node operator+(FloatNode rhs) { return Vec3Node.of(e: binary(op: "+", wgslType: "vec3f", a: this.expr(), b: rhs.expr())); }
    public Vec3Node operator-(FloatNode rhs) { return Vec3Node.of(e: binary(op: "-", wgslType: "vec3f", a: this.expr(), b: rhs.expr())); }
    public Vec3Node operator+(float32 s) { return Vec3Node.of(e: binary(op: "+", wgslType: "vec3f", a: this.expr(), b: numberExpr(v: s))); }
    public Vec3Node operator-(float32 s) { return Vec3Node.of(e: binary(op: "-", wgslType: "vec3f", a: this.expr(), b: numberExpr(v: s))); }
    public Vec3Node operator-(float32 s, Vec3Node v) { return Vec3Node.of(e: binary(op: "-", wgslType: "vec3f", a: numberExpr(v: s), b: v.expr())); }
    public Vec3Node operator*(float32 s) { return Vec3Node.of(e: binary(op: "*", wgslType: "vec3f", a: this.expr(), b: numberExpr(v: s))); }
    public Vec3Node operator*(float32 s, Vec3Node v) { return Vec3Node.of(e: binary(op: "*", wgslType: "vec3f", a: numberExpr(v: s), b: v.expr())); }
    public Vec3Node operator-() { return Vec3Node.of(e: unary(op: "-", wgslType: "vec3f", a: this.expr())); }
    public fn FloatNode x() { return FloatNode.of(e: member(name: "x", wgslType: "f32", of: this.expr())); }
    public fn FloatNode y() { return FloatNode.of(e: member(name: "y", wgslType: "f32", of: this.expr())); }
    public fn FloatNode z() { return FloatNode.of(e: member(name: "z", wgslType: "f32", of: this.expr())); }
}

// WGSL's vec4f.
type resource Vec4Node implements Copyable<This>(bare: copy), Node<This> {
    Shared<Expr> e;
    public ctor of(Shared<Expr> e) { this.e = give e; }
    public ctor copy(ref Vec4Node source) { this.e = copy source.e; }
    public fn Shared<Expr> expr() { return copy this.e; }
    public const fn string wgslType() { return "vec4f"; }
    public fn Vec4Node over(Shared<Expr> e) { return Vec4Node.of(e: give e); }
    public Vec4Node operator+(Vec4Node rhs) { return Vec4Node.of(e: binary(op: "+", wgslType: "vec4f", a: this.expr(), b: rhs.expr())); }
    public Vec4Node operator*(Vec4Node rhs) { return Vec4Node.of(e: binary(op: "*", wgslType: "vec4f", a: this.expr(), b: rhs.expr())); }
    public fn Vec2Node xy() { return Vec2Node.of(e: member(name: "xy", wgslType: "vec2f", of: this.expr())); }
    public fn Vec3Node xyz() { return Vec3Node.of(e: member(name: "xyz", wgslType: "vec3f", of: this.expr())); }
    public fn FloatNode w() { return FloatNode.of(e: member(name: "w", wgslType: "f32", of: this.expr())); }
}

// WGSL's mat3x3f, column-major as WGSL's is: a normal matrix.
type resource Mat3Node implements Copyable<This>(bare: copy), Node<This> {
    Shared<Expr> e;
    public ctor of(Shared<Expr> e) { this.e = give e; }
    public ctor copy(ref Mat3Node source) { this.e = copy source.e; }
    public fn Shared<Expr> expr() { return copy this.e; }
    public const fn string wgslType() { return "mat3x3f"; }
    public fn Mat3Node over(Shared<Expr> e) { return Mat3Node.of(e: give e); }
    public Mat3Node operator*(Mat3Node rhs) { return Mat3Node.of(e: binary(op: "*", wgslType: "mat3x3f", a: this.expr(), b: rhs.expr())); }
    public Vec3Node operator*(Vec3Node rhs) { return Vec3Node.of(e: binary(op: "*", wgslType: "vec3f", a: this.expr(), b: rhs.expr())); }
}

// WGSL's mat4x4f, column-major as WGSL's is.
type resource Mat4Node implements Copyable<This>(bare: copy), Node<This> {
    Shared<Expr> e;
    public ctor of(Shared<Expr> e) { this.e = give e; }
    public ctor copy(ref Mat4Node source) { this.e = copy source.e; }
    public fn Shared<Expr> expr() { return copy this.e; }
    public const fn string wgslType() { return "mat4x4f"; }
    public fn Mat4Node over(Shared<Expr> e) { return Mat4Node.of(e: give e); }
    public Mat4Node operator*(Mat4Node rhs) { return Mat4Node.of(e: binary(op: "*", wgslType: "mat4x4f", a: this.expr(), b: rhs.expr())); }
    public Vec4Node operator*(Vec4Node rhs) { return Vec4Node.of(e: binary(op: "*", wgslType: "vec4f", a: this.expr(), b: rhs.expr())); }
}

// A number as a node, where nothing beside it gives its type (an argument, a constructor's part).
fn FloatNode constant(float32 value) { return FloatNode.of(e: numberExpr(v: value)); }
fn Vec2Node vec2(FloatNode x, FloatNode y) {
    return Vec2Node.of(e: call2(name: "vec2f", wgslType: "vec2f", a: x.expr(), b: y.expr()));
}
fn Vec3Node vec3(FloatNode x, FloatNode y, FloatNode z) {
    return Vec3Node.of(e: call3(name: "vec3f", wgslType: "vec3f", a: x.expr(), b: y.expr(), c: z.expr()));
}
fn Vec4Node vec4(Vec3Node xyz, FloatNode w) {
    return Vec4Node.of(e: call2(name: "vec4f", wgslType: "vec4f", a: xyz.expr(), b: w.expr()));
}

// WGSL's built-in functions, typed. One WGSL defines for every float type takes any node and answers its type.
fn FloatNode dot(Vec3Node a, Vec3Node b) { return FloatNode.of(e: call2(name: "dot", wgslType: "f32", a: a.expr(), b: b.expr())); }
fn Vec3Node normalize(Vec3Node v) { return Vec3Node.of(e: call1(name: "normalize", wgslType: "vec3f", a: v.expr())); }
fn T max<T: Node<T>>(T a, T b) { return a.over(e: call2(name: "max", wgslType: a.wgslType(), a: a.expr(), b: b.expr())); }
fn T min<T: Node<T>>(T a, T b) { return a.over(e: call2(name: "min", wgslType: a.wgslType(), a: a.expr(), b: b.expr())); }
fn T saturate<T: Node<T>>(T x) { return x.over(e: call1(name: "saturate", wgslType: x.wgslType(), a: x.expr())); }
fn T sqrt<T: Node<T>>(T x) { return x.over(e: call1(name: "sqrt", wgslType: x.wgslType(), a: x.expr())); }
fn T exp2<T: Node<T>>(T x) { return x.over(e: call1(name: "exp2", wgslType: x.wgslType(), a: x.expr())); }
fn T pow<T: Node<T>>(T x, T power) { return x.over(e: call2(name: "pow", wgslType: x.wgslType(), a: x.expr(), b: power.expr())); }
// `from` where `by` is 0 and `to` where it is 1, for any float type and a float between, as WGSL's `mix`
fn T mix<T: Node<T>>(T from, T to, FloatNode by) {
    return from.over(e: call3(name: "mix", wgslType: from.wgslType(), a: from.expr(), b: to.expr(), c: by.expr()));
}

// A vertex stage's value read by the fragment stage, interpolated across the triangle, as TSL's `varying()`. A vertex
// attribute read in the fragment stage becomes one by itself.
fn T varying<T: Node<T>>(T value) {
    return value.over(e: withArgs(e: exprOf(kind: ExprKind::Varying, text: "", wgslType: value.wgslType()), a: value.expr(),
                                  b: Optional::None, c: Optional::None));
}

// What the renderer gives every material, as TSL's: the vertex's position and normal in its mesh (`positionLocal`,
// `normalLocal`), the object's world matrix and normal matrix, read in the vertex stage alone (`modelWorldMatrix`,
// `modelNormalMatrix`), and the camera's view-projection (`cameraProjectionMatrix * cameraViewMatrix`).
fn Vec3Node positionLocal() { return Vec3Node.of(e: exprOf(kind: ExprKind::Attribute, text: "position", wgslType: "vec3f")); }
fn Vec3Node normalLocal() { return Vec3Node.of(e: exprOf(kind: ExprKind::Attribute, text: "normal", wgslType: "vec3f")); }
fn Mat4Node modelWorldMatrix() { return Mat4Node.of(e: exprOf(kind: ExprKind::VertexName, text: "objects[object].world", wgslType: "mat4x4f")); }
// The inverse transpose of the world matrix's 3x3, made on the CPU when the object moved (three.js's
// `modelNormalMatrix`), so a normal stays at right angles to its surface under any scale, shear or mirror.
fn Mat3Node modelNormalMatrix() { return Mat3Node.of(e: exprOf(kind: ExprKind::VertexName, text: "objects[object].normal", wgslType: "mat3x3f")); }
fn Mat4Node cameraViewProjectionMatrix() { return Mat4Node.of(e: exprOf(kind: ExprKind::Name, text: "frame.viewProjection", wgslType: "mat4x4f")); }
// The camera's position in world space, as TSL's `cameraPosition`, read by either stage from the frame: where the view
// direction `normalize(cameraPosition() - positionWorld())` points.
fn Vec3Node cameraPosition() { return Vec3Node.of(e: exprOf(kind: ExprKind::Name, text: "frame.cameraPosition", wgslType: "vec3f")); }

// The surface's normal in world space, interpolated across the triangle and of length 1, as TSL's
// `normalWorldGeometry`: the normal matrix times the vertex's normal, through a varying, normalized.
fn Vec3Node normalWorld() {
    Vec3Node turned = modelNormalMatrix() * normalLocal();
    return normalize(v: varying(value: turned));
}
// The surface's position in world space, as TSL's `positionWorld`: the world matrix times the vertex, through a varying.
fn Vec3Node positionWorld() {
    Vec4Node world = modelWorldMatrix() * vec4(xyz: positionLocal(), w: constant(value: 1.0));
    return varying(value: world.xyz());
}

// The texture the renderer binds as `texture`, sampled at `uv`, as TSL's `texture(…)`: in the fragment stage alone. The
// renderer binds one, the DFG table (`dfgTable`); a material's own textures come with its maps.
fn Vec4Node sampled(string texture, Vec2Node uv) {
    return Vec4Node.of(e: withArgs(e: exprOf(kind: ExprKind::Sample, text: give texture, wgslType: "vec4f"), a: uv.expr(),
                                   b: Optional::None, c: Optional::None));
}

// The DFG table at (`roughness`, `dotNV`), as three.js r187's `DFGLUT`: the scale and bias a surface's specular
// reflectance takes, read through the renderer's 16 x 16 RG16F table (src/dfg.kama), linear between texels and clamped
// at its edges. In the fragment stage alone, since it samples a texture.
fn Vec2Node dfg(FloatNode roughness, FloatNode dotNV) {
    Shared<ShaderFunction> f = new ShaderFunction.make(name: "DFGLUT");
    FloatNode r = param(function: f, name: "roughness", value: roughness);
    FloatNode n = param(function: f, name: "dotNV", value: dotNV);
    Vec4Node texel = sampled(texture: "dfgTable", uv: vec2(x: r, y: n));
    return called(function: f, body: texel.xy());
}

// A typed function, as TSL's `Fn(…).setLayout(…)`: its name, its parameters, and its body over them. Each parameter is
// declared with the argument this call passes (`param`), so a call cannot pass the wrong number or type, and `called`
// hands back a node of the body's type. The compiler writes each function a material reaches once, its callees first.
//
//     fn FloatNode dGgx(FloatNode alpha, FloatNode dotNH) {
//         Shared<ShaderFunction> f = new ShaderFunction.make(name: "D_GGX");
//         FloatNode a = param(function: f, name: "alpha", value: alpha);
//         …
//         return called(function: f, body: a2 / (denom * denom) * RECIPROCAL_PI);
//     }
type resource ShaderFunction {
    string named;
    DynamicArray<string> paramNames;
    DynamicArray<string> paramTypes;
    DynamicArray<Shared<Expr>> values;
    Optional<Shared<Expr>> body = Optional::None;

    public ctor make(string name) {
        this.named = give name;
        this.paramNames = DynamicArray.empty(); this.paramTypes = DynamicArray.empty(); this.values = DynamicArray.empty();
    }
    public const fn string name() { return copy this.named; }
    public const fn isize params() { return this.paramNames.length(); }
    public const fn string paramName(isize i) { return copy this.paramNames[i]; }
    public const fn string paramType(isize i) { return copy this.paramTypes[i]; }
    // Its body, once `called` has given it one.
    public const fn Optional<Shared<Expr>> bodyExpr() { return copy this.body; }

    fn void declare(string name, string wgslType, Shared<Expr> value) {
        this.paramNames.add(item: give name);
        this.paramTypes.add(item: give wgslType);
        this.values.add(item: give value);
    }
    fn void finish(Shared<Expr> e) { this.body = Optional::Some(value: give e); }
    const fn isize valueCount() { return this.values.length(); }
    const fn Shared<Expr> valueAt(isize i) { return copy this.values[i]; }

    friend param[declare];
    friend called[finish, valueCount, valueAt];
}

// A parameter of `function` named `name`, taking `value` at this call: in the body, a node of `value`'s type.
fn T param<T: Node<T>>(Shared<ShaderFunction> function, string name, T value) {
    function.declare(name: copy name, wgslType: value.wgslType(), value: value.expr());
    return value.over(e: exprOf(kind: ExprKind::Param, text: give name, wgslType: value.wgslType()));
}

// The call of `function`, whose body is `body`: a node of the body's type, written as a call of the function.
fn T called<T: Node<T>>(Shared<ShaderFunction> function, T body) {
    function.finish(e: body.expr());
    Shared<Expr> e = exprOf(kind: ExprKind::FnCall, text: function.name(), wgslType: body.wgslType());
    for (isize i = 0; i < function.valueCount(); i = i + 1) { e.arg(e: function.valueAt(i: i)); }
    e.calls(f: give function);
    return body.over(e: give e);
}

// ---- the scene's lights ----
//
// How a material's shader reads the scene's lights (kyoten's rendering.md § Decided, GFX-1's part 3: the lights'
// question 1, and the owner's (A) of 2026-11-16, a lighting model): a model says how ONE light lights the surface, as
// three.js r187's `LightingModel.direct` and Godot's `light()` do, and `lit` hands it the light's direction and colour as
// nodes. The compiler writes `direct` once, inside a loop over the scene's directional lights, whose number the shader
// learns only as it runs, so adding or removing a light compiles nothing. What `direct` reads that depends on no light,
// such as the surface's normal or a material's setting, is computed once, before the loop. A program's own model is
// checked exactly as the library's.

// What a light gives a surface, as three.js's `reflectedLight`: its diffuse part and its specular part, each linear.
type resource ReflectedLight {
    Vec3Node diffusePart;
    Vec3Node specularPart;
    public ctor of(Vec3Node diffuse, Vec3Node specular) {
        this.diffusePart = give diffuse;
        this.specularPart = give specular;
    }
    public fn Vec3Node diffuse() { return copy this.diffusePart; }
    public fn Vec3Node specular() { return copy this.specularPart; }
}

// How light reaches a surface, as three.js r187's `LightingModel`.
// - `direct`: what ONE directional light gives, from `lightDirection`, towards the light and of length 1 in world space,
//   and `lightColor`, its linear colour × intensity. It is written once, inside the loop over the scene's directional
//   lights, and its parts are summed over them. The two nodes are read only there: a model that keeps them for later is
//   refused.
// - `indirect`: what the ambient light gives, from `irradiance`, the scene's ambient lights' sum, linear.
type contract LightingModel for resource {
    fn ReflectedLight direct(Vec3Node lightDirection, Vec3Node lightColor);
    fn ReflectedLight indirect(Vec3Node irradiance);
}

// One directional light's `field` inside the loop over them.
fn Vec3Node lightValue(string field) { return Vec3Node.of(e: exprOf(kind: ExprKind::Light, text: give field, wgslType: "vec3f")); }

// `term` summed over the scene's directional lights.
fn Vec3Node summedOverLights(Vec3Node term) {
    return Vec3Node.of(e: withArgs(e: exprOf(kind: ExprKind::LightSum, text: "", wgslType: "vec3f"), a: term.expr(),
                                   b: Optional::None, c: Optional::None));
}

// The light leaving the surface under the scene's lights, as `model` says each reaches it, linear: as three.js r187's
// `LightsNode`, the direct and indirect diffuse parts plus the direct and indirect specular parts, the direct ones summed
// over the scene's directional lights and the indirect ones from its ambient lights' sum.
fn Vec3Node lit<M: LightingModel>(ref M model) {
    ReflectedLight fromLights = model.direct(lightDirection: lightValue(field: "direction"), lightColor: lightValue(field: "color"));
    Vec3Node ambient = Vec3Node.of(e: exprOf(kind: ExprKind::Name, text: "frame.ambient", wgslType: "vec3f"));
    ReflectedLight fromAmbient = model.indirect(irradiance: ambient);
    Vec3Node totalDiffuse = summedOverLights(term: fromLights.diffuse()) + fromAmbient.diffuse();
    Vec3Node totalSpecular = summedOverLights(term: fromLights.specular()) + fromAmbient.specular();
    return totalDiffuse + totalSpecular;
}
