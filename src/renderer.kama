// The renderer, on every backend (`Renderer`, not `WebGPURenderer`: area 2, item 1). It gets its GPU both ways (kyoten's
// rendering.md § Decided, GFX-1's part 1, question 1): `withDevice` takes a device the program already has, which an
// engine, an editor's several views or a test on the fallback adapter hands it, and `make(window:, options:)`, which
// requests its own, comes with the window (part 6).
//
// A camera names the target it draws into, and with none it draws into the window (question 4). A target is cleared and
// read on its own: `clear(target:)` fills it with the clear colour, and `readRenderTargetPixels(target:)` starts a read
// that hands back an @kama/image `Image` (question 6). kama has no promises, so a read is a request the program polls, as
// @kama/gpu's are, and the poll moves the device on itself, so a program never polls the device.
//
// `render(scene:, camera:)` draws a scene as three.js's does (part 2): the scene's walk makes the world matrices that
// changed and writes its meshes' records. Then two passes over the same draws (kyoten's rendering.md § Decided, area 3
// and part 4): a depth prepass, the depth cleared to 0 since depth is reversed (GFX-1's question 1: near 1, far 0, the
// test Greater), keeps each texel's nearest depth; and the shaded pass clears the colour to the clear colour and shades
// each mesh where its depth equals the prepass's, so each texel is shaded once. Each mesh is one draw a pass, reading its
// record by its instance index. Sorting draws and drawing a mesh and material in common as one instanced draw come with
// automatic instancing (GFX-2). Both passes draw at the samples a texel of the renderer's anti-aliasing method
// (antialiasing.kama), and the scene's 16-bit float texture is made from them by the GPU's resolve, by the tone-mapped
// resolve's own pass, or, at one sample, by drawing it; then the output pass writes an 8-bit target from it through the
// camera's tone mapping. `info()` says what the last render did, as three.js's `renderer.info`.
//
// Every pipeline is compiled off the frame (kyoten's rendering.md § Decided, GFX-1's part 5, question 1): a slot asked for
// with @kama/gpu's `createRenderPipelineAsync`, which each render polls and never uses in the render that asked for it.
// What a draw does meanwhile is the program's (`WhileCompiling`), the renderer's or a mesh's own, and
// `compile(scene:, camera:)` asks for a scene's pipelines ahead, a request polled as @kama/gpu's are.
//
// The scene's lights reach every material as data in the frame's group (kyoten's rendering.md § Decided, GFX-1's part
// 3, the lights' question 1): the frame block carries the ambient lights' sum and how many directional lights there
// are, and binding 4 the directional lights themselves, so adding, removing, moving or dimming a light compiles nothing.
// The frame block carries the camera's position in world space too, which a physical model's view direction reads
// (`cameraPosition()`), so moving the camera compiles nothing either.
//
// A misuse the types cannot refuse is refused and reported, never ending the program (part 2, question 4), as @kama/gpu's
// decision 9 does below it: a camera naming no target, rendered by a renderer with no window, draws nothing. The error
// is the renderer's, read by `takeErrors()` as @kama/gpu's device's are, and printed as it happens unless the program
// turns `printErrors` off, which a program that reads them itself does.

import {
    std::collections::DynamicArray, std::collections::FixedArray,
    std::io::stderr, std::io::StdErr, std::memory::replace, std::memory::Weak,
    std::math::Mat4, std::math::Vec3,
    gpu::Device, gpu::Queue, gpu::GpuError, gpu::Texture, gpu::TextureView, gpu::TextureViewDescriptor, gpu::TextureFormat,
    gpu::Buffer, gpu::BufferDescriptor, gpu::BufferUsage, gpu::BufferRead, gpu::ReadStatus, gpu::BufferBinding,
    gpu::CommandEncoder, gpu::CommandBuffer, gpu::RenderPass, gpu::RenderPassDescriptor, gpu::ColorAttachment,
    gpu::LoadOp, gpu::StoreOp,
    gpu::DepthStencilAttachment, gpu::DepthAccess, gpu::IndexFormat, gpu::Color as GpuColor,
    gpu::ShaderModule, gpu::ShaderModuleDescriptor, gpu::ShaderStage,
    gpu::BindGroupLayout, gpu::BindGroupLayoutDescriptor, gpu::BindingLayout, gpu::BufferBindingLayout,
    gpu::BufferBindingType, gpu::BindGroup, gpu::BindGroupDescriptor, gpu::BindingResource,
    gpu::PipelineLayout, gpu::PipelineLayoutDescriptor, gpu::Layout,
    gpu::RenderPipeline, gpu::RenderPipelineDescriptor, gpu::PipelineRequest, gpu::PipelineStatus, gpu::PipelineError,
    gpu::CompilationInfo, gpu::CompilationMessage, gpu::VertexState, gpu::VertexBufferLayout, gpu::VertexFormat,
    gpu::FragmentState, gpu::ColorTargetState, gpu::CullMode, gpu::FrontFace, gpu::DepthStencilState, gpu::CompareFunction,
    gpu::TextureDescriptor, gpu::TextureUsage, gpu::TextureBindingLayout, gpu::SamplerBindingLayout, gpu::Sampler,
    gpu::SamplerDescriptor, gpu::AddressMode, gpu::FilterMode, gpu::MipmapFilterMode, gpu::TexelCopyTextureInfo,
    gpu::TexelCopyBufferLayout, gpu::Extent3D, gpu::TextureDimension, gpu::TextureViewDimension, gpu::TextureSampleType,
    gpu::Instance, gpu::AdapterOptions, gpu::AdapterRequest, gpu::AdapterStatus, gpu::DeviceOptions, gpu::DeviceRequest,
    gpu::DeviceStatus, gpu::PowerPreference, gpu::Surface, gpu::SurfaceCapabilities, gpu::SurfaceConfig, gpu::SurfaceTexture,
    gpu::SurfaceError, gpu::ConfigureError, gpu::PresentMode, gpu::AlphaMode as SurfaceAlpha,
    window::Window, window::NativeWindow, window::Size,
    image::Image, image::ImageError, image::PixelFormat, image::AlphaMode, image::ColorSpace,
    Color, RenderTarget, Scene, Walk, PerspectiveCamera, Geometry, BufferGeometry, Material, MaterialSettings, NodeBuilder,
    MeshStandardMaterial,
    dfgTable, ToneMapping, outputWgsl, readsTable, blenderAgxTable, blenderAgxSize, Antialiasing, samplesOf, resolveWgsl,
    Quality,
};
export {
    Renderer, RendererOptions, RenderInfo, PixelRead, PixelStatus, GraphicsErrorKind, GraphicsErrorReport, RendererErrors,
    WhileCompiling, CompileRequest, CompileStatus,
};

// A copied row's bytes, `texel` bytes a texel: WebGPU aligns them to 256.
fn uint32 rowBytes(uint32 width, uint32 texel) { return (width * texel + 255) / 256 * 256; }

// A refused misuse, printed to stderr as one line, as @kama/gpu prints a device's errors (`@kama/gpu: …`); scene.kama's
// `add` prints its own the same way. A write that fails is let go: there is nowhere left to report it.
unsafe fn void printMisuse(const ref string words) {
    StdErr err = stderr();
    string line = "@kama/graphics: " + words + "\n";
    match (err.write(bytes: line.bytes())) { case Ok(value: n): { } case Err(error: e): { } };
}

fn void putFloat(ref DynamicArray<uint8> into, float32 value) {
    uint32 bits = bitcast<uint32>(value);
    into.add(item: truncate<uint8>(bits));
    into.add(item: truncate<uint8>(bits >> 8));
    into.add(item: truncate<uint8>(bits >> 16));
    into.add(item: truncate<uint8>(bits >> 24));
}

// The vertex stage of every pipeline a material's WGSL makes: its `vs`, the geometry's positions at location 0 and its
// normals at 1. The shaded pass and the depth prepass run the same one, so the clip position is computed alike.
fn VertexState meshVertex(ShaderModule shader) {
    VertexBufferLayout positions = VertexBufferLayout.make(arrayStride: 12);
    positions.attribute(format: VertexFormat::Float32x3, offset: 0, shaderLocation: 0);
    VertexBufferLayout normals = VertexBufferLayout.make(arrayStride: 12);
    normals.attribute(format: VertexFormat::Float32x3, offset: 0, shaderLocation: 1);
    VertexState vertex = VertexState.make(module: give shader, entryPoint: "vs");
    vertex.buffer(layout: give positions);
    vertex.buffer(layout: give normals);
    return vertex;
}

// The shaded pass's pipeline for a material's `shader`, for a mirrored mesh or not, at `count` samples a texel: front faces
// culled as three.js's FrontSide, and shaded where the prepass left this fragment's own depth, the nearest, so each
// texel is shaded once: Equal, as Godot's Forward+ (kyoten's rendering.md § Decided, part 4), which `@invariant` on the
// clip position makes exact.
fn RenderPipelineDescriptor shadedDescriptor(PipelineLayout layout, ShaderModule shader, bool mirrored, uint32 count) {
    FragmentState fragment = FragmentState.make(module: copy shader, entryPoint: "fs");
    // every scene is drawn in linear HDR, into a 16-bit float texture (area 3; part 4)
    fragment.target(state: ColorTargetState.make(format: TextureFormat::RGBA16Float));
    RenderPipelineDescriptor pipeline = RenderPipelineDescriptor.make(layout: Layout::Explicit(layout: give layout),
                                                                      vertex: meshVertex(shader: give shader));
    pipeline.fragment(state: give fragment);
    pipeline.primitiveMut().cullMode = CullMode::Back;   // front faces wind counter-clockwise,
    if (mirrored) { pipeline.primitiveMut().frontFace = FrontFace::CW; }   // and clockwise on a mirrored mesh
    pipeline.depthStencil(state: DepthStencilState.make(format: TextureFormat::Depth32Float, depthWriteEnabled: false,
                                                        depthCompare: CompareFunction::Equal));
    pipeline.multisampleMut().count = count;
    pipeline.label(text: "a mesh");
    return pipeline;
}

// ...and the depth prepass's: the same vertex stage and culling, no fragment stage, the nearest depth kept (reversed:
// the greater).
fn RenderPipelineDescriptor depthDescriptor(PipelineLayout layout, ShaderModule shader, bool mirrored, uint32 count) {
    RenderPipelineDescriptor depthOnly = RenderPipelineDescriptor.make(layout: Layout::Explicit(layout: give layout),
                                                                       vertex: meshVertex(shader: give shader));
    depthOnly.primitiveMut().cullMode = CullMode::Back;
    if (mirrored) { depthOnly.primitiveMut().frontFace = FrontFace::CW; }
    depthOnly.depthStencil(state: DepthStencilState.make(format: TextureFormat::Depth32Float, depthWriteEnabled: true,
                                                         depthCompare: CompareFunction::Greater));
    depthOnly.multisampleMut().count = count;
    depthOnly.label(text: "a mesh's depth");
    return depthOnly;
}

// A material's general form's pipelines (NodeBuilder's `generalWgsl()`; kyoten's rendering.md § Decided, GFX-1's part 5,
// question 1): the shaded pass's and the depth prepass's as above, but culling nothing, in the default winding, since the
// shader culls, so one pipeline draws mirrored meshes and others. The depth prepass's runs `fsCull`, with no colour
// target, which discards a face that faces away before its depth is written.
fn RenderPipelineDescriptor generalShadedDescriptor(PipelineLayout layout, ShaderModule shader, uint32 count) {
    FragmentState fragment = FragmentState.make(module: copy shader, entryPoint: "fs");
    fragment.target(state: ColorTargetState.make(format: TextureFormat::RGBA16Float));
    RenderPipelineDescriptor pipeline = RenderPipelineDescriptor.make(layout: Layout::Explicit(layout: give layout),
                                                                      vertex: meshVertex(shader: give shader));
    pipeline.fragment(state: give fragment);
    pipeline.depthStencil(state: DepthStencilState.make(format: TextureFormat::Depth32Float, depthWriteEnabled: false,
                                                        depthCompare: CompareFunction::Equal));
    pipeline.multisampleMut().count = count;
    pipeline.label(text: "a mesh, by its material's general form");
    return pipeline;
}
fn RenderPipelineDescriptor generalDepthDescriptor(PipelineLayout layout, ShaderModule shader, uint32 count) {
    RenderPipelineDescriptor depthOnly = RenderPipelineDescriptor.make(layout: Layout::Explicit(layout: give layout),
                                                                       vertex: meshVertex(shader: copy shader));
    depthOnly.fragment(state: FragmentState.make(module: give shader, entryPoint: "fsCull"));
    depthOnly.depthStencil(state: DepthStencilState.make(format: TextureFormat::Depth32Float, depthWriteEnabled: true,
                                                         depthCompare: CompareFunction::Greater));
    depthOnly.multisampleMut().count = count;
    depthOnly.label(text: "a mesh's depth, by its material's general form");
    return depthOnly;
}

// One pass's draws, the depth prepass's or the shaded pass's: each mesh `render` gathered, with its pipeline, which
// `chosen` names so a run of draws with one pipeline binds it once (a general form's named below -1), its material's group, its geometry's buffers, and its
// record by its instance index.
unsafe fn void drawEach(ref RenderPass pass, const ref DynamicArray<RenderPipeline> pipelines, const ref DynamicArray<isize> chosen,
                        const ref DynamicArray<BindGroup> looks, const ref DynamicArray<Buffer> positions,
                        const ref DynamicArray<Buffer> normals, const ref DynamicArray<Buffer> indices,
                        const ref DynamicArray<IndexFormat> formats, const ref DynamicArray<uint32> counts,
                        const ref DynamicArray<uint32> slots) {
    isize bound = -1;
    for (isize i = 0; i < chosen.length(); i = i + 1) {
        if (chosen[i] != bound) { pass.setPipeline(pipeline: pipelines[i]); bound = chosen[i]; }
        pass.setBindGroup(index: 1, group: looks[i]);
        pass.setVertexBuffer(slot: 0, binding: BufferBinding.whole(buffer: copy positions[i]));
        pass.setVertexBuffer(slot: 1, binding: BufferBinding.whole(buffer: copy normals[i]));
        pass.setIndexBuffer(binding: BufferBinding.whole(buffer: copy indices[i]), format: formats[i]);
        pass.drawIndexed(indexCount: counts[i], instanceCount: 1, firstIndex: 0, baseVertex: 0, firstInstance: slots[i]);
    }
}

// The most misuses a renderer keeps until `takeErrors()` drains them, as @kama/gpu's channel keeps 64.
comptime isize KEPT = 64;

// The frame block as WGSL's `Frame` lays it out: the view-projection, a mat4x4f at 0; the ambient lights' sum, a vec3f at
// 64; the directional lights' count, a u32 at 76; the camera's position in world space, a vec3f at 80; and the
// camera's exposure, an f32 at 92, what the scene's light is scaled by before it is stored.
comptime uint64 FRAME_BYTES = 96;

// What kind of misuse a renderer refused. `NoTarget`: a camera naming no render target was rendered by a renderer with
// no window to draw into. `Material`: a material's nodes were refused by its compile (node_builder.kama), or the device
// refused its pipeline, such as one passing more values between its stages than the device takes, so no mesh draws with
// it; or the device refused its general form alone, which takes two more of the values a device passes, so its draws
// are skipped while its own pipelines compile, reported once its own pipeline is made; or the device refused the
// stand-in's general form, so the draws that would take it are skipped, reported once. `Light`: a light that can light
// nothing, such as a directional light at its own target, reported when the light is written so. `Pipeline`: the
// device refused a pipeline of the renderer's own, a fault below the program: the output pass's, which is then left out,
// or the tone-mapped resolve's, when the GPU resolves instead, or the window read's pass onto the window, when a window
// read fails. `Device`: a renderer made with a window got no GPU, its adapter or its device refused, so it draws
// nothing. `Window`: the window refused something: a renderer made with a window has no surface on it, or the adapter
// cannot draw into it; its surface refused its configuration or gave no frame; or it does not offer the present mode
// the renderer asks for, which then presents with Fifo. A later misuse joins the list, so a program's `match` on it has
// a `case _:`.
@nonExhaustive
type enum GraphicsErrorKind { NoTarget, Material, Light, Pipeline, Device, Window }

// One misuse a renderer refused, in its words, whole, as @kama/gpu's `GpuErrorReport`.
type resource GraphicsErrorReport {
    GraphicsErrorKind sort;
    string words;

    public ctor of(GraphicsErrorKind kind, string message) {
        this.sort = kind;
        this.words = give message;
    }
    public const fn GraphicsErrorKind kind() { return this.sort; }
    public const fn string message() { return copy this.words; }
}

// What `renderer.takeErrors()` drained: the misuses refused since the last drain, the oldest first. A full record keeps
// the oldest 64, since the first is usually the cause and the later ones its repeats, and counts the rest in
// `dropped()`, as @kama/gpu's `DeviceErrors` does.
type resource RendererErrors {
    DynamicArray<GraphicsErrorReport> items;
    int64 overflow;

    friend Renderer::takeErrors[make];

    ctor make(DynamicArray<GraphicsErrorReport> reports, int64 dropped) {
        this.items = give reports;
        this.overflow = dropped;
    }
    public const fn const ref DynamicArray<GraphicsErrorReport> reports() { return this.items; }
    public const fn int64 dropped() { return this.overflow; }
    public const fn bool isEmpty() { return this.items.length() == 0 && this.overflow == 0; }
}

// What the last render did, as three.js's `renderer.info`: its draw calls and triangles, the meshes its scene holds a
// record for, and the world matrices its walk made (none, when nothing in the scene changed). Then what its pipelines
// compiling cost it (part 5): `misses`, what it drew other than as asked, each mesh skipped or drawn by its material's
// general form or by the stand-in while its own pipelines compile, and each frame pass not run as asked (the GPU
// resolving while the tone-mapped resolve compiles, the output pass left out), 0 when the render is the one asked for,
// which a loading screen or a test waits for; `skipped`, the meshes skipped; `general`, the meshes drawn by their
// material's general form; `standIn`, the meshes drawn by the stand-in; and `waited`, the pipelines it compiled itself,
// each a hitch, under `WhileCompiling::Wait`. A refused material is no miss, since it never draws.
@generate(of)
type value RenderInfo {
    public int32 calls;
    public int32 triangles;
    public int32 objects;
    public int32 matrices;
    public int32 misses;
    public int32 skipped;
    public int32 general;
    public int32 standIn;
    public int32 waited;
}

// What a draw does while its pipelines compile (kyoten's rendering.md § Decided, GFX-1's part 5, question 1, the owner's
// (A) of 2026-11-18), every pipeline being compiled off the frame unless a program asks otherwise. The renderer's
// `whileCompiling()` is every draw's, unless a mesh's own `whileCompiling()` names another (step 3's question 1):
// - `General`, the default: the material's general form (NodeBuilder's `generalWgsl()`), the same pixels drawn more
//   slowly, once it is compiled; where none is ready, or the device refused it, the draw is skipped. A draw that misses
//   asks for it, and so does `compile(scene:, camera:)`, so a variant new at run time, such as a mirrored copy, finds it;
// - `StandIn`: the renderer's stand-in (`standIn()`), the library's lit grey unless the program names its own, as
//   Unreal's default material, drawn by its general form, so one pair of pipelines serves every mesh, mirrored or not
//   (step 3's question 2). A draw that misses asks for it, and so does `compile`, only where a draw's way is
//   `StandIn`; until it is ready, or where the device refused it, the draw is skipped. A material refused outright is
//   not drawn by it, since it is not compiling;
// - `Skip`: nothing until the draw's own pipelines are ready, as Bevy and Unreal's default;
// - `Wait`: the pipelines compiled during the render that needs them, as three.js r187's, a hitch the program chose, for a
//   tool, a test or a cutscene. On the web the page does not freeze, but the browser's GPU process waits at the submit.
// The frame's own passes take the renderer's way, never a mesh's: while the tone-mapped resolve compiles, the GPU
// resolves (the ladder's next rung), and while the output pass compiles it is left out, the target left as it was;
// under `Wait` they are made during the render. A later way joins the list, so a program's `match` on it has a
// `case _:`.
@nonExhaustive
type enum WhileCompiling { General, StandIn, Skip, Wait }

// A refused pipeline's words: the device's, then its stages' first error each, where they say more.
fn string refusalWords(const ref PipelineError error) {
    string words = error.message();
    string vertex = firstError(info: error.vertexMessages());
    string fragment = firstError(info: error.fragmentMessages());
    if (!vertex.isEmpty()) { words = words + "; the vertex stage: " + vertex; }
    if (!fragment.isEmpty() && fragment != vertex) { words = words + "; the fragment stage: " + fragment; }
    return words;
}
fn string firstError(const ref CompilationInfo info) {
    foreach (const ref CompilationMessage m in info.messages().iterConst()) {
        bool error = match (m.kind()) { case Error: true; case _: false; };
        if (error) { return m.message(); }
    }
    return "";
}

// One pipeline a renderer makes, shared with any compile request waiting on it: made, asked for and compiling, or
// refused, its refusal's words kept until the renderer reports them, once.
type resource PipelineSlot {
    Optional<RenderPipeline> made = Optional::None;
    Optional<PipelineRequest> asked = Optional::None;
    bool refused = false;
    bool told = false;
    string why = "";
    string what;             // the words a refusal starts with: what was refused, and what follows from it
    GraphicsErrorKind sort;  // ...and the kind it is reported as

    friend Renderer[make, ready, refusedNow, wanted, ask, makeNow, settle, untold, silence, kind, pipeline];
    friend RendererGpu[make];
    friend CompileRequest[settle];

    ctor make(string what, GraphicsErrorKind kind) {
        this.what = give what;
        this.sort = kind;
    }

    const fn bool ready() { return this.made.isSome(); }
    const fn bool refusedNow() { return this.refused; }
    // Neither made, asked for nor refused: still to be asked for.
    const fn bool wanted() { return this.made.isNone() && this.asked.isNone() && !this.refused; }
    const fn GraphicsErrorKind kind() { return this.sort; }
    const fn RenderPipeline pipeline() {
        return match (this.made) { case Some(value: p): copy p; case None: { panic(msg: "a pipeline drawn with is made first"); } };
    }

    // Asked for off the frame (`@kama/gpu`'s `createRenderPipelineAsync`): on the web the browser compiles it, natively
    // @kama/gpu's own threads do.
    unsafe fn void ask(ref Device device, RenderPipelineDescriptor descriptor) {
        this.asked = Optional::Some(value: device.createRenderPipelineAsync(descriptor: give descriptor));
    }
    // Made during the render (`WhileCompiling::Wait`), a request still compiling let go.
    unsafe fn void makeNow(ref Device device, RenderPipelineDescriptor descriptor) {
        this.asked = Optional::None;
        this.made = Optional::Some(value: device.createRenderPipeline(descriptor: give descriptor));
    }
    // Its request polled: made when it answered with a pipeline, refused when it failed. Whether it has answered.
    unsafe fn bool settle() {
        if (this.made.isSome() || this.refused) { return true; }
        if (this.asked.isNone()) { return false; }
        PipelineStatus s = match (this.asked) { case Some(value: q): q.poll(); case None: PipelineStatus::Pending; };
        bool pending = match (s) { case Pending: true; case _: false; };
        if (pending) { return false; }
        match (give s) {
            case Ready(pipeline: p): { this.made = Optional::Some(value: give p); }
            case Failed(error: e): { this.refused = true; this.why = this.what + refusalWords(error: e); }
            case Pending: { }
        };
        this.asked = Optional::None;
        return true;
    }
    // Its refusal's words, the first time they are asked for; "" when it has none untold.
    fn string untold() {
        if (!this.refused || this.told) { return ""; }
        this.told = true;
        return copy this.why;
    }
    // Its refusal, now or whenever it comes, never told: its twin's was, for the one mesh both serve.
    fn void silence() { this.told = true; }
}

// What a compile request says when polled: `Pending` while any pipeline it asked for compiles, then `Ready` once each has
// answered, made or refused. A refusal is the renderer's to report, by its next render or `takeErrors()`.
type enum CompileStatus { Pending, Ready }

// What a compile request asked for, shared with its renderer: a compile asked before a renderer made with a window has
// its GPU waits, unasked, for the first render that finds the GPU (kyoten's rendering.md § Decided, GFX-1's part 6, step
// 1), and is asked for then.
type resource CompileSlots {
    DynamicArray<Shared<PipelineSlot>> slots;
    bool asked;

    friend Renderer[make, fill];
    friend CompileRequest[isAsked, count, at];

    ctor make(DynamicArray<Shared<PipelineSlot>> slots, bool asked) {
        this.slots = give slots;
        this.asked = asked;
    }
    const fn bool isAsked() { return this.asked; }
    const fn isize count() { return this.slots.length(); }
    unsafe const fn Shared<PipelineSlot> at(isize i) { return copy this.slots[i]; }
    // Asked for at last: these pipelines, none when the renderer's GPU never came.
    fn void fill(DynamicArray<Shared<PipelineSlot>> slots) {
        this.slots = give slots;
        this.asked = true;
    }
}

// The pipelines a scene needs, asked for off the frame by `renderer.compile(scene:, camera:)`, polled until each has
// answered, as @kama/gpu's requests are. Dropping it while it is pending is safe: the renderer keeps what it asked for.
// One asked before a renderer made with a window has its GPU is `Pending` until a render finds the GPU and asks for them.
type resource CompileRequest {
    Shared<CompileSlots> state;

    friend Renderer[make];

    ctor make(Shared<CompileSlots> state) { this.state = give state; }

    public unsafe fn CompileStatus poll() {
        if (!this.state.isAsked()) { return CompileStatus::Pending; }
        bool all = true;
        for (isize i = 0; i < this.state.count(); i = i + 1) {
            Shared<PipelineSlot> slot = this.state.at(i: i);
            if (!slot.settle()) { all = false; }
        }
        return all ? CompileStatus::Ready : CompileStatus::Pending;
    }
}

// A compile asked before the renderer's GPU, kept until a render finds it.
type resource DeferredCompile {
    Shared<Scene> scene;
    Shared<PerspectiveCamera> camera;
    Shared<CompileSlots> state;

    friend Renderer[make, scene, camera, state];

    ctor make(Shared<Scene> scene, Shared<PerspectiveCamera> camera, Shared<CompileSlots> state) {
        this.scene = give scene;
        this.camera = give camera;
        this.state = give state;
    }
}

// How `Renderer.make(window:, options:)` asks for its GPU (kyoten's rendering.md § Decided, GFX-1's part 6, step 1's
// details): the request alone, as WebGPU's `GPURequestAdapterOptions` and `GPUDeviceDescriptor` are. Everything a render
// draws by is the renderer's own, a property pair set at any time.
type value RendererOptions {
    public PowerPreference power = PowerPreference::HighPerformance;
    // WebGPU's `forceFallbackAdapter`: only a software GPU may answer, as a test held to a golden asks.
    public bool forceFallbackAdapter = false;
    // The device asked for: WebGPU's limits and features, and whether its errors are printed.
    public DeviceOptions device = DeviceOptions.defaults();

    public ctor defaults() { }
}

// The window read's pass onto the window (kyoten's rendering.md § Decided, GFX-1's part 6, step 1's third question, Bevy's
// way): one full-screen triangle writing each texel of the read's texture onto the window's frame, read with
// `textureLoad` through the sRGB view both share, which decodes and encodes every 8-bit value back to itself (measured
// on every leg, kyoten's .scratch/s40/probe-roundtrip).
fn string blitWgsl() {
    return "@group(0) @binding(0) var frame: texture_2d<f32>;\n"
        + "@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {\n"
        + "  var corner = array<vec2f, 3>(vec2f(-1.0, -1.0), vec2f(3.0, -1.0), vec2f(-1.0, 3.0));\n"
        + "  return vec4f(corner[i], 0.0, 1.0);\n"
        + "}\n"
        + "@fragment fn fs(@builtin(position) at: vec4f) -> @location(0) vec4f {\n"
        + "  return textureLoad(frame, vec2i(at.xy), 0);\n"
        + "}\n";
}

// The window's configuration from what its surface offers, presenting with `mode` (`Renderer.windowConfig`): the first
// format drawn through an 8-bit sRGB view, RGBA or BGRA, which a window read copies four bytes a texel; an opaque window
// where the surface offers one, else its first alpha mode; a render attachment alone. None when the surface offers no
// such format.
fn Optional<SurfaceConfig> configFrom(const ref SurfaceCapabilities caps, PresentMode mode) {
    SurfaceConfig c = caps.preferred();
    bool found = false;
    for (isize i = 0; i < caps.formats().length() && !found; i = i + 1) {
        TextureFormat f = caps.formats()[i];
        Optional<TextureFormat> s = f.srgb();
        TextureFormat view = match (s) { case Some(value: v): v; case None: f; };
        if (view == TextureFormat::RGBA8UnormSrgb || view == TextureFormat::BGRA8UnormSrgb) {
            c.format = f;
            c.viewFormat = view;
            found = true;
        }
    }
    if (!found) { return Optional::None; }
    c.present = mode;
    for (isize i = 0; i < caps.alphaModes().length(); i = i + 1) {
        if (caps.alphaModes()[i] == SurfaceAlpha::Opaque) { c.alpha = SurfaceAlpha::Opaque; }
    }
    c.usage = TextureUsage::RenderAttachment;
    return Optional::Some(value: c);
}

// Whether the surface offers present mode `mode`.
fn bool offersMode(const ref SurfaceCapabilities caps, PresentMode mode) {
    for (isize i = 0; i < caps.presentModes().length(); i = i + 1) {
        if (caps.presentModes()[i] == mode) { return true; }
    }
    return false;
}

// What the renderer's device makes, on the renderer while it has one: made at once by `withDevice`, and by
// `make(window:, options:)` at the render that finds its device answered (kyoten's rendering.md § Decided, GFX-1's part
// 6, step 1). The layouts, the frame's buffer, the DFG table and every pipeline the renderer asks for.
type resource RendererGpu {
    Device device;
    Queue queue;
    BindGroupLayout frameLayout;      // group 0: the frame, the object records, the DFG table and its sampler, the lights
    BindGroupLayout materialLayout;   // group 1: a material's settings
    PipelineLayout layout;
    Buffer frame;                     // the frame's uniform: the view-projection, the ambient light, the lights' count
    TextureView dfgView;              // three.js r187's DFG table, 16 x 16 RG16F, made once (src/dfg.kama)
    Sampler dfgSampling;              // linear, clamped to the edge, as r187's
    DynamicArray<string> sources;     // the meshes' pipelines, by the WGSL they run
    DynamicArray<bool> flipped;       // ...and whether they draw mirrored meshes, whose front faces wind clockwise
    DynamicArray<uint32> drawnAt;     // ...and the samples a texel they draw at, so a method changed back compiles nothing
    DynamicArray<Shared<PipelineSlot>> pipelines;
    DynamicArray<Shared<PipelineSlot>> prepasses;   // ...and each one's depth-only twin, for the depth prepass
    DynamicArray<isize> generalOf;    // ...and the entry of its material's general form, below
    DynamicArray<string> generalSources;   // the general forms' pipelines, by the WGSL they run, mirrored meshes or not
    DynamicArray<uint32> generalAt;        // ...and the samples a texel they draw at
    DynamicArray<Shared<PipelineSlot>> generalShaded;
    DynamicArray<Shared<PipelineSlot>> generalDepth;
    DynamicArray<bool> generalStandIn;     // ...and whether a stand-in draws by it, which has no pipelines of its own made
    BindGroupLayout outputLayout;               // the output pass's one binding: the scene's 16-bit float texture
    PipelineLayout outputPipelineLayout;
    BindGroupLayout tableLayout;                // ...and with Blender's AgX table beside it
    PipelineLayout tablePipelineLayout;
    Optional<TextureView> agxTableView = Optional::None;   // Blender's AgX table, made the first time a camera uses it
    DynamicArray<ToneMapping> outputCurves;     // the output pass's pipelines, by the tone mapping they apply
    DynamicArray<TextureFormat> outputFormats;  // ...and the format they write: a target's, or the window's view's
    DynamicArray<Shared<PipelineSlot>> outputs;
    BindGroupLayout resolveLayout;              // the tone-mapped resolve's one binding: the multisampled scene
    PipelineLayout resolvePipelineLayout;
    Shared<PipelineSlot> resolving;             // the tone-mapped resolve's pipeline, asked for the first time a render takes it
    // The window's: its scene, samples and depth, a target's textures without its colour, at the frame's size
    Optional<Shared<RenderTarget>> windowTarget = Optional::None;
    BindGroupLayout blitLayout;                 // the window read's pass onto the window: the read's texture
    PipelineLayout blitPipelineLayout;
    DynamicArray<TextureFormat> blitFormats;    // ...its pipelines, by the window's view format
    DynamicArray<Shared<PipelineSlot>> blits;

    friend Renderer[make, device, queue, frameLayout, materialLayout, layout, frame, dfgView, dfgSampling, sources, flipped,
                    drawnAt, pipelines, prepasses, generalOf, generalSources, generalAt, generalShaded, generalDepth,
                    generalStandIn, outputLayout, outputPipelineLayout, tableLayout, tablePipelineLayout, agxTableView,
                    outputCurves, outputFormats, outputs, resolveLayout, resolvePipelineLayout, resolving, windowTarget,
                    blitLayout, blitPipelineLayout, blitFormats, blits];

    unsafe ctor make(Device device, Queue queue) {
        BindGroupLayoutDescriptor g0 = BindGroupLayoutDescriptor.make();
        // the frame, read by both stages: the camera by the vertex stage, the ambient light, the count and the camera's
        // position by a lit one, or by any stage a material reads them in
        g0.entry(binding: 0, visibility: ShaderStage::Vertex | ShaderStage::Fragment,
                 layout: BindingLayout::Buffer(layout: BufferBindingLayout.make()));
        BufferBindingLayout records = BufferBindingLayout.make();
        records.kind = BufferBindingType::ReadOnlyStorage;
        g0.entry(binding: 1, visibility: ShaderStage::Vertex, layout: BindingLayout::Buffer(layout: records));
        // the DFG table and its sampler, which only a fragment stage samples (WGSL's textureSample)
        g0.entry(binding: 2, visibility: ShaderStage::Fragment, layout: BindingLayout::Texture(layout: TextureBindingLayout.make()));
        g0.entry(binding: 3, visibility: ShaderStage::Fragment, layout: BindingLayout::Sampler(layout: SamplerBindingLayout.make()));
        // the scene's directional lights, which a lit stage loops over, the fragment stage's or a program's own vertex stage
        BufferBindingLayout lights = BufferBindingLayout.make();
        lights.kind = BufferBindingType::ReadOnlyStorage;
        g0.entry(binding: 4, visibility: ShaderStage::Vertex | ShaderStage::Fragment, layout: BindingLayout::Buffer(layout: lights));
        g0.label(text: "the frame, the object records, the DFG table and the lights");
        this.frameLayout = device.createBindGroupLayout(descriptor: give g0);
        BindGroupLayoutDescriptor g1 = BindGroupLayoutDescriptor.make();
        // both stages, since a material's vertex stage may read its settings as well as its fragment stage
        g1.entry(binding: 0, visibility: ShaderStage::Vertex | ShaderStage::Fragment,
                 layout: BindingLayout::Buffer(layout: BufferBindingLayout.make()));
        g1.label(text: "a material's settings");
        this.materialLayout = device.createBindGroupLayout(descriptor: give g1);
        PipelineLayoutDescriptor groups = PipelineLayoutDescriptor.make();
        groups.group(layout: copy this.frameLayout);
        groups.group(layout: copy this.materialLayout);
        groups.label(text: "a mesh's groups");
        this.layout = device.createPipelineLayout(descriptor: give groups);
        BufferDescriptor described = BufferDescriptor.make(size: FRAME_BYTES, usage: BufferUsage::Uniform | BufferUsage::CopyDst);
        described.label(text: "the frame");
        this.frame = device.createBuffer(descriptor: give described);
        // the DFG table, r187's 512 half floats as they are, 64 bytes a row
        TextureDescriptor table = TextureDescriptor.make(width: 16, height: 16, format: TextureFormat::RG16Float,
                                                         usage: TextureUsage::TextureBinding | TextureUsage::CopyDst);
        table.label(text: "the DFG table");
        Texture dfg = device.createTexture(descriptor: give table);
        DynamicArray<uint16> halves = dfgTable();
        DynamicArray<uint8> bytes = DynamicArray.empty();
        for (isize i = 0; i < halves.length(); i = i + 1) {
            bytes.add(item: truncate<uint8>(halves[i]));
            bytes.add(item: truncate<uint8>(halves[i] >> 8));
        }
        TexelCopyBufferLayout rows = TexelCopyBufferLayout.make();
        rows.bytesPerRow(bytes: 64);
        queue.writeTexture(destination: TexelCopyTextureInfo.make(texture: copy dfg), data: bytes.view(), layout: rows,
                           size: Extent3D.of(width: 16, height: 16, depthOrArrayLayers: 1));
        this.dfgView = dfg.createView(descriptor: TextureViewDescriptor.make());
        SamplerDescriptor sampling = SamplerDescriptor.make();
        sampling.filters(mag: FilterMode::Linear, min: FilterMode::Linear, mipmap: MipmapFilterMode::Nearest);
        sampling.label(text: "the DFG table's sampler");
        this.dfgSampling = device.createSampler(descriptor: give sampling);
        this.sources = DynamicArray.empty();
        this.flipped = DynamicArray.empty();
        this.drawnAt = DynamicArray.empty();
        this.pipelines = DynamicArray.empty();
        this.prepasses = DynamicArray.empty();
        this.generalOf = DynamicArray.empty();
        this.generalSources = DynamicArray.empty();
        this.generalAt = DynamicArray.empty();
        this.generalShaded = DynamicArray.empty();
        this.generalDepth = DynamicArray.empty();
        this.generalStandIn = DynamicArray.empty();
        BindGroupLayoutDescriptor o = BindGroupLayoutDescriptor.make();
        o.entry(binding: 0, visibility: ShaderStage::Fragment, layout: BindingLayout::Texture(layout: TextureBindingLayout.make()));
        o.label(text: "the output pass's scene");
        this.outputLayout = device.createBindGroupLayout(descriptor: give o);
        PipelineLayoutDescriptor outputGroups = PipelineLayoutDescriptor.make();
        outputGroups.group(layout: copy this.outputLayout);
        outputGroups.label(text: "the output pass's group");
        this.outputPipelineLayout = device.createPipelineLayout(descriptor: give outputGroups);
        BindGroupLayoutDescriptor withTable = BindGroupLayoutDescriptor.make();
        withTable.entry(binding: 0, visibility: ShaderStage::Fragment, layout: BindingLayout::Texture(layout: TextureBindingLayout.make()));
        TextureBindingLayout cube = TextureBindingLayout.make();
        cube.viewDimension = TextureViewDimension::D3;
        withTable.entry(binding: 1, visibility: ShaderStage::Fragment, layout: BindingLayout::Texture(layout: cube));
        withTable.label(text: "the output pass's scene and Blender's AgX table");
        this.tableLayout = device.createBindGroupLayout(descriptor: give withTable);
        PipelineLayoutDescriptor tableGroups = PipelineLayoutDescriptor.make();
        tableGroups.group(layout: copy this.tableLayout);
        tableGroups.label(text: "the output pass's group, with Blender's AgX table");
        this.tablePipelineLayout = device.createPipelineLayout(descriptor: give tableGroups);
        // the tone-mapped resolve's: the multisampled scene, its samples read as unfilterable floats, as core WebGPU
        // reads a multisampled texture
        BindGroupLayoutDescriptor stored = BindGroupLayoutDescriptor.make();
        TextureBindingLayout everySample = TextureBindingLayout.make();
        everySample.sampleType = TextureSampleType::UnfilterableFloat;
        everySample.multisampled = true;
        stored.entry(binding: 0, visibility: ShaderStage::Fragment, layout: BindingLayout::Texture(layout: everySample));
        stored.label(text: "the tone-mapped resolve's samples");
        this.resolveLayout = device.createBindGroupLayout(descriptor: give stored);
        PipelineLayoutDescriptor resolveGroups = PipelineLayoutDescriptor.make();
        resolveGroups.group(layout: copy this.resolveLayout);
        resolveGroups.label(text: "the tone-mapped resolve's group");
        this.resolvePipelineLayout = device.createPipelineLayout(descriptor: give resolveGroups);
        this.outputCurves = DynamicArray.empty();
        this.outputs = DynamicArray.empty();
        Shared<PipelineSlot> resolve = new PipelineSlot.make(what: "the tone-mapped resolve's pipeline was refused by the device, so the GPU resolves instead: ",
                                                             kind: GraphicsErrorKind::Pipeline);
        this.resolving = give resolve;
        BindGroupLayoutDescriptor read = BindGroupLayoutDescriptor.make();
        read.entry(binding: 0, visibility: ShaderStage::Fragment, layout: BindingLayout::Texture(layout: TextureBindingLayout.make()));
        read.label(text: "the window read's frame");
        this.blitLayout = device.createBindGroupLayout(descriptor: give read);
        PipelineLayoutDescriptor readGroups = PipelineLayoutDescriptor.make();
        readGroups.group(layout: copy this.blitLayout);
        readGroups.label(text: "the window read's group");
        this.blitPipelineLayout = device.createPipelineLayout(descriptor: give readGroups);
        this.outputFormats = DynamicArray.empty();
        this.blitFormats = DynamicArray.empty();
        this.blits = DynamicArray.empty();
        this.device = give device;
        this.queue = give queue;
    }
}

// What a window read waits on, shared by the read and its renderer, which holds it weakly (kyoten's rendering.md §
// Decided, GFX-1's part 6, step 1's third question): waiting until the next render that draws into the window copies its
// frame out, then that copy's map, or why there will be none.
type resource FrameCapture {
    Optional<CopiedFrame> copied = Optional::None;
    string failure = "";

    friend Renderer[make, fill, fail, waiting];
    friend PixelRead[answer];

    ctor make() { }
    const fn bool waiting() { return this.copied.isNone() && this.failure.isEmpty(); }
    fn void fill(CopiedFrame copied) { this.copied = Optional::Some(value: give copied); }
    fn void fail(string words) {
        if (this.waiting()) { this.failure = give words; } else { string later = give words; }
    }
    unsafe fn PixelStatus answer() {
        if (!this.failure.isEmpty()) { return PixelStatus::Failed(error: GpuError::Refused(words: copy this.failure)); }
        match (this.copied) {
            case Some(value: f): { return f.poll(); }
            case None: { return PixelStatus::Pending; }
        };
    }
}

type resource Renderer {
    // What the device makes: at once by `withDevice`, and for a renderer made with a window, once its device answers.
    Optional<RendererGpu> gpu = Optional::None;
    Color clearTo = Color.fromHex(hex: 0x000000);
    float32 alpha = 1.0;
    RenderInfo last = RenderInfo.of(calls: 0, triangles: 0, objects: 0, matrices: 0, misses: 0, skipped: 0, general: 0, standIn: 0,
                                    waited: 0);
    // How a render anti-aliases (antialiasing.kama; kyoten's rendering.md § Decided, part 4's question 1 and the owner's
    // (A) of 2026-11-18): 4x MSAA by default, the one count above 1 WebGPU guarantees on every device, resolved by the
    // tone-mapped resolve, the ladder's best rung. Its samples a texel are what the pipelines and a target's
    // multisampled textures are made at. Set by `antialiasingMut()` or by `applyQuality` (quality.kama), which will take
    // the next method down where the device lacks one once a method a device may lack exists (GFX-19).
    Antialiasing method = Antialiasing::Msaa4ToneMapped;
    // What a draw does while its pipelines compile (`WhileCompiling`; kyoten's rendering.md § Decided, GFX-1's part 5,
    // question 1): the material's general form by default, a draw never waiting.
    WhileCompiling way = WhileCompiling::General;
    // What a draw under `WhileCompiling::StandIn` is drawn with (kyoten's rendering.md § Decided, GFX-1's part 5, step 3's
    // question 2): the library's lit grey by default, which a program replaces.
    Shared<Material> standing;
    bool printing = true;                       // printErrors
    DynamicArray<GraphicsErrorReport> errors = DynamicArray.empty();   // the misuses refused since the last takeErrors, at most KEPT
    int64 overflow = 0;                         // those past KEPT, counted
    DynamicArray<DeferredCompile> deferred = DynamicArray.empty();     // compiles asked before the GPU, asked once it is
    // When the window's frames reach the screen (kyoten's rendering.md § Decided, GFX-1's part 6, step 1's question 2):
    // Fifo, vsync, by default, as every peer's.
    PresentMode present = PresentMode::Fifo;

    // The window's, for a renderer made with `make(window:, options:)`; none for one made `withDevice`.
    Optional<NativeWindow> onWindow = Optional::None;   // the window's size in pixels, as of the program's last pump()
    Optional<Instance> instance = Optional::None;
    Optional<Surface> surface = Optional::None;
    RendererOptions requested = RendererOptions.defaults();
    Optional<AdapterRequest> adapterAsked = Optional::None;
    Optional<DeviceRequest> deviceAsked = Optional::None;
    Optional<SurfaceCapabilities> offered = Optional::None;   // what the surface offers the adapter, read when it answers
    string startWords = "";                       // why the window has no surface, reported at the first render
    bool noGpu = false;                           // the GPU never came, reported once: renders draw nothing for good
    bool configured = false;                      // the surface is configured, at this size and present mode
    int32 configuredWidth = 0;
    int32 configuredHeight = 0;
    PresentMode configuredMode = PresentMode::Fifo;
    TextureFormat windowView = TextureFormat::BGRA8UnormSrgb;   // the format the window is drawn through, once configured
    Optional<PresentMode> toldOf = Optional::None;   // a present mode the surface does not offer, reported once
    string windowTold = "";                       // the last refusal of the window reported, so a repeat is not
    DynamicArray<Weak<FrameCapture>> captures = DynamicArray.empty();   // the window reads asked, for the next frame

    // A renderer on a device the program already has, with its queue: each a handle of its own, so the program keeps
    // its own (`copy device`) and several renderers share one device. It has no window: a camera names a target.
    public unsafe ctor withDevice(Device device, Queue queue) {
        this.gpu = Optional::Some(value: RendererGpu.make(device: give device, queue: give queue));
        Shared<MeshStandardMaterial> grey = new MeshStandardMaterial.make();
        grey.colorMut() = Color.fromHex(hex: 0x808080);
        this.standing = give grey;
    }

    // A renderer that draws into `window` and requests its own GPU, as `options` say (kyoten's rendering.md § Decided,
    // GFX-1's part 1, question 1, and part 6, step 1): it makes a surface on the window, which holds it, and asks for an
    // adapter that can present to it. Each render polls the request, then asks for the device; until the device has
    // answered a render draws nothing and reports nothing, and a request that fails is reported once, at a render. A
    // camera naming no target draws into the window.
    public unsafe ctor make(const ref Window window, RendererOptions options) {
        Shared<MeshStandardMaterial> grey = new MeshStandardMaterial.make();
        grey.colorMut() = Color.fromHex(hex: 0x808080);
        this.standing = give grey;
        this.requested = options;
        this.onWindow = Optional::Some(value: window.nativeHandle());
        Result<Instance, GpuError> made = Instance.make();
        match (give made) {
            case Ok(value: inst): {
                Result<Surface, GpuError> onIt = Surface.make(instance: inst, window: window);
                match (give onIt) {
                    case Ok(value: s): {
                        AdapterOptions wanted = AdapterOptions.withSurface(surface: s, power: options.power);
                        wanted.forceFallbackAdapter(on: options.forceFallbackAdapter);
                        this.adapterAsked = Optional::Some(value: inst.requestAdapter(options: wanted));
                        this.surface = Optional::Some(value: give s);
                    }
                    case Err(error: e): { this.startWords = "the renderer draws nothing: no surface on its window: " + e.message(); }
                };
                this.instance = Optional::Some(value: give inst);
            }
            case Err(error: e): { this.startWords = "the renderer draws nothing: no WebGPU instance: " + e.message(); }
        };
    }

    // Each window read the renderer still holds fails, so none waits for ever.
    unsafe ~Renderer() {
        for (isize i = 0; i < this.captures.length(); i = i + 1) {
            Optional<Shared<FrameCapture>> held = this.captures[i].tryUpgrade();
            match (give held) {
                case Some(value: c): { c.derefMut().fail(words: "the renderer was dropped before it drew a frame into its window"); }
                case None: { }
            };
        }
    }

    // A render's start, for a renderer made with a window: its adapter request polled, then its device asked for and
    // polled, and once the device answers, what it makes made and the compiles asked before it asked for. Its failure is
    // reported once, and the renderer then draws nothing for good.
    unsafe fn void start() {
        if (this.gpu.isSome() || this.noGpu) { return; }
        if (!this.startWords.isEmpty()) {
            string why = copy this.startWords;
            this.giveUp(kind: GraphicsErrorKind::Window, words: give why);
            return;
        }
        if (this.adapterAsked.isSome()) {
            AdapterStatus s = match (this.adapterAsked) { case Some(value: r): r.poll(); case None: AdapterStatus::Failed(error: GpuError::Taken); };
            bool pending = match (s) { case Pending: true; case _: false; };
            if (pending) { return; }
            this.adapterAsked = Optional::None;
            match (give s) {
                case Ready(adapter: a): {
                    Result<SurfaceCapabilities, GpuError> caps = match (this.surface) {
                        case Some(value: w): w.capabilities(adapter: a);
                        case None: Result::Err(error: GpuError::Taken);
                    };
                    match (give caps) {
                        case Ok(value: c): { this.offered = Optional::Some(value: give c); }
                        case Err(error: e): {
                            this.giveUp(kind: GraphicsErrorKind::Window, words: "the renderer draws nothing: the adapter cannot draw into its window: " + e.message());
                            return;
                        }
                    };
                    DeviceOptions device = this.requested.device;
                    this.deviceAsked = Optional::Some(value: a.requestDevice(options: device));
                }
                case Failed(error: e): {
                    this.giveUp(kind: GraphicsErrorKind::Device, words: "the renderer draws nothing: no adapter: " + e.message());
                    return;
                }
                case Pending: { }
            };
        }
        if (this.deviceAsked.isNone()) { return; }
        DeviceStatus d = match (this.deviceAsked) { case Some(value: r): r.poll(); case None: DeviceStatus::Failed(error: GpuError::Taken); };
        bool waiting = match (d) { case Pending: true; case _: false; };
        if (waiting) { return; }
        this.deviceAsked = Optional::None;
        match (give d) {
            case Ready(device: dev, queue: q): {
                RendererGpu made = RendererGpu.make(device: give dev, queue: give q);
                this.askDeferred(gpu: ref made);
                this.gpu = Optional::Some(value: give made);
            }
            case Failed(error: e): {
                this.giveUp(kind: GraphicsErrorKind::Device, words: "the renderer draws nothing: the device was refused: " + e.message());
            }
            case Pending: { }
        };
    }

    // The GPU never comes: reported once; the compiles waiting on it answer, having asked for nothing; the window reads
    // fail.
    unsafe fn void giveUp(GraphicsErrorKind kind, string words) {
        this.noGpu = true;
        this.refuse(kind: kind, message: copy words);
        DynamicArray<DeferredCompile> none = DynamicArray.empty();
        DynamicArray<DeferredCompile> waiting = replace(place: this.deferred, with: give none);
        for (isize i = 0; i < waiting.length(); i = i + 1) {
            Shared<CompileSlots> state = copy waiting[i].state;
            state.derefMut().fill(slots: DynamicArray.empty());
        }
        this.failCaptures(words: give words);
    }

    unsafe fn void failCaptures(string words) {
        for (isize i = 0; i < this.captures.length(); i = i + 1) {
            Optional<Shared<FrameCapture>> held = this.captures[i].tryUpgrade();
            match (give held) { case Some(value: c): { c.derefMut().fail(words: copy words); } case None: { } };
        }
        this.captures.clear();
    }

    // The compiles asked before the GPU, asked for now that it has answered.
    unsafe fn void askDeferred(ref RendererGpu gpu) {
        DynamicArray<DeferredCompile> none = DynamicArray.empty();
        DynamicArray<DeferredCompile> waiting = replace(place: this.deferred, with: give none);
        for (isize i = 0; i < waiting.length(); i = i + 1) {
            Shared<Scene> scene = copy waiting[i].scene;
            Shared<PerspectiveCamera> camera = copy waiting[i].camera;
            Shared<CompileSlots> state = copy waiting[i].state;
            DynamicArray<Shared<PipelineSlot>> slots = this.compileOn(gpu: ref gpu, scene: give scene, camera: give camera);
            state.derefMut().fill(slots: give slots);
        }
    }

    // The window's configuration with present mode `mode`, from what its surface offers: the first format with an sRGB
    // view, drawn through it, as every peer draws a window (step 1's details); an opaque window where the surface offers
    // one; the frame a render attachment alone (step 1's third question, Bevy's way). None when the surface offers no
    // 8-bit sRGB format, which no surface measured does.
    const fn Optional<SurfaceConfig> windowConfig(PresentMode mode) {
        return match (this.offered) {
            case Some(value: caps): configFrom(caps: caps, mode: mode);
            case None: Optional::None;
        };
    }

    // The present mode a configure takes: the renderer's, when the surface offers it, else Fifo, every surface's, the
    // mode not offered reported once (step 1's question 2).
    unsafe fn PresentMode presentInEffect() {
        PresentMode mode = this.present;
        if (this.supportsPresentMode(mode: mode)) {
            this.toldOf = Optional::None;
            return mode;
        }
        bool told = match (this.toldOf) { case Some(value: m): m == mode; case None: false; };
        if (!told) {
            string name = mode.name();
            this.refuse(kind: GraphicsErrorKind::Window,
                        message: "the window's surface does not offer present mode " + name + ", so it presents with Fifo");
            this.toldOf = Optional::Some(value: mode);
        }
        return PresentMode::Fifo;
    }

    // A refusal of the window reported, unless it is the one reported last.
    unsafe fn void refuseWindow(string words) {
        if (words == this.windowTold) { return; }
        this.windowTold = copy words;
        this.refuse(kind: GraphicsErrorKind::Window, message: give words);
    }

    // The window's surface configured at the window's size as of the program's last pump() and the present mode in
    // effect, when either differs from what it was configured with: whether a frame can be drawn. A window of no area
    // (minimised) or a closed one draws nothing and reports nothing; anything else the surface refuses is reported.
    unsafe fn bool configureWindow(ref RendererGpu gpu) {
        Size px = match (this.onWindow) { case Some(value: n): n.framebufferSize(); case None: Size.of(width: 0, height: 0); };
        if (px.width <= 0 || px.height <= 0) { return false; }
        PresentMode mode = this.presentInEffect();
        if (this.configured && px.width == this.configuredWidth && px.height == this.configuredHeight && mode == this.configuredMode) {
            return true;
        }
        Optional<SurfaceConfig> wanted = this.windowConfig(mode: mode);
        SurfaceConfig config = match (wanted) {
            case Some(value: c): c;
            case None: {
                this.refuseWindow(words: "the renderer draws nothing into its window: its surface offers no 8-bit sRGB format");
                return false;
            }
        };
        Result<Unit, ConfigureError> done = match (this.surface) {
            case Some(value: s): s.configure(device: gpu.device, config: config);
            case None: Result::Err(error: ConfigureError::Closed);
        };
        match (done) {
            case Ok(value: u): { }
            case Err(error: e): {
                this.configured = false;
                match (e) {
                    case NoArea: { return false; }
                    case Closed: { return false; }
                    case _: {
                        string why = e.message();
                        this.refuseWindow(words: "the window's surface refused its configuration, so nothing is drawn into it: " + why);
                        return false;
                    }
                };
            }
        };
        this.configured = true;
        this.windowView = config.viewFormat;
        this.configuredWidth = px.width;
        this.configuredHeight = px.height;
        this.configuredMode = mode;
        return true;
    }

    // The window's next frame, its surface configured again once when it is out of date or lost; None when there is none
    // to draw into this render. A frame the surface failed to give is reported.
    unsafe fn Optional<SurfaceTexture> acquireWindow(ref RendererGpu gpu) {
        for (int32 attempt = 0; attempt < 2; attempt = attempt + 1) {
            Result<SurfaceTexture, SurfaceError> got = match (this.surface) {
                case Some(value: s): s.acquire();
                case None: Result::Err(error: SurfaceError::Closed);
            };
            match (give got) {
                case Ok(value: f): { return Optional::Some(value: give f); }
                case Err(error: e): {
                    bool again = match (e) { case Outdated: true; case Lost: true; case _: false; };
                    if (!again) {
                        match (e) {
                            case Failed: { this.refuseWindow(words: "the window's surface gave no frame, so nothing was drawn into it: " + e.message()); }
                            case _: { }
                        };
                        return Optional::None;
                    }
                    this.configured = false;
                    if (!this.configureWindow(gpu: ref gpu)) { return Optional::None; }
                }
            };
        }
        return Optional::None;
    }

    // The window's textures at `width` by `height`: a target's without its colour, made again at a new size.
    unsafe fn Shared<RenderTarget> windowTargetAt(ref RendererGpu gpu, uint32 width, uint32 height) {
        bool fits = match (gpu.windowTarget) {
            case Some(value: t): t.width() == width && t.height() == height;
            case None: false;
        };
        if (!fits) {
            Shared<RenderTarget> made = new RenderTarget.forWindow(width: width, height: height);
            gpu.windowTarget = Optional::Some(value: give made);
        }
        return match (gpu.windowTarget) { case Some(value: t): copy t; case None: { panic(msg: "made above"); } };
    }

    // The window read's pass onto the window for `format`: its slot, added the first time, none asked for yet.
    unsafe fn isize blitFor(ref RendererGpu gpu, TextureFormat format) {
        for (isize i = 0; i < gpu.blitFormats.length(); i = i + 1) {
            if (gpu.blitFormats[i] == format) { return i; }
        }
        Shared<PipelineSlot> slot = new PipelineSlot.make(what: "the window read's pass onto the window was refused by the device, so a window read fails: ",
                                                          kind: GraphicsErrorKind::Pipeline);
        gpu.blitFormats.add(item: format);
        gpu.blits.add(item: give slot);
        return gpu.blits.length() - 1;
    }

    unsafe fn RenderPipelineDescriptor blitDescriptor(ref RendererGpu gpu, TextureFormat format) {
        ShaderModuleDescriptor described = ShaderModuleDescriptor.make(wgsl: blitWgsl());
        described.label(text: "the window read's pass onto the window");
        ShaderModule shader = gpu.device.createShaderModule(descriptor: give described);
        FragmentState fragment = FragmentState.make(module: copy shader, entryPoint: "fs");
        fragment.target(state: ColorTargetState.make(format: format));
        RenderPipelineDescriptor pipeline = RenderPipelineDescriptor.make(layout: Layout::Explicit(layout: copy gpu.blitPipelineLayout),
                                                                          vertex: VertexState.make(module: give shader, entryPoint: "vs"));
        pipeline.fragment(state: give fragment);
        pipeline.label(text: "the window read's pass onto the window");
        return pipeline;
    }

    // Slot `b`'s pass onto the window: asked for off the frame if it is still wanted, or, `now`, made during this render.
    unsafe fn int32 provideBlit(ref RendererGpu gpu, isize b, TextureFormat format, bool now) {
        Shared<PipelineSlot> slot = copy gpu.blits[b];
        if (slot.ready() || slot.refusedNow()) { return 0; }
        if (now) {
            RenderPipelineDescriptor d = this.blitDescriptor(gpu: ref gpu, format: format);
            slot.makeNow(device: ref gpu.device, descriptor: give d);
            return 1;
        }
        if (slot.wanted()) {
            RenderPipelineDescriptor d = this.blitDescriptor(gpu: ref gpu, format: format);
            slot.ask(device: ref gpu.device, descriptor: give d);
        }
        return 0;
    }

    // The window reads still held, the dropped ones let go.
    unsafe fn DynamicArray<Shared<FrameCapture>> heldCaptures() {
        DynamicArray<Shared<FrameCapture>> held = DynamicArray.empty();
        for (isize i = 0; i < this.captures.length(); i = i + 1) {
            Optional<Shared<FrameCapture>> c = this.captures[i].tryUpgrade();
            match (give c) { case Some(value: x): { held.add(item: give x); } case None: { } };
        }
        return held;
    }

    // When the window's frames reach the screen (@kama/gpu's `PresentMode`): Fifo, vsync, by default. A property pair, as
    // `clearColor`; a change takes effect at the next render, which configures the window's surface again. A mode the
    // surface does not offer is reported once, at a render, and Fifo, which every surface offers, is taken instead;
    // `presentMode()` still says what was set, as `antialiasing()` does.
    public const fn PresentMode presentMode() { return this.present; }
    public fn ref PresentMode presentModeMut() { return this.present; }

    // Whether the window's surface offers `mode`: answered from what it offers the adapter, once the adapter has
    // answered. Before then, and on a renderer with no window, Fifo alone, which every surface offers. On the web, Fifo
    // alone.
    public unsafe const fn bool supportsPresentMode(PresentMode mode) {
        if (mode == PresentMode::Fifo) { return true; }
        return match (this.offered) { case Some(value: caps): offersMode(caps: caps, mode: mode); case None: false; };
    }

    // Start reading what the window shows (kyoten's rendering.md § Decided, GFX-1's part 6, step 1's third question):
    // poll the read until it hands back the image of the next frame a render draws into the window, in device pixels,
    // 8-bit RGBA, sRGB, top row first, as a target's read hands back. A render that draws nothing into the window leaves
    // it pending. Reads asked before one render are each that frame. The renderer holds a read weakly, so a read dropped
    // before its frame costs nothing; a renderer dropped first, one with no window and one whose GPU never came each
    // fail the read, with words of their own.
    public unsafe fn PixelRead readWindowPixels() {
        Shared<FrameCapture> made = new FrameCapture.make();
        if (this.onWindow.isNone()) {
            made.derefMut().fail(words: "the renderer has no window: a camera names a render target, read with readRenderTargetPixels");
        } else if (this.noGpu) {
            made.derefMut().fail(words: "the renderer has no GPU, so it draws nothing into its window");
        } else {
            this.captures.add(item: made.downgrade());
        }
        return PixelRead.ofWindow(capture: give made);
    }

    // Ask for every pipeline `scene` needs as `camera` sees it, off the frame (kyoten's rendering.md § Decided, GFX-1's
    // part 5, question 1), as three.js's `compileAsync` and Unreal's precaching: each mesh's two at the anti-aliasing
    // method's samples a texel, and, where its way (its own, else the renderer's) is `WhileCompiling::General`, its
    // material's general form's two, so a variant new at run time draws by it; the stand-in's general form's two, once,
    // where any mesh's way is `StandIn`; the tone-mapped resolve's when the method takes it, and the output pass's for the
    // camera's tone mapping when its target is 8-bit, or for the window's format, with the window read's pass onto the
    // window, when the camera draws into the window. The scene is placed as a render places it. Poll the request until it
    // is `Ready`: a render then draws everything with no miss, while nothing new joins the scene and the method and the
    // camera's tone mapping stay as they were. A loading screen polls it, and so does a test before it renders. Asked
    // before a renderer made with a window has its GPU, it is asked for by the first render that finds the GPU, and is
    // `Pending` until then.
    public unsafe fn CompileRequest compile(Shared<Scene> scene, Shared<PerspectiveCamera> camera) {
        Optional<RendererGpu> taken = replace(place: this.gpu, with: Optional::None);
        match (give taken) {
            case Some(value: g): {
                RendererGpu half = give g;
                DynamicArray<Shared<PipelineSlot>> slots = this.compileOn(gpu: ref half, scene: give scene, camera: give camera);
                this.gpu = Optional::Some(value: give half);
                Shared<CompileSlots> state = new CompileSlots.make(slots: give slots, asked: true);
                return CompileRequest.make(state: give state);
            }
            case None: {
                Shared<CompileSlots> state = new CompileSlots.make(slots: DynamicArray.empty(), asked: this.noGpu);
                if (!this.noGpu) {
                    this.deferred.add(item: DeferredCompile.make(scene: give scene, camera: give camera, state: copy state));
                } else {
                    Shared<Scene> unused = give scene;
                    Shared<PerspectiveCamera> unseen = give camera;
                }
                return CompileRequest.make(state: give state);
            }
        };
    }

    // Draw `scene` as `camera` sees it, into the target the camera names, or with none into the window.
    public unsafe fn void render(Shared<Scene> scene, Shared<PerspectiveCamera> camera) {
        this.start();
        Optional<RendererGpu> taken = replace(place: this.gpu, with: Optional::None);
        match (give taken) {
            case Some(value: g): {
                RendererGpu half = give g;
                this.renderOn(gpu: ref half, scene: give scene, camera: give camera);
                this.gpu = Optional::Some(value: give half);
            }
            case None: {
                Shared<Scene> unused = give scene;
                Shared<PerspectiveCamera> unseen = give camera;
                this.last = RenderInfo.of(calls: 0, triangles: 0, objects: 0, matrices: 0, misses: 0, skipped: 0, general: 0,
                                          standIn: 0, waited: 0);
            }
        };
    }

    // Fill the target with the clear colour. On the default 8-bit sRGB target it reads back as written: a target
    // cleared to #336699 reads 0x33 0x66 0x99. Before a renderer made with a window has its GPU, nothing.
    public unsafe fn void clear(Shared<RenderTarget> target) {
        Optional<RendererGpu> taken = replace(place: this.gpu, with: Optional::None);
        match (give taken) {
            case Some(value: g): {
                RendererGpu half = give g;
                this.clearOn(gpu: ref half, target: give target);
                this.gpu = Optional::Some(value: give half);
            }
            case None: { Shared<RenderTarget> unused = give target; }
        };
    }

    // Start reading the target back, as three.js's `readRenderTargetPixelsAsync`: poll the read until it hands back its
    // image, the target's size in 8-bit RGBA, sRGB, top row first. Before a renderer made with a window has its GPU,
    // there is nothing to read, and the read fails.
    public unsafe fn PixelRead readRenderTargetPixels(Shared<RenderTarget> target) {
        Optional<RendererGpu> taken = replace(place: this.gpu, with: Optional::None);
        match (give taken) {
            case Some(value: g): {
                RendererGpu half = give g;
                PixelRead read = this.readTargetOn(gpu: ref half, target: give target);
                this.gpu = Optional::Some(value: give half);
                return read;
            }
            case None: {
                Shared<RenderTarget> unused = give target;
                return PixelRead.failed(words: "the renderer has no GPU yet, so it has drawn nothing into the target");
            }
        };
    }

    // The colour `clear` and `render` fill a target with, written in sRGB: black, as three.js's.
    public const fn Color clearColor() { return this.clearTo; }
    public fn ref Color clearColorMut() { return this.clearTo; }

    // Its alpha, 0 to 1, which is never sRGB-encoded: 1, as three.js's.
    public const fn float32 clearAlpha() { return this.alpha; }
    public fn ref float32 clearAlphaMut() { return this.alpha; }

    // How the renderer anti-aliases what it draws (antialiasing.kama): `Antialiasing::Msaa4ToneMapped` by default. A
    // property pair, as `clearColor`; a change takes effect at the next render.
    public const fn Antialiasing antialiasing() { return this.method; }
    public fn ref Antialiasing antialiasingMut() { return this.method; }

    // The quality in effect (quality.kama): every technique's setting as the next render draws it, made from the settings
    // at each call, so a technique set directly, as by `antialiasingMut()`, reads back here too. Each technique's own
    // getter says what was set, the same today; they can differ only once a method a device may lack exists (8x MSAA
    // natively, GFX-19), where a method set directly that the device lacks reads back from its getter as set, and here
    // as drawn.
    public const fn Quality quality() { return Quality.of(antialiasing: this.method); }

    // Every technique set from `quality` at once (quality.kama), and the quality in effect handed back, which a program
    // compares with what it asked for. A change takes effect at the next render, as each technique's own pair's does.
    // Where the device lacks a method, the next one down is taken, and the technique's `supports…` query says why the
    // two differ: that comes with the first method a device may lack (GFX-19), since every method on each ladder today
    // is core WebGPU. Nothing is printed, since a weaker device stepping down is no misuse.
    public fn Quality applyQuality(Quality quality) {
        this.method = quality.antialiasing;
        return this.quality();
    }

    // Whether this renderer's device can draw with `method` (antialiasing.kama), by the rule `applyQuality` steps down by:
    // true for every method today, each core WebGPU on every device. A method a device may lack answers from the device,
    // the first being 8x MSAA natively (GFX-19). The raw features stay `@kama/gpu`'s `device.features()`.
    public const fn bool supportsAntialiasing(Antialiasing method) {
        return match (method) { case Msaa4ToneMapped: true; case Msaa4: true; case None: true; };
    }

    // What a draw does while its pipelines compile (`WhileCompiling`): `General` by default. A property pair, as
    // `clearColor`; a change takes effect at the next render.
    public const fn WhileCompiling whileCompiling() { return this.way; }
    public fn ref WhileCompiling whileCompilingMut() { return this.way; }

    // What a draw under `WhileCompiling::StandIn` is drawn with while its own pipelines compile: a `MeshStandardMaterial`
    // of #808080, roughness 1 and metalness 0, lit by the scene. A property pair, as `clearColor`; a change takes effect
    // at the next render.
    public unsafe const fn Shared<Material> standIn() { return copy this.standing; }
    public fn ref Shared<Material> standInMut() { return this.standing; }

    // `compile`'s pipelines, asked for on the GPU's half (see `compile`).
    unsafe fn DynamicArray<Shared<PipelineSlot>> compileOn(ref RendererGpu gpu, Shared<Scene> scene, Shared<PerspectiveCamera> camera) {
        this.settleAll(gpu: ref gpu);
        Walk walk = scene.walkAll();
        DynamicArray<string> found = walk.refusals();
        for (isize i = 0; i < found.length(); i = i + 1) { this.refuse(kind: GraphicsErrorKind::Light, message: copy found[i]); }
        uint32 perTexel = samplesOf(method: this.method);
        DynamicArray<Shared<PipelineSlot>> asked = DynamicArray.empty();
        bool standInWanted = false;
        DynamicArray<isize> slots = scene.drawSlots();
        for (isize i = 0; i < slots.length(); i = i + 1) {
            isize slot = slots[i];
            Shared<Material> material = scene.materialAt(slot: slot);
            uint32 graph = material.graphVersion();
            if (!material.gpuMut().compiledAt(graph: graph)) { this.compileNodes(material: copy material); }
            DynamicArray<string> refused = material.gpuMut().refused();
            if (refused.length() > 0) { continue; }
            // the draw's way: its mesh's, else the renderer's
            WhileCompiling drawWay = match (scene.wayAt(slot: slot)) { case Some(value: w): w; case None: this.way; };
            if (drawWay == WhileCompiling::StandIn) { standInWanted = true; }
            string source = material.gpuMut().source();
            string general = material.gpuMut().generalSource();
            isize e = this.pipelineFor(gpu: ref gpu, source: source, general: general, mirrored: scene.mirroredAt(slot: slot), count: perTexel);
            int32 madeNone = this.provide(gpu: ref gpu, i: e, now: false);
            asked.add(item: copy gpu.pipelines[e]);
            asked.add(item: copy gpu.prepasses[e]);
            if (drawWay == WhileCompiling::General) {
                isize g = gpu.generalOf[e];
                this.provideGeneral(gpu: ref gpu, g: g);
                asked.add(item: copy gpu.generalShaded[g]);
                asked.add(item: copy gpu.generalDepth[g]);
            }
        }
        // the stand-in's general form, once, when any draw's way is `StandIn`
        if (standInWanted) {
            isize g = this.standInEntry(gpu: ref gpu, count: perTexel);
            if (g >= 0) {
                this.provideGeneral(gpu: ref gpu, g: g);
                asked.add(item: copy gpu.generalShaded[g]);
                asked.add(item: copy gpu.generalDepth[g]);
            }
        }
        if (this.method == Antialiasing::Msaa4ToneMapped) {
            int32 resolveMadeNone = this.provideResolve(gpu: ref gpu, now: false);
            asked.add(item: copy gpu.resolving);
        }
        Optional<Shared<RenderTarget>> named = camera.target();
        ToneMapping curve = camera.toneMapping();
        match (give named) {
            case Some(value: t): {
                if (!t.holdsScene()) {
                    isize o = this.outputFor(gpu: ref gpu, curve: curve, format: TextureFormat::RGBA8UnormSrgb);
                    int32 outputMadeNone = this.provideOutput(gpu: ref gpu, o: o, curve: curve, format: TextureFormat::RGBA8UnormSrgb,
                                                              now: false);
                    asked.add(item: copy gpu.outputs[o]);
                }
            }
            case None: {
                // into the window: the output pass at the window's view format, and the window read's pass onto it
                Optional<SurfaceConfig> config = this.windowConfig(mode: PresentMode::Fifo);
                match (config) {
                    case Some(value: c): {
                        TextureFormat view = c.viewFormat;
                        isize o = this.outputFor(gpu: ref gpu, curve: curve, format: view);
                        int32 outputMadeNone = this.provideOutput(gpu: ref gpu, o: o, curve: curve, format: view, now: false);
                        asked.add(item: copy gpu.outputs[o]);
                        isize b = this.blitFor(gpu: ref gpu, format: view);
                        int32 blitMadeNone = this.provideBlit(gpu: ref gpu, b: b, format: view, now: false);
                        asked.add(item: copy gpu.blits[b]);
                    }
                    case None: { }
                };
            }
        };
        return asked;
    }

    // Every pipeline's request polled, once, at the start of a render (and of a compile and `takeErrors()`), before any
    // draw asks for one, so a render never draws with a pipeline it asked for itself, even where natively @kama/gpu's
    // own threads answer before a later draw sharing it. What a draw asks for is polled at the next render.
    unsafe fn void settleAll(ref RendererGpu gpu) {
        for (isize i = 0; i < gpu.pipelines.length(); i = i + 1) {
            Shared<PipelineSlot> shaded = copy gpu.pipelines[i];
            Shared<PipelineSlot> depth = copy gpu.prepasses[i];
            bool shadedAnswered = shaded.settle();
            bool depthAnswered = depth.settle();
        }
        for (isize i = 0; i < gpu.generalShaded.length(); i = i + 1) {
            Shared<PipelineSlot> shaded = copy gpu.generalShaded[i];
            Shared<PipelineSlot> depth = copy gpu.generalDepth[i];
            bool shadedAnswered = shaded.settle();
            bool depthAnswered = depth.settle();
        }
        for (isize i = 0; i < gpu.outputs.length(); i = i + 1) {
            Shared<PipelineSlot> slot = copy gpu.outputs[i];
            bool answered = slot.settle();
        }
        for (isize i = 0; i < gpu.blits.length(); i = i + 1) {
            Shared<PipelineSlot> slot = copy gpu.blits[i];
            bool answered = slot.settle();
        }
        bool resolveAnswered = gpu.resolving.settle();
    }

    // A pair's refusal, the shaded pipeline's and the depth-only one's, reported once, as the first of the two found, and
    // the other never: each answers on its own, natively on @kama/gpu's threads, so one may be found a poll before the
    // other, and both fail on the one material.
    unsafe fn void refusePair(Shared<PipelineSlot> shaded, Shared<PipelineSlot> depth) {
        string first = shaded.untold();
        if (!first.isEmpty()) {
            depth.silence();
            this.refuse(kind: shaded.kind(), message: copy first);
            return;
        }
        string second = depth.untold();
        if (!second.isEmpty()) {
            shaded.silence();
            this.refuse(kind: depth.kind(), message: copy second);
        }
    }

    // Each pipeline's refusal found since the last, reported once: a mesh's two as one, since both fail on its material,
    // whether they are found at one poll or two (`refusePair`). A render reports what it found as it ends, and
    // `takeErrors()` what a compile request found.
    unsafe fn void reportRefusals(ref RendererGpu gpu) {
        for (isize i = 0; i < gpu.pipelines.length(); i = i + 1) {
            this.refusePair(shaded: copy gpu.pipelines[i], depth: copy gpu.prepasses[i]);
        }
        // a general form's refusal, once its material's own pipelines are made, so a material the device refuses outright,
        // its general form too, is reported once, as its own pipeline's refusal
        for (isize i = 0; i < gpu.pipelines.length(); i = i + 1) {
            Shared<PipelineSlot> shadedOwn = copy gpu.pipelines[i];
            Shared<PipelineSlot> depthOwn = copy gpu.prepasses[i];
            if (!shadedOwn.ready() || !depthOwn.ready()) { continue; }
            isize g = gpu.generalOf[i];
            this.refusePair(shaded: copy gpu.generalShaded[g], depth: copy gpu.generalDepth[g]);
        }
        // a stand-in's general form, which its draws take alone, its own pipelines never asked for
        for (isize g = 0; g < gpu.generalShaded.length(); g = g + 1) {
            if (!gpu.generalStandIn[g]) { continue; }
            this.refusePair(shaded: copy gpu.generalShaded[g], depth: copy gpu.generalDepth[g]);
        }
        for (isize i = 0; i < gpu.outputs.length(); i = i + 1) {
            Shared<PipelineSlot> slot = copy gpu.outputs[i];
            string words = slot.untold();
            if (!words.isEmpty()) { this.refuse(kind: slot.kind(), message: copy words); }
        }
        for (isize i = 0; i < gpu.blits.length(); i = i + 1) {
            Shared<PipelineSlot> slot = copy gpu.blits[i];
            string words = slot.untold();
            if (!words.isEmpty()) { this.refuse(kind: slot.kind(), message: copy words); }
        }
        string resolveWords = gpu.resolving.untold();
        if (!resolveWords.isEmpty()) { this.refuse(kind: gpu.resolving.kind(), message: copy resolveWords); }
    }

    // What the last render did.
    public const fn RenderInfo info() { return this.last; }

    // Whether each misuse the renderer refuses is also printed to stderr as it happens: true, as @kama/gpu's
    // `DeviceOptions.printErrors`, so a misuse nobody reads is never silent. A program that reads `takeErrors()` itself
    // turns it off. A property pair, as `clearColor`, since the renderer's own errors never arise while it is made.
    public const fn bool printErrors() { return this.printing; }
    public fn ref bool printErrorsMut() { return this.printing; }

    // The misuses refused since the last call, the oldest first, with how many past the 64 kept were counted.
    public unsafe fn RendererErrors takeErrors() {
        Optional<RendererGpu> held = replace(place: this.gpu, with: Optional::None);
        match (give held) {
            case Some(value: g): {
                RendererGpu half = give g;
                this.settleAll(gpu: ref half);
                this.reportRefusals(gpu: ref half);
                this.gpu = Optional::Some(value: give half);
            }
            case None: { }
        };
        DynamicArray<GraphicsErrorReport> fresh = DynamicArray.empty();
        DynamicArray<GraphicsErrorReport> taken = replace(place: this.errors, with: give fresh);
        int64 counted = this.overflow;
        this.overflow = 0;
        return RendererErrors.make(reports: give taken, dropped: counted);
    }

    // A misuse refused: printed when the renderer prints, and kept while the record has room.
    unsafe fn void refuse(GraphicsErrorKind kind, string message) {
        if (this.printing) { printMisuse(words: message); }
        if (this.errors.length() < KEPT) {
            this.errors.add(item: GraphicsErrorReport.of(kind: kind, message: give message));
        } else {
            this.overflow = this.overflow + 1;
            string unkept = give message;
        }
    }

    // The clear colour as a render's scene holds it: linear, its light scaled by the camera's exposure as every material's
    // is, so the output pass tone maps it with the scene, as three.js r187 tone maps its cleared frame target.
    fn GpuColor clearingExposed(float32 scale) {
        float64 s = cast<float64>(scale);
        return GpuColor.of(r: cast<float64>(this.clearTo.linearR()) * s, g: cast<float64>(this.clearTo.linearG()) * s,
                           b: cast<float64>(this.clearTo.linearB()) * s, a: cast<float64>(this.alpha));
    }

    // The output pass's pipeline for `curve`, writing `format`, a target's or the window's view's: its slot, added the
    // first time, none asked for yet.
    unsafe fn isize outputFor(ref RendererGpu gpu, ToneMapping curve, TextureFormat format) {
        for (isize i = 0; i < gpu.outputCurves.length(); i = i + 1) {
            if (gpu.outputCurves[i] == curve && gpu.outputFormats[i] == format) { return i; }
        }
        Shared<PipelineSlot> slot = new PipelineSlot.make(what: "the output pass's pipeline was refused by the device, so the output pass is left out: ",
                                                          kind: GraphicsErrorKind::Pipeline);
        gpu.outputCurves.add(item: curve);
        gpu.outputFormats.add(item: format);
        gpu.outputs.add(item: give slot);
        return gpu.outputs.length() - 1;
    }

    unsafe fn RenderPipelineDescriptor outputDescriptor(ref RendererGpu gpu, ToneMapping curve, TextureFormat format) {
        ShaderModuleDescriptor described = ShaderModuleDescriptor.make(wgsl: outputWgsl(curve: curve));
        described.label(text: "the output pass");
        ShaderModule shader = gpu.device.createShaderModule(descriptor: give described);
        FragmentState fragment = FragmentState.make(module: copy shader, entryPoint: "fs");
        fragment.target(state: ColorTargetState.make(format: format));
        PipelineLayout groups = readsTable(curve: curve) ? copy gpu.tablePipelineLayout : copy gpu.outputPipelineLayout;
        RenderPipelineDescriptor pipeline = RenderPipelineDescriptor.make(layout: Layout::Explicit(layout: give groups),
                                                                          vertex: VertexState.make(module: give shader, entryPoint: "vs"));
        pipeline.fragment(state: give fragment);
        pipeline.label(text: "the output pass");
        return pipeline;
    }

    // Slot `o`'s output pass for `curve`: asked for off the frame if it is still wanted, or, `now`, made during this
    // render. How many pipelines it made now.
    unsafe fn int32 provideOutput(ref RendererGpu gpu, isize o, ToneMapping curve, TextureFormat format, bool now) {
        Shared<PipelineSlot> slot = copy gpu.outputs[o];
        if (slot.ready() || slot.refusedNow()) { return 0; }
        if (now) {
            RenderPipelineDescriptor d = this.outputDescriptor(gpu: ref gpu, curve: curve, format: format);
            slot.makeNow(device: ref gpu.device, descriptor: give d);
            return 1;
        }
        if (slot.wanted()) {
            RenderPipelineDescriptor d = this.outputDescriptor(gpu: ref gpu, curve: curve, format: format);
            slot.ask(device: ref gpu.device, descriptor: give d);
        }
        return 0;
    }

    // Blender's AgX table, made the first time a camera uses it (agx.kama): 57³ texels of four half floats, a 3D texture
    // the output pass reads at its grid points and interpolates itself, as OpenColorIO does.
    unsafe fn TextureView agxTable(ref RendererGpu gpu) {
        if (gpu.agxTableView.isNone()) {
            uint32 side = cast<uint32>(blenderAgxSize());
            TextureDescriptor made = TextureDescriptor.make(width: side, height: side, format: TextureFormat::RGBA16Float,
                                                            usage: TextureUsage::TextureBinding | TextureUsage::CopyDst);
            made.dimension(kind: TextureDimension::D3);
            made.depthOrArrayLayers(count: side);
            made.label(text: "Blender's AgX table");
            Texture table = gpu.device.createTexture(descriptor: give made);
            DynamicArray<uint16> halves = blenderAgxTable();
            DynamicArray<uint8> bytes = DynamicArray.empty();
            for (isize i = 0; i < halves.length(); i = i + 1) {
                bytes.add(item: truncate<uint8>(halves[i]));
                bytes.add(item: truncate<uint8>(halves[i] >> 8));
            }
            TexelCopyBufferLayout rows = TexelCopyBufferLayout.make();
            rows.bytesPerRow(bytes: side * 8);
            rows.rowsPerImage(count: side);
            gpu.queue.writeTexture(destination: TexelCopyTextureInfo.make(texture: copy table), data: bytes.view(), layout: rows,
                                    size: Extent3D.of(width: side, height: side, depthOrArrayLayers: side));
            gpu.agxTableView = Optional::Some(value: table.createView(descriptor: TextureViewDescriptor.make()));
        }
        return match (gpu.agxTableView) { case Some(value: v): copy v; case None: { panic(msg: "made above"); } };
    }

    // The tone-mapped resolve's pipeline (antialiasing.kama): it writes the scene's 16-bit float texture at one sample a
    // texel.
    unsafe fn RenderPipelineDescriptor resolveDescriptor(ref RendererGpu gpu) {
        ShaderModuleDescriptor described = ShaderModuleDescriptor.make(wgsl: resolveWgsl());
        described.label(text: "the tone-mapped resolve");
        ShaderModule shader = gpu.device.createShaderModule(descriptor: give described);
        FragmentState fragment = FragmentState.make(module: copy shader, entryPoint: "fs");
        fragment.target(state: ColorTargetState.make(format: TextureFormat::RGBA16Float));
        RenderPipelineDescriptor pipeline = RenderPipelineDescriptor.make(layout: Layout::Explicit(layout: copy gpu.resolvePipelineLayout),
                                                                          vertex: VertexState.make(module: give shader, entryPoint: "vs"));
        pipeline.fragment(state: give fragment);
        pipeline.label(text: "the tone-mapped resolve");
        return pipeline;
    }

    // ...asked for off the frame if it is still wanted, or, `now`, made during this render. How many pipelines it made
    // now.
    unsafe fn int32 provideResolve(ref RendererGpu gpu, bool now) {
        if (gpu.resolving.ready() || gpu.resolving.refusedNow()) { return 0; }
        if (now) {
            RenderPipelineDescriptor d = this.resolveDescriptor(gpu: ref gpu);
            gpu.resolving.makeNow(device: ref gpu.device, descriptor: give d);
            return 1;
        }
        if (gpu.resolving.wanted()) {
            RenderPipelineDescriptor d = this.resolveDescriptor(gpu: ref gpu);
            gpu.resolving.ask(device: ref gpu.device, descriptor: give d);
        }
        return 0;
    }

    fn GpuColor clearing() {
        return GpuColor.of(r: cast<float64>(this.clearTo.linearR()), g: cast<float64>(this.clearTo.linearG()),
                           b: cast<float64>(this.clearTo.linearB()), a: cast<float64>(this.alpha));
    }

    // Fill the target with the clear colour. On the default 8-bit sRGB target it reads back as written: a target
    // cleared to #336699 reads 0x33 0x66 0x99.
    unsafe fn void clearOn(ref RendererGpu gpu, Shared<RenderTarget> target) {
        Texture texture = target.textureOn(device: ref gpu.device, count: samplesOf(method: this.method));
        TextureView view = texture.createView(descriptor: TextureViewDescriptor.make());
        RenderPassDescriptor pass = RenderPassDescriptor.make();
        pass.color(attachment: ColorAttachment.clearing(view: give view, color: this.clearing()));
        pass.label(text: "a render target cleared");
        CommandEncoder encoder = gpu.device.createCommandEncoder();
        RenderPass rp = encoder.beginRenderPass(descriptor: give pass);
        give rp.end();
        CommandBuffer commands = give encoder.finish();
        gpu.queue.submit(commands: give commands);
    }

    // The pipelines that run `source`, a material's WGSL, for a mirrored mesh or not, at `count` samples a texel: their
    // entry, added the first time with a slot for the shaded one and one for its depth-only twin, none asked for yet, and
    // the entry of its general form, `general`.
    unsafe fn isize pipelineFor(ref RendererGpu gpu, const ref string source, const ref string general, bool mirrored, uint32 count) {
        for (isize i = 0; i < gpu.sources.length(); i = i + 1) {
            if (gpu.sources[i] == source && gpu.flipped[i] == mirrored && gpu.drawnAt[i] == count) { return i; }
        }
        gpu.generalOf.add(item: this.generalFor(gpu: ref gpu, source: general, count: count));
        Shared<PipelineSlot> shaded = new PipelineSlot.make(what: "a material's pipeline was refused by the device, so nothing draws with it: ",
                                                            kind: GraphicsErrorKind::Material);
        Shared<PipelineSlot> depth = new PipelineSlot.make(what: "a material's depth-only pipeline was refused by the device, so nothing draws with it: ",
                                                           kind: GraphicsErrorKind::Material);
        gpu.sources.add(item: copy source);
        gpu.flipped.add(item: mirrored);
        gpu.drawnAt.add(item: count);
        gpu.pipelines.add(item: give shaded);
        gpu.prepasses.add(item: give depth);
        return gpu.pipelines.length() - 1;
    }

    // The pipelines that run a material's general form, `source`, at `count` samples a texel, mirrored meshes or not:
    // their entry, added the first time, none asked for yet.
    unsafe fn isize generalFor(ref RendererGpu gpu, const ref string source, uint32 count) {
        for (isize i = 0; i < gpu.generalSources.length(); i = i + 1) {
            if (gpu.generalSources[i] == source && gpu.generalAt[i] == count) { return i; }
        }
        Shared<PipelineSlot> shaded = new PipelineSlot.make(what: "a material's general form was refused by the device, so its draws are skipped while its own pipelines compile: ",
                                                            kind: GraphicsErrorKind::Material);
        Shared<PipelineSlot> depth = new PipelineSlot.make(what: "a material's general form was refused by the device, so its draws are skipped while its own pipelines compile: ",
                                                           kind: GraphicsErrorKind::Material);
        gpu.generalSources.add(item: copy source);
        gpu.generalAt.add(item: count);
        gpu.generalShaded.add(item: give shaded);
        gpu.generalDepth.add(item: give depth);
        gpu.generalStandIn.add(item: false);
        return gpu.generalSources.length() - 1;
    }

    // The stand-in's general form's entry at `count` samples a texel, its nodes compiled the first time, as any
    // material's; -1 when its compile refused them, which `compileNodes` reported.
    unsafe fn isize standInEntry(ref RendererGpu gpu, uint32 count) {
        Shared<Material> look = copy this.standing;
        uint32 graph = look.graphVersion();
        if (!look.gpuMut().compiledAt(graph: graph)) { this.compileNodes(material: copy look); }
        DynamicArray<string> refused = look.gpuMut().refused();
        if (refused.length() > 0) { return -1; }
        string general = look.gpuMut().generalSource();
        isize g = this.generalFor(gpu: ref gpu, source: general, count: count);
        gpu.generalStandIn[g] = true;
        return g;
    }

    // General entry `g`'s two pipelines, each asked for off the frame if it is still wanted, one shader module serving
    // both; neither once either is refused. Never made during a render: under `Wait` a draw makes its own.
    unsafe fn void provideGeneral(ref RendererGpu gpu, isize g) {
        Shared<PipelineSlot> shaded = copy gpu.generalShaded[g];
        Shared<PipelineSlot> depth = copy gpu.generalDepth[g];
        if (shaded.refusedNow() || depth.refusedNow()) { return; }
        if (!shaded.wanted() && !depth.wanted()) { return; }
        ShaderModuleDescriptor described = ShaderModuleDescriptor.make(wgsl: copy gpu.generalSources[g]);
        described.label(text: "a material's general form");
        ShaderModule shader = gpu.device.createShaderModule(descriptor: give described);
        if (shaded.wanted()) {
            shaded.ask(device: ref gpu.device, descriptor: generalShadedDescriptor(layout: copy gpu.layout, shader: copy shader,
                                                                                   count: gpu.generalAt[g]));
        }
        if (depth.wanted()) {
            depth.ask(device: ref gpu.device, descriptor: generalDepthDescriptor(layout: copy gpu.layout, shader: copy shader,
                                                                                 count: gpu.generalAt[g]));
        }
    }

    // Entry `i`'s two pipelines: each asked for off the frame if it is still wanted, or, `now`, made during this render,
    // one shader module serving both. Neither, once either is refused. How many pipelines it made now.
    unsafe fn int32 provide(ref RendererGpu gpu, isize i, bool now) {
        Shared<PipelineSlot> shaded = copy gpu.pipelines[i];
        Shared<PipelineSlot> depth = copy gpu.prepasses[i];
        if (shaded.refusedNow() || depth.refusedNow()) { return 0; }
        bool shadedNeeded = now ? !shaded.ready() : shaded.wanted();
        bool depthNeeded = now ? !depth.ready() : depth.wanted();
        if (!shadedNeeded && !depthNeeded) { return 0; }
        ShaderModuleDescriptor described = ShaderModuleDescriptor.make(wgsl: copy gpu.sources[i]);
        described.label(text: "a material's shader");
        ShaderModule shader = gpu.device.createShaderModule(descriptor: give described);
        int32 made = 0;
        if (shadedNeeded) {
            RenderPipelineDescriptor d = shadedDescriptor(layout: copy gpu.layout, shader: copy shader, mirrored: gpu.flipped[i],
                                                          count: gpu.drawnAt[i]);
            if (now) { shaded.makeNow(device: ref gpu.device, descriptor: give d); made = made + 1; }
            else { shaded.ask(device: ref gpu.device, descriptor: give d); }
        }
        if (depthNeeded) {
            RenderPipelineDescriptor d = depthDescriptor(layout: copy gpu.layout, shader: copy shader, mirrored: gpu.flipped[i],
                                                         count: gpu.drawnAt[i]);
            if (now) { depth.makeNow(device: ref gpu.device, descriptor: give d); made = made + 1; }
            else { depth.ask(device: ref gpu.device, descriptor: give d); }
        }
        return made;
    }

    // Compile `material`'s nodes to WGSL, once for each graph it names (`graphVersion()`): what its compile refuses is
    // reported, and no mesh draws with it.
    unsafe fn void compileNodes(Shared<Material> material) {
        uint32 graph = material.graphVersion();
        MaterialSettings declared = MaterialSettings.make();
        material.settings(into: ref declared);
        NodeBuilder builder = NodeBuilder.make(settings: give declared);
        material.shade(builder: ref builder);
        string wgsl = builder.wgsl();
        string general = builder.generalWgsl();
        DynamicArray<string> problems = builder.problems();
        if (problems.length() > 0) {
            string words = "a material was refused, so nothing draws with it: ";
            for (isize i = 0; i < problems.length(); i = i + 1) {
                if (i > 0) { words = words + "; "; }
                words = words + problems[i];
            }
            this.refuse(kind: GraphicsErrorKind::Material, message: give words);
        }
        material.gpuMut().store(wgsl: give wgsl, general: give general, problems: give problems, graph: graph);
    }

    // Draw `scene` as `camera` sees it, into the target the camera names, or with none into the window.
    unsafe fn void renderOn(ref RendererGpu gpu, Shared<Scene> scene, Shared<PerspectiveCamera> camera) {
        this.settleAll(gpu: ref gpu);
        Walk walk = scene.walkAll();
        int32 made = walk.matrices();
        DynamicArray<string> found = walk.refusals();
        for (isize i = 0; i < found.length(); i = i + 1) { this.refuse(kind: GraphicsErrorKind::Light, message: copy found[i]); }
        camera.placeAlone();
        int32 objects = cast<int32>(scene.objects());
        RenderInfo nothing = RenderInfo.of(calls: 0, triangles: 0, objects: objects, matrices: made, misses: 0, skipped: 0, general: 0,
                                           standIn: 0, waited: 0);
        Optional<Shared<RenderTarget>> named = camera.target();
        bool toWindow = named.isNone();
        if (toWindow && this.onWindow.isNone()) {
            this.last = nothing;
            this.refuse(kind: GraphicsErrorKind::NoTarget,
                        message: "render drew nothing: the camera names no render target, and this renderer has no window to draw into (name a target with the camera's targetMut())");
            return;
        }
        // into the window (kyoten's rendering.md § Decided, GFX-1's part 6, step 1): its surface configured at the window's
        // size and the present mode in effect. A window of no area, a closed one, or one whose surface refused draws
        // nothing this render.
        TextureFormat outputFormat = TextureFormat::RGBA8UnormSrgb;
        if (toWindow) {
            if (!this.configureWindow(gpu: ref gpu)) { this.last = nothing; return; }
            outputFormat = this.windowView;
        }
        // the method, as set now: its samples a texel, and how they become the scene (antialiasing.kama)
        uint32 perTexel = samplesOf(method: this.method);
        bool byGpu = this.method == Antialiasing::Msaa4;
        bool toneMappedResolve = this.method == Antialiasing::Msaa4ToneMapped;
        // the pipelines a draw needs and has not, asked for off the frame, or made now under `Wait`: what this render
        // made itself, and what it drew other than as asked (`info()`). The frame's own passes take the renderer's way,
        // and each mesh its own, else the renderer's.
        bool now = this.way == WhileCompiling::Wait;
        int32 waited = 0;
        int32 misses = 0;
        int32 skipped = 0;
        int32 byGeneral = 0;
        int32 byStandIn = 0;
        isize standInAt = -2;   // the stand-in's general entry, found by the first draw that takes it: -1 refused
        // the frame's own passes: while the tone-mapped resolve compiles the GPU resolves, the ladder's next rung, and
        // while the output pass compiles it is left out, the target left as it was, and the window showing the frame it
        // showed last. Neither is a miss once refused.
        if (toneMappedResolve) {
            waited = waited + this.provideResolve(gpu: ref gpu, now: now);
            if (!gpu.resolving.ready()) {
                if (!gpu.resolving.refusedNow()) { misses = misses + 1; }
                toneMappedResolve = false;
                byGpu = true;
            }
        }
        bool output = match (named) { case Some(value: t): !t.holdsScene(); case None: true; };
        ToneMapping curve = camera.toneMapping();
        isize o = -1;
        if (output) {
            o = this.outputFor(gpu: ref gpu, curve: curve, format: outputFormat);
            waited = waited + this.provideOutput(gpu: ref gpu, o: o, curve: curve, format: outputFormat, now: now);
            Shared<PipelineSlot> outputSlot = copy gpu.outputs[o];
            if (!outputSlot.ready()) {
                if (!outputSlot.refusedNow()) { misses = misses + 1; }
                output = false;
            }
        }
        // the window's frame, acquired only when the output pass will write it, so the window is never shown a frame
        // nothing was written into; with none to draw into this render, nothing is drawn
        Optional<SurfaceTexture> frame = Optional::None;
        uint32 wide = cast<uint32>(this.configuredWidth);
        uint32 high = cast<uint32>(this.configuredHeight);
        if (toWindow && output) {
            frame = this.acquireWindow(gpu: ref gpu);
            if (frame.isNone()) { this.last = nothing; return; }
            match (frame) {
                case Some(value: f): { Texture shown = f.texture(); wide = shown.width(); high = shown.height(); }
                case None: { }
            };
        }
        Shared<RenderTarget> target = match (give named) {
            case Some(value: t): give t;
            case None: this.windowTargetAt(gpu: ref gpu, width: wide, height: high);
        };
        // the window reads held (step 1's third question, Bevy's way): this frame is drawn into a texture of its own,
        // copied out for each, and drawn onto the window by the pass onto it, once that pass is compiled. While it
        // compiles the frame is drawn into the window as ever, and the reads wait; where the device refused it, they fail.
        DynamicArray<Shared<FrameCapture>> held = DynamicArray.empty();
        bool reading = false;
        isize b = -1;
        if (frame.isSome()) {
            held = this.heldCaptures();
            if (held.length() == 0) { this.captures.clear(); }
            else {
                b = this.blitFor(gpu: ref gpu, format: outputFormat);
                waited = waited + this.provideBlit(gpu: ref gpu, b: b, format: outputFormat, now: now);
                Shared<PipelineSlot> blitSlot = copy gpu.blits[b];
                if (blitSlot.ready()) { reading = true; }
                else if (blitSlot.refusedNow()) {
                    this.failCaptures(words: "the device refused the window read's pass onto the window, so the window cannot be read");
                    held.clear();
                }
            }
        }
        Texture colour = target.textureOn(device: ref gpu.device, count: perTexel);
        Optional<Texture> readTexture = Optional::None;
        if (reading) {
            TextureDescriptor r = TextureDescriptor.make(width: wide, height: high, format: outputFormat,
                                                         usage: TextureUsage::RenderAttachment | TextureUsage::CopySrc | TextureUsage::TextureBinding);
            r.label(text: "a window read's frame");
            readTexture = Optional::Some(value: gpu.device.createTexture(descriptor: give r));
        }
        // what the output pass writes: the target's colour, the read's texture, or the window's frame
        TextureView drawnInto = match (readTexture) {
            case Some(value: x): x.createView(descriptor: TextureViewDescriptor.make());
            case None: match (frame) {
                case Some(value: f): f.view();
                case None: colour.createView(descriptor: TextureViewDescriptor.make());
            };
        };
        Texture depth = target.depthOn(device: ref gpu.device, count: perTexel);
        Texture sceneTexture = target.sceneOn(device: ref gpu.device, count: perTexel);
        Texture sampled = target.samplesOn(device: ref gpu.device, count: perTexel);
        // a camera with no aspect of its own takes what it draws into's, width over height (step 1's question 1)
        camera.follow(width: target.width(), height: target.height());
        float32 exposure = camera.exposureScale();

        DynamicArray<uint8> frameBytes = DynamicArray.empty();
        Mat4 vp = camera.viewProjection();
        for (int32 c = 0; c < 4; c = c + 1) {
            for (int32 r = 0; r < 4; r = r + 1) { putFloat(into: ref frameBytes, value: vp.get(c: c, r: r)); }
        }
        Vec3 ambient = scene.ambientLight();
        putFloat(into: ref frameBytes, value: ambient.x);
        putFloat(into: ref frameBytes, value: ambient.y);
        putFloat(into: ref frameBytes, value: ambient.z);
        uint32 directional = cast<uint32>(scene.directionalCount());
        frameBytes.add(item: truncate<uint8>(directional));
        frameBytes.add(item: truncate<uint8>(directional >> 8));
        frameBytes.add(item: truncate<uint8>(directional >> 16));
        frameBytes.add(item: truncate<uint8>(directional >> 24));
        // the camera's world position, the translation of its world matrix: its parent's moves included, since the
        // scene's walk above placed it
        Mat4 seen = camera.matrixWorld();
        putFloat(into: ref frameBytes, value: seen.get(c: 3, r: 0));
        putFloat(into: ref frameBytes, value: seen.get(c: 3, r: 1));
        putFloat(into: ref frameBytes, value: seen.get(c: 3, r: 2));
        // the camera's exposure, what every material's light is scaled by before it is stored (part 4, question 3)
        putFloat(into: ref frameBytes, value: exposure);
        gpu.queue.writeBuffer(buffer: gpu.frame, offset: 0, data: frameBytes.view());
        Buffer records = scene.recordsOn(device: ref gpu.device, queue: ref gpu.queue);
        Buffer lights = scene.lightsOn(device: ref gpu.device, queue: ref gpu.queue);
        BindGroupDescriptor bound = BindGroupDescriptor.make(layout: copy gpu.frameLayout);
        bound.entry(binding: 0, resource: BindingResource::Buffer(binding: BufferBinding.whole(buffer: copy gpu.frame)));
        bound.entry(binding: 1, resource: BindingResource::Buffer(binding: BufferBinding.whole(buffer: give records)));
        bound.entry(binding: 2, resource: BindingResource::Texture(view: copy gpu.dfgView));
        bound.entry(binding: 3, resource: BindingResource::Sampler(sampler: copy gpu.dfgSampling));
        bound.entry(binding: 4, resource: BindingResource::Buffer(binding: BufferBinding.whole(buffer: give lights)));
        bound.label(text: "the frame, the object records, the DFG table and the lights");
        BindGroup frameGroup = gpu.device.createBindGroup(descriptor: give bound);

        // Each mesh's draw, gathered once: its material compiled the first time, its pipelines ready or asked for, its
        // settings and buffers written when they changed. The depth prepass and the shaded pass then draw the same list.
        DynamicArray<isize> chosen = DynamicArray.empty();
        DynamicArray<RenderPipeline> shadedWith = DynamicArray.empty();
        DynamicArray<RenderPipeline> depthWith = DynamicArray.empty();
        DynamicArray<BindGroup> looks = DynamicArray.empty();
        DynamicArray<Buffer> positionsOf = DynamicArray.empty();
        DynamicArray<Buffer> normalsOf = DynamicArray.empty();
        DynamicArray<Buffer> indicesOf = DynamicArray.empty();
        DynamicArray<IndexFormat> formats = DynamicArray.empty();
        DynamicArray<uint32> counts = DynamicArray.empty();
        DynamicArray<uint32> drawn = DynamicArray.empty();
        int32 triangles = 0;
        DynamicArray<isize> slots = scene.drawSlots();
        for (isize i = 0; i < slots.length(); i = i + 1) {
            isize slot = slots[i];
            Shared<Material> material = scene.materialAt(slot: slot);
            Shared<Geometry> geometry = scene.geometryAt(slot: slot);
            uint32 graph = material.graphVersion();
            if (!material.gpuMut().compiledAt(graph: graph)) { this.compileNodes(material: copy material); }
            DynamicArray<string> refused = material.gpuMut().refused();
            if (refused.length() > 0) { continue; }
            WhileCompiling drawWay = match (scene.wayAt(slot: slot)) { case Some(value: w): w; case None: this.way; };
            string source = material.gpuMut().source();
            string general = material.gpuMut().generalSource();
            isize e = this.pipelineFor(gpu: ref gpu, source: source, general: general, mirrored: scene.mirroredAt(slot: slot), count: perTexel);
            waited = waited + this.provide(gpu: ref gpu, i: e, now: drawWay == WhileCompiling::Wait);
            Shared<Material> drawnWith = copy material;
            Shared<PipelineSlot> shadedSlot = copy gpu.pipelines[e];
            Shared<PipelineSlot> depthSlot = copy gpu.prepasses[e];
            if (shadedSlot.ready() && depthSlot.ready()) {
                chosen.add(item: e);
                shadedWith.add(item: shadedSlot.pipeline());
                depthWith.add(item: depthSlot.pipeline());
            } else {
                // refused, and never drawn, so no miss
                if (shadedSlot.refusedNow() || depthSlot.refusedNow()) { continue; }
                // compiling: under `General`, drawn by its material's general form once that is ready, asked for now if
                // it is not yet; under `StandIn`, by the stand-in's, its look the stand-in's; else skipped
                bool drawable = false;
                if (drawWay == WhileCompiling::General) {
                    isize g = gpu.generalOf[e];
                    this.provideGeneral(gpu: ref gpu, g: g);
                    Shared<PipelineSlot> shadedGeneral = copy gpu.generalShaded[g];
                    Shared<PipelineSlot> depthGeneral = copy gpu.generalDepth[g];
                    if (shadedGeneral.ready() && depthGeneral.ready()) {
                        drawable = true;
                        chosen.add(item: -2 - g);
                        shadedWith.add(item: shadedGeneral.pipeline());
                        depthWith.add(item: depthGeneral.pipeline());
                        byGeneral = byGeneral + 1;
                    }
                }
                if (drawWay == WhileCompiling::StandIn) {
                    if (standInAt == -2) { standInAt = this.standInEntry(gpu: ref gpu, count: perTexel); }
                    if (standInAt >= 0) {
                        this.provideGeneral(gpu: ref gpu, g: standInAt);
                        Shared<PipelineSlot> shadedStandIn = copy gpu.generalShaded[standInAt];
                        Shared<PipelineSlot> depthStandIn = copy gpu.generalDepth[standInAt];
                        if (shadedStandIn.ready() && depthStandIn.ready()) {
                            drawable = true;
                            chosen.add(item: -2 - standInAt);
                            shadedWith.add(item: shadedStandIn.pipeline());
                            depthWith.add(item: depthStandIn.pipeline());
                            drawnWith = this.standIn();
                            byStandIn = byStandIn + 1;
                        }
                    }
                }
                if (!drawable) { skipped = skipped + 1; continue; }
            }
            DynamicArray<uint8> settings = DynamicArray.empty();
            if (drawnWith.gpuMut().staleOn(device: gpu.device, version: drawnWith.version())) {
                MaterialSettings declared = MaterialSettings.make();
                drawnWith.settings(into: ref declared);
                settings = declared.bytes();
            }
            looks.add(item: drawnWith.gpuMut().groupOn(device: ref gpu.device, queue: ref gpu.queue, layout: gpu.materialLayout,
                                                       settings: settings, version: drawnWith.version()));
            positionsOf.add(item: geometry.buffersMut().positionsOn(device: ref gpu.device, queue: ref gpu.queue));
            normalsOf.add(item: geometry.buffersMut().normalsOn(device: ref gpu.device, queue: ref gpu.queue));
            indicesOf.add(item: geometry.buffersMut().indicesOn(device: ref gpu.device, queue: ref gpu.queue));
            formats.add(item: geometry.buffers().indexFormat());
            isize count = geometry.buffers().indexCount();
            counts.add(item: cast<uint32>(count));
            drawn.add(item: cast<uint32>(slot));
            triangles = triangles + cast<int32>(count / 3);
        }

        CommandEncoder encoder = gpu.device.createCommandEncoder();
        // the depth prepass (kyoten's rendering.md § Decided, area 3; part 4): every mesh's nearest depth, cleared to 0
        // first since depth is reversed, so the shaded pass shades each texel once
        RenderPassDescriptor depthPass = RenderPassDescriptor.make();
        depthPass.depthStencil(attachment: DepthStencilAttachment.clearingDepth(view: depth.createView(descriptor: TextureViewDescriptor.make()),
                                                                               value: 0.0));
        depthPass.label(text: "a scene's depth");
        RenderPass dp = encoder.beginRenderPass(descriptor: give depthPass);
        dp.setBindGroup(index: 0, group: frameGroup);
        drawEach(pass: ref dp, pipelines: depthWith, chosen: chosen, looks: looks, positions: positionsOf,
                 normals: normalsOf, indices: indicesOf, formats: formats, counts: counts, slots: drawn);
        give dp.end();
        // the shaded pass, into the multisampled scene: cleared to the clear colour, exposed, then each mesh shaded where
        // the prepass's depth is its own, that depth read and never written. Under `Msaa4` the GPU resolves its samples
        // into the scene's 16-bit float texture as the pass ends, averaging the linear scene, and the samples are not kept
        // (part 4's question 1, the ladder's second rung); under `Msaa4ToneMapped` they are kept for the resolve pass
        // below; under `None` the pass draws the scene's texture itself, one sample a texel
        RenderPassDescriptor pass = RenderPassDescriptor.make();
        ColorAttachment shaded = ColorAttachment.make(view: sampled.createView(descriptor: TextureViewDescriptor.make()),
                                                      load: LoadOp::Clear(color: this.clearingExposed(scale: exposure)),
                                                      store: byGpu ? StoreOp::Discard : StoreOp::Store);
        if (byGpu) { shaded.resolveTarget(view: sceneTexture.createView(descriptor: TextureViewDescriptor.make())); }
        pass.color(attachment: give shaded);
        DepthStencilAttachment tested = DepthStencilAttachment.make(view: depth.createView(descriptor: TextureViewDescriptor.make()));
        tested.depth(access: DepthAccess::ReadOnly);
        pass.depthStencil(attachment: give tested);
        pass.label(text: "a scene");
        RenderPass rp = encoder.beginRenderPass(descriptor: give pass);
        rp.setBindGroup(index: 0, group: frameGroup);
        drawEach(pass: ref rp, pipelines: shadedWith, chosen: chosen, looks: looks, positions: positionsOf,
                 normals: normalsOf, indices: indicesOf, formats: formats, counts: counts, slots: drawn);
        give rp.end();
        // the tone-mapped resolve (part 4's question 1, the ladder's best rung): one full-screen triangle writing the
        // scene's 16-bit float texture from the samples the shaded pass kept, each weighed by 1/(1 + its brightest
        // channel), averaged and the weight undone, so it stays linear (antialiasing.kama). The frame's own pass, as the
        // output pass is, so `info()` does not count it
        if (toneMappedResolve) {
            BindGroupDescriptor samplesRead = BindGroupDescriptor.make(layout: copy gpu.resolveLayout);
            samplesRead.entry(binding: 0, resource: BindingResource::Texture(view: sampled.createView(descriptor: TextureViewDescriptor.make())));
            samplesRead.label(text: "the tone-mapped resolve's samples");
            BindGroup resolveGroup = gpu.device.createBindGroup(descriptor: give samplesRead);
            RenderPassDescriptor resolvePass = RenderPassDescriptor.make();
            resolvePass.color(attachment: ColorAttachment.clearing(view: sceneTexture.createView(descriptor: TextureViewDescriptor.make()),
                                                            color: GpuColor.of(r: 0.0, g: 0.0, b: 0.0, a: 0.0)));
            resolvePass.label(text: "the tone-mapped resolve");
            RenderPass tp = encoder.beginRenderPass(descriptor: give resolvePass);
            tp.setPipeline(pipeline: gpu.resolving.pipeline());
            tp.setBindGroup(index: 0, group: resolveGroup);
            tp.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
            give tp.end();
        }
        // the output pass, into an 8-bit target: the scene through the camera's tone mapping. A 16-bit float target holds
        // the scene itself, so it has none.
        if (output) {
            bool table = readsTable(curve: curve);
            BindGroupDescriptor sceneRead = BindGroupDescriptor.make(layout: table ? copy gpu.tableLayout : copy gpu.outputLayout);
            sceneRead.entry(binding: 0, resource: BindingResource::Texture(view: sceneTexture.createView(descriptor: TextureViewDescriptor.make())));
            if (table) { sceneRead.entry(binding: 1, resource: BindingResource::Texture(view: this.agxTable(gpu: ref gpu))); }
            sceneRead.label(text: "the output pass's scene");
            BindGroup readGroup = gpu.device.createBindGroup(descriptor: give sceneRead);
            RenderPassDescriptor outputPass = RenderPassDescriptor.make();
            outputPass.color(attachment: ColorAttachment.clearing(view: copy drawnInto, color: GpuColor.of(r: 0.0, g: 0.0, b: 0.0, a: 0.0)));
            outputPass.label(text: "the output pass");
            RenderPass op = encoder.beginRenderPass(descriptor: give outputPass);
            Shared<PipelineSlot> outputSlot = copy gpu.outputs[o];
            op.setPipeline(pipeline: outputSlot.pipeline());
            op.setBindGroup(index: 0, group: readGroup);
            op.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
            give op.end();
        }
        // the window read: the frame copied out of the read's texture for each read held, then drawn onto the window's
        // frame, each texel as it is, by the pass onto the window
        uint32 row = rowBytes(width: wide, texel: 4);
        uint64 size = cast<uint64>(row) * cast<uint64>(high);
        DynamicArray<Buffer> copies = DynamicArray.empty();
        if (reading) {
            Texture readFrom = match (readTexture) { case Some(value: x): copy x; case None: { panic(msg: "made above"); } };
            for (isize i = 0; i < held.length(); i = i + 1) {
                BufferDescriptor described = BufferDescriptor.make(size: size, usage: BufferUsage::MapRead | BufferUsage::CopyDst);
                described.label(text: "a window read");
                Buffer copied = gpu.device.createBuffer(descriptor: give described);
                encoder.copyTextureToBuffer(texture: readFrom, buffer: copied, width: wide, height: high, bytesPerRow: row);
                copies.add(item: give copied);
            }
            BindGroupDescriptor frameRead = BindGroupDescriptor.make(layout: copy gpu.blitLayout);
            frameRead.entry(binding: 0, resource: BindingResource::Texture(view: readFrom.createView(descriptor: TextureViewDescriptor.make())));
            frameRead.label(text: "the window read's frame");
            BindGroup readGroup = gpu.device.createBindGroup(descriptor: give frameRead);
            TextureView onto = match (frame) { case Some(value: f): f.view(); case None: { panic(msg: "a frame is read only when one was acquired"); } };
            RenderPassDescriptor blitPass = RenderPassDescriptor.make();
            blitPass.color(attachment: ColorAttachment.clearing(view: give onto, color: GpuColor.of(r: 0.0, g: 0.0, b: 0.0, a: 1.0)));
            blitPass.label(text: "the window read's pass onto the window");
            RenderPass wp = encoder.beginRenderPass(descriptor: give blitPass);
            Shared<PipelineSlot> blitSlot = copy gpu.blits[b];
            wp.setPipeline(pipeline: blitSlot.pipeline());
            wp.setBindGroup(index: 0, group: readGroup);
            wp.draw(vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
            give wp.end();
        }
        CommandBuffer commands = give encoder.finish();
        gpu.queue.submit(commands: give commands);
        if (reading) {
            bool bgra = outputFormat == TextureFormat::BGRA8UnormSrgb;
            for (isize i = 0; i < held.length(); i = i + 1) {
                Buffer copied = copy copies[i];
                BufferRead read = copied.mapRead(offset: 0, size: size);
                Shared<FrameCapture> c = copy held[i];
                c.derefMut().fill(copied: CopiedFrame.make(device: copy gpu.device, buffer: give copied, read: give read, width: wide,
                                                           height: high, row: row, wide: false, bgra: bgra));
            }
            this.captures.clear();
        }
        // the window's frame shown
        match (give frame) {
            case Some(value: f): { give f.present(); this.windowTold = ""; }
            case None: { }
        };
        // every draw of the scene's meshes the GPU was asked for, both passes', as three.js's `renderer.info` counts a
        // shadow pass's; the frame's own pass, the output, is not the scene's
        int32 calls = cast<int32>(chosen.length()) * 2;
        this.last = RenderInfo.of(calls: calls, triangles: triangles * 2, objects: objects, matrices: made,
                                  misses: misses + skipped + byGeneral + byStandIn, skipped: skipped, general: byGeneral,
                                  standIn: byStandIn, waited: waited);
        this.reportRefusals(gpu: ref gpu);
    }

    // Start reading the target back, as three.js's `readRenderTargetPixelsAsync`: poll the read until it hands back its
    // image, the target's size in 8-bit RGBA, sRGB, top row first.
    unsafe fn PixelRead readTargetOn(ref RendererGpu gpu, Shared<RenderTarget> target) {
        Texture texture = target.textureOn(device: ref gpu.device, count: samplesOf(method: this.method));
        uint32 width = target.width();
        uint32 height = target.height();
        bool wide = target.holdsScene();       // 16-bit float: 8 bytes a texel
        uint32 row = rowBytes(width: width, texel: wide ? 8 : 4);
        uint64 size = cast<uint64>(row) * cast<uint64>(height);
        BufferDescriptor described = BufferDescriptor.make(size: size, usage: BufferUsage::MapRead | BufferUsage::CopyDst);
        described.label(text: "a render target read back");
        Buffer buffer = gpu.device.createBuffer(descriptor: give described);
        CommandEncoder encoder = gpu.device.createCommandEncoder();
        encoder.copyTextureToBuffer(texture: texture, buffer: buffer, width: width, height: height, bytesPerRow: row);
        CommandBuffer commands = give encoder.finish();
        gpu.queue.submit(commands: give commands);
        BufferRead read = buffer.mapRead(offset: 0, size: size);
        return PixelRead.ofTarget(copied: CopiedFrame.make(device: copy gpu.device, buffer: give buffer, read: give read, width: width,
                                                           height: height, row: row, wide: wide, bgra: false));
    }
}

// What a read says when polled: still pending, its image (handed over once), or why it failed. Polled again after its
// image was handed over, it says `Taken`, as @kama/gpu's requests do.
type enum PixelStatus { Pending, Ready(Image image), Failed(GpuError error) }

// A frame copied into a buffer and its map under way, a target's or the window's. Dropping it while it is pending is
// safe: the map is left to finish and be freed.
type resource CopiedFrame {
    Device device;
    Buffer buffer;     // kept alive while it is mapped
    BufferRead read;
    uint32 w;
    uint32 h;
    uint32 row;
    bool float16;      // a 16-bit float target's texels: the linear scene
    bool bgra;         // a window frame whose format orders its channels blue, green, red, alpha
    bool handed = false;

    friend Renderer[make];
    friend PixelRead[poll];
    friend FrameCapture[poll];

    ctor make(Device device, Buffer buffer, BufferRead read, uint32 width, uint32 height, uint32 row, bool wide, bool bgra) {
        this.device = give device;
        this.buffer = give buffer;
        this.read = give read;
        this.w = width;
        this.h = height;
        this.row = row;
        this.float16 = wide;
        this.bgra = bgra;
    }

    unsafe fn PixelStatus poll() {
        if (this.handed) { return PixelStatus::Failed(error: GpuError::Taken); }
        this.device.poll(wait: false);
        ReadStatus s = this.read.poll();
        match (give s) {
            case Pending: { return PixelStatus::Pending; }
            case Failed(error: e): { this.handed = true; return PixelStatus::Failed(error: e); }
            case Ready: { }
        };
        this.handed = true;
        DynamicArray<uint8> mapped = this.read.bytes();
        isize width = cast<isize>(this.w);
        isize height = cast<isize>(this.h);
        isize stride = cast<isize>(this.row);
        if (this.float16) {
            // the linear scene: four half floats a texel, little-endian, as WebGPU stores them
            FixedArray<uint16> halves = FixedArray.make(size: width * height * 4);
            for (isize y = 0; y < height; y = y + 1) {
                for (isize x = 0; x < width * 4; x = x + 1) {
                    isize at = y * stride + x * 2;
                    halves[y * width * 4 + x] = cast<uint16>(mapped[at]) | (cast<uint16>(mapped[at + 1]) << 8);
                }
            }
            Result<Image, ImageError> linear = Image.fromSamples16(width: width, height: height, format: PixelFormat::Rgba16Float,
                                                                   alpha: AlphaMode::Straight, colorSpace: ColorSpace.linearSrgb(),
                                                                   samples: give halves);
            return match (give linear) {
                case Ok(value: img): PixelStatus::Ready(image: give img);
                case Err(error: e): PixelStatus::Failed(error: GpuError::Refused(words: "the read's image: " + e.message()));
            };
        }
        FixedArray<uint8> samples = FixedArray.make(size: width * height * 4);
        for (isize y = 0; y < height; y = y + 1) {
            for (isize x = 0; x < width * 4; x = x + 1) { samples[y * width * 4 + x] = mapped[y * stride + x]; }
        }
        if (this.bgra) {
            // a window frame in BGRA order, each texel's blue and red put in RGBA's places
            for (isize i = 0; i < width * height * 4; i = i + 4) {
                uint8 blue = samples[i];
                samples[i] = samples[i + 2];
                samples[i + 2] = blue;
            }
        }
        Result<Image, ImageError> made = Image.fromSamples8(width: width, height: height, format: PixelFormat::Rgba8Unorm,
                                                            alpha: AlphaMode::Straight, colorSpace: ColorSpace.srgb(),
                                                            samples: give samples);
        return match (give made) {
            case Ok(value: img): PixelStatus::Ready(image: give img);
            case Err(error: e): PixelStatus::Failed(error: GpuError::Refused(words: "the read's image: " + e.message()));
        };
    }
}

// A read under way: a target's, its copy made at once (`readRenderTargetPixels`), or the window's, its copy made by the
// next render that draws into the window (`readWindowPixels`), or one that failed before it began. Dropping it while it
// is pending is safe.
type resource PixelRead {
    Optional<CopiedFrame> copied = Optional::None;
    Optional<Shared<FrameCapture>> capture = Optional::None;
    string failure = "";

    friend Renderer[ofTarget, ofWindow, failed];

    ctor ofTarget(CopiedFrame copied) { this.copied = Optional::Some(value: give copied); }
    ctor ofWindow(Shared<FrameCapture> capture) { this.capture = Optional::Some(value: give capture); }
    ctor failed(string words) { this.failure = give words; }

    // Pending until the image is copied and mapped; then Ready once, handing the image over, or Failed, with why. Polled
    // again after its image was handed over, it says `Taken`, as @kama/gpu's requests do.
    public unsafe fn PixelStatus poll() {
        if (!this.failure.isEmpty()) { return PixelStatus::Failed(error: GpuError::Refused(words: copy this.failure)); }
        match (this.copied) {
            case Some(value: c): { return c.poll(); }
            case None: { }
        };
        match (this.capture) {
            case Some(value: k): { return k.derefMut().answer(); }
            case None: { }
        };
        return PixelStatus::Failed(error: GpuError::Taken);
    }
}
