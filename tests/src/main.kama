// @kama/graphics' tests, one program (AGENTS.package.md). First, on every leg and with no GPU, the golden harness's own
// cases (tests/src/harness.kama), `Color`'s (tests/src/renderer.kama), part 2's: `Euler`, `BoxGeometry`, the camera,
// `MeshBasicMaterial` and the tree (tests/src/parts.kama), and part 3's typed nodes compiled to WGSL
// (tests/src/nodes.kama). Then, a step a tick on the leg's GPU, opened once (tests/src/open.kama): the harness end to end
// (tests/src/scene.kama), the `Renderer` that clears a target and reads it back (tests/src/renderer.kama), scenes
// rendered and read back (tests/src/boxes.kama), the nodes' WGSL compiled by the leg's own compiler, with a refused
// material beside a drawn one (tests/src/shaders.kama), normals in world space under a shear and a mirror
// (tests/src/normals.kama), and `MeshStandardMaterial` drawn with no light and a material compiled again when its nodes
// change (tests/src/standard.kama), the DFG table read through a program's own material (tests/src/dfg.kama), the
// lights changed around a box with nothing compiled (tests/src/lights.kama), r187's physical model held to its formulas
// (tests/src/physical.kama), the lit goldens, one for each feature part 3 built (tests/src/lit.kama), and part 4's frame
// (tests/src/frame.kama), tone mapping (tests/src/tonemap.kama) and anti-aliasing methods (tests/src/antialias.kama),
// each on its own handle to the one device.
// `MeshStandardMaterial`'s values and settings, the DFG table and the lights' defaults are checked with no GPU, beside
// part 2's.
//
// A leg names its software GPU with `--golden warp` or `--golden swiftshader` (kyoten's rendering.md § Decided, GFX-1's
// part 1, question 3). There every frame is held to its golden, `tests/goldens/<test>/<gpu>.png`, byte for byte. A leg
// that names none, such as a hardware GPU, compares no golden. The program's last lines say what was compared:
// `goldens: <n> declared, <n> matched, on <gpu>`, or `goldens: none, this leg names no software GPU`. tools/test.sh holds
// every leg that names a GPU to declaring and matching every golden tests/goldens/ has for it, so no leg passes by
// skipping one. Once every GPU case has run, it says `gpu cases: all run`, which the gate holds every leg to, so a leg
// whose device never opened fails, whether it names a GPU or not.
//
// It is a state machine, an `App` that std::app::run ticks, because on the web the adapter, the device and the map are
// answered by the browser between ticks. A failing case prints its name, and the exit status is 1 when any failed.

import {
    core::println,
    core::env::args, core::env::Args,
    std::app::App, std::app::Lifecycle, std::app::run, std::app::Pace, std::app::quit,
    std::memory::Owned, std::memory::replace,
    gpu::Device, gpu::Queue,
    std::collections::DynamicArray,
    Verdicts, harnessCases, colorCases, partCases, nodeCases, ShaderCase, GpuOpen, GoldenRun, RendererRun, BoxesRun,
    ShaderRun, NormalsRun, standardCases, StandardRun, dfgCases, DfgRun, lightCases, LightsRun, physicalCases, PhysicalRun,
    LitRun, FrameRun, ToneMapRun, AntialiasRun,
};

// The software GPUs a leg can name: WARP, natively on Windows and as Firefox's fallback adapter, and SwiftShader, as
// Chromium's. lavapipe joins when Linux's leg is measured.
fn bool knownGpu(const ref string gpu) { return gpu == "warp" || gpu == "swiftshader"; }

// What follows `--golden` in the program's arguments: "" when it is not given, "--golden" when nothing follows it.
unsafe fn string goldenArgument() {
    Args a = args();
    int32 i = 0;
    while (i < a.count()) {
        Optional<string> one = a.get(at: i);
        bool flag = match (one) { case Some(value: s): s == "--golden"; case None: false; };
        if (flag) {
            Optional<string> next = a.get(at: i + 1);
            return match (give next) { case Some(value: s): give s; case None: "--golden"; };
        }
        i = i + 1;
    }
    return "";
}

// The stage that finishes the run: the last GPU case's step moves to it, and so does a leg whose device never opened,
// named once so that a stage added before it cannot leave either pointing at a step that needs the device.
comptime int32 DONE = 14;

type resource Check implements App {
    int32 runs = 0;
    int32 failures = 0;
    string gpu;
    int32 declared = 0;
    int32 matched = 0;
    int32 stage = 0;     // 0 the device, 1 the scene, 2 the renderer, 3 the boxes, 4 the shaders, 5 the normals,
                         // 6 the standard material, 7 the DFG table, 8 the lights, 9 the physical model, 10 the lit,
                         // 11 the frame, 12 the tone mapping
                         // goldens, 13 the anti-aliasing methods, DONE
    Optional<GpuOpen> opening = Optional::None;
    Optional<Device> device = Optional::None;
    Optional<Queue> queue = Optional::None;
    bool software = false;
    Optional<GoldenRun> scene = Optional::None;
    Optional<RendererRun> rendering = Optional::None;
    Optional<BoxesRun> boxes = Optional::None;
    Optional<ShaderRun> shaders = Optional::None;
    Optional<NormalsRun> normals = Optional::None;
    Optional<StandardRun> standard = Optional::None;
    Optional<DfgRun> dfgRun = Optional::None;
    Optional<LightsRun> lightsRun = Optional::None;
    Optional<PhysicalRun> physicalRun = Optional::None;
    Optional<LitRun> litRun = Optional::None;
    Optional<FrameRun> frameRun = Optional::None;
    Optional<ToneMapRun> toneRun = Optional::None;
    Optional<AntialiasRun> antialiasRun = Optional::None;

    public unsafe ctor make() {
        Verdicts found = Verdicts.make();
        harnessCases(found: ref found);
        colorCases(found: ref found);
        partCases(found: ref found);
        standardCases(found: ref found);
        dfgCases(found: ref found);
        lightCases(found: ref found);
        physicalCases(found: ref found);
        DynamicArray<ShaderCase> compiled = DynamicArray.empty();
        nodeCases(found: ref found, shaders: ref compiled);
        this.report(found: found);
        string named = goldenArgument();
        if (named.isEmpty() || knownGpu(gpu: named)) {
            this.gpu = copy named;
        } else {
            this.verdict(name: "--golden names a software GPU the harness knows (warp, swiftshader)", why: "it names '" + named + "'");
            this.gpu = "";
        }
        this.opening = Optional::Some(value: GpuOpen.make(gpu: copy this.gpu));
    }

    public fn void verdict(const ref string name, const ref string why) {
        this.runs = this.runs + 1;
        if (why.isEmpty()) {
            println(s: "ok   ${name}");
        } else {
            this.failures = this.failures + 1;
            println(s: "FAIL ${name}: ${why}");
        }
    }

    fn void report(const ref Verdicts found) {
        for (isize i = 0; i < found.count(); i = i + 1) {
            string name = found.nameAt(at: i);
            string why = found.whyAt(at: i);
            this.verdict(name: name, why: why);
        }
    }

    // One frame of the loop: false once every case has run.
    public fn bool tick() { return this.step() != 0; }

    // The host's lifecycle: nothing here holds a surface, so there is nothing to drop on `SurfaceLost`.
    public fn void lifecycle(Lifecycle event) { }

    unsafe fn int32 step() {
        if (this.stage == 0) { this.openStep(); }
        if (this.stage == 1) { this.sceneStep(); }
        if (this.stage == 2) { this.rendererStep(); }
        if (this.stage == 3) { this.boxesStep(); }
        if (this.stage == 4) { this.shadersStep(); }
        if (this.stage == 5) { this.normalsStep(); }
        if (this.stage == 6) { this.standardStep(); }
        if (this.stage == 7) { this.dfgStep(); }
        if (this.stage == 8) { this.lightsStep(); }
        if (this.stage == 9) { this.physicalStep(); }
        if (this.stage == 10) { this.litStep(); }
        if (this.stage == 11) { this.frameStep(); }
        if (this.stage == 12) { this.toneStep(); }
        if (this.stage == 13) { this.antialiasStep(); }
        if (this.stage == DONE) { return this.finish(); }
        return 1;
    }

    // The device, opened once for every GPU case (tests/src/open.kama). With none, the GPU cases do not run: on a leg
    // that names a software GPU the gate then finds its goldens uncompared.
    unsafe fn void openStep() {
        Optional<GpuOpen> taken = replace(place: this.opening, with: Optional::None);
        GpuOpen pending = match (give taken) { case Some(value: o): give o; case None: GpuOpen.make(gpu: copy this.gpu); };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.opening = Optional::Some(value: give pending); return; }
        this.software = pending.software();
        this.device = pending.takeDevice();
        this.queue = pending.takeQueue();
        if (this.device.isNone() || this.queue.isNone()) {
            this.verdict(name: "a device for the GPU cases", why: "none was opened, so no GPU case ran");
            this.stage = DONE;
            return;
        }
        this.stage = 1;
    }

    // The harness end to end (tests/src/scene.kama), a step this tick, its verdicts reported here.
    unsafe fn void sceneStep() {
        Optional<GoldenRun> taken = replace(place: this.scene, with: Optional::None);
        GoldenRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: GoldenRun.make(gpu: copy this.gpu, software: this.software, device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.scene = Optional::Some(value: give pending); return; }
        this.declared = this.declared + pending.declared();
        this.matched = this.matched + pending.matched();
        this.stage = 2;
    }

    // The renderer's clears and reads (tests/src/renderer.kama), a step this tick.
    unsafe fn void rendererStep() {
        Optional<RendererRun> taken = replace(place: this.rendering, with: Optional::None);
        RendererRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: RendererRun.make(gpu: copy this.gpu, software: this.software, device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.rendering = Optional::Some(value: give pending); return; }
        this.declared = this.declared + pending.declared();
        this.matched = this.matched + pending.matched();
        this.stage = 3;
    }

    // Scenes rendered and read back (tests/src/boxes.kama), a step this tick.
    unsafe fn void boxesStep() {
        Optional<BoxesRun> taken = replace(place: this.boxes, with: Optional::None);
        BoxesRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: BoxesRun.make(gpu: copy this.gpu, software: this.software, device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.boxes = Optional::Some(value: give pending); return; }
        this.declared = this.declared + pending.declared();
        this.matched = this.matched + pending.matched();
        this.stage = 4;
    }

    // The nodes' WGSL compiled on the leg, and a refused material (tests/src/shaders.kama), a step this tick.
    unsafe fn void shadersStep() {
        Optional<ShaderRun> taken = replace(place: this.shaders, with: Optional::None);
        ShaderRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: ShaderRun.make(device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.shaders = Optional::Some(value: give pending); return; }
        this.stage = 5;
    }

    // Normals in world space under a shear and a mirror (tests/src/normals.kama), a step this tick.
    unsafe fn void normalsStep() {
        Optional<NormalsRun> taken = replace(place: this.normals, with: Optional::None);
        NormalsRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: NormalsRun.make(device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.normals = Optional::Some(value: give pending); return; }
        this.stage = 6;
    }

    // `MeshStandardMaterial` drawn with no light, and a material compiled again when its nodes change
    // (tests/src/standard.kama), a step this tick.
    unsafe fn void standardStep() {
        Optional<StandardRun> taken = replace(place: this.standard, with: Optional::None);
        StandardRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: StandardRun.make(device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.standard = Optional::Some(value: give pending); return; }
        this.stage = 7;
    }

    // The DFG table read on the GPU through a program's own material (tests/src/dfg.kama), a step this tick.
    unsafe fn void dfgStep() {
        Optional<DfgRun> taken = replace(place: this.dfgRun, with: Optional::None);
        DfgRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: DfgRun.make(device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.dfgRun = Optional::Some(value: give pending); return; }
        this.stage = 8;
    }

    // The lights changed around a box with nothing compiled (tests/src/lights.kama), a step this tick.
    unsafe fn void lightsStep() {
        Optional<LightsRun> taken = replace(place: this.lightsRun, with: Optional::None);
        LightsRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: LightsRun.make(device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.lightsRun = Optional::Some(value: give pending); return; }
        this.stage = 9;
    }

    // The physical lighting model and what it reads (tests/src/physical.kama), a step this tick.
    unsafe fn void physicalStep() {
        Optional<PhysicalRun> taken = replace(place: this.physicalRun, with: Optional::None);
        PhysicalRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: PhysicalRun.make(device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.physicalRun = Optional::Some(value: give pending); return; }
        this.stage = 10;
    }

    // The lit goldens, one for each feature part 3 built (tests/src/lit.kama), a step this tick.
    unsafe fn void litStep() {
        Optional<LitRun> taken = replace(place: this.litRun, with: Optional::None);
        LitRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: LitRun.make(gpu: copy this.gpu, software: this.software, device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.litRun = Optional::Some(value: give pending); return; }
        this.declared = this.declared + pending.declared();
        this.matched = this.matched + pending.matched();
        this.stage = 11;
    }

    unsafe fn void frameStep() {
        Optional<FrameRun> taken = replace(place: this.frameRun, with: Optional::None);
        FrameRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: FrameRun.make(device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.frameRun = Optional::Some(value: give pending); return; }
        this.stage = 12;
    }

    unsafe fn void toneStep() {
        Optional<ToneMapRun> taken = replace(place: this.toneRun, with: Optional::None);
        ToneMapRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: ToneMapRun.make(gpu: copy this.gpu, software: this.software, device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.toneRun = Optional::Some(value: give pending); return; }
        this.declared = this.declared + pending.declared();
        this.matched = this.matched + pending.matched();
        this.stage = 13;
    }

    // The anti-aliasing methods, each set on one renderer in turn, and their goldens (tests/src/antialias.kama).
    unsafe fn void antialiasStep() {
        Optional<AntialiasRun> taken = replace(place: this.antialiasRun, with: Optional::None);
        AntialiasRun pending = match (give taken) {
            case Some(value: r): give r;
            case None: AntialiasRun.make(gpu: copy this.gpu, software: this.software, device: this.deviceCopy(), queue: this.queueCopy());
        };
        bool done = pending.step();
        this.report(found: pending.verdicts());
        pending.verdicts().clear();
        if (!done) { this.antialiasRun = Optional::Some(value: give pending); return; }
        this.declared = this.declared + pending.declared();
        this.matched = this.matched + pending.matched();
        this.queue = Optional::None;
        this.device = Optional::None;
        println(s: "gpu cases: all run");
        this.stage = DONE;
    }

    // A handle of its own to the one device, and to its queue: a copy is another reference to the same one.
    unsafe fn Device deviceCopy() {
        return match (this.device) { case Some(value: d): copy d; case None: { panic(msg: "the GPU cases run only once a device is open"); } };
    }
    unsafe fn Queue queueCopy() {
        return match (this.queue) { case Some(value: q): copy q; case None: { panic(msg: "the GPU cases run only once a device is open"); } };
    }

    unsafe fn int32 finish() {
        if (this.gpu.isEmpty()) {
            println(s: "goldens: none, this leg names no software GPU");
        } else {
            string named = copy this.gpu;
            println(s: "goldens: ${this.declared} declared, ${this.matched} matched, on " + named);
        }
        println(s: "graphics tests: ${this.runs} cases, ${this.failures} failed");
        exitStatus = this.failures > 0 ? 1 : 0;
        endOnTheWeb(failed: this.failures > 0);
        return 0;
    }
}

// The status `main` returns natively, set by `finish`: the loop owns the app and drops it when `run` returns.
static int32 exitStatus = 1;

// On the web `run` never returns, so the program ends here; natively `run` returns and `main` gives the status.
@compileFor(ARCH_WASM32)
fn void endOnTheWeb(bool failed) { if (failed) { quit(code: 1); } else { quit(code: 0); } }
@compileFor(!ARCH_WASM32)
fn void endOnTheWeb(bool failed) { }

// What this program was built as, which its run prints first, so the gate holds each leg to the build it names: a release
// leg that lost its `--release` says `debug`, and fails, rather than passing as a release leg that tested no release build
// (a wasm release runs Closure over the page's JS since kama 0.9.966, KR-289).
@compileFor(RELEASE)
fn string buildKind() { return "release"; }
@compileFor(DEBUG)
fn string buildKind() { return "debug"; }

unsafe fn void runChecks() {
    string built = buildKind();
    println(s: "build: ${built}");
    Owned<App> app = new Check.make();
    run(app: give app, pace: Pace::EveryRefresh);
}

fn uint8 main() {
    runChecks();
    return cast<uint8>(exitStatus);
}
